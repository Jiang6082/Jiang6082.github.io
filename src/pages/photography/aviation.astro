---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import PhotoTabs from "../../components/PhotoTabs.astro";
import AviationTabs from "../../components/AviationTabs.astro";
import "@fontsource/b612/400.css";
import "@fontsource/b612/700.css";
import "@fontsource/b612-mono/400.css";
import "@fontsource/b612-mono/700.css";
import "../../styles/airside.css";
import { getImage } from "astro:assets";
import { airframes, spots, slug, formatDate, spotLine, noteLine, type Airframe } from "../../data/aviation";
import { flapHTML } from "../../lib/flap.js";

const files = import.meta.glob("../../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const image = (file: string) => {
  const meta = files[`../../photos/${file}`]?.default;
  if (!meta) throw new Error(`aviation.csv: no photo at src/photos/${file}`);
  return meta;
};

const cards = await Promise.all(
  airframes.map(async (a) => {
    const meta = image(a.spots[0].file);
    const width = Math.min(720, meta.width);
    const thumb = await getImage({
      src: meta,
      width,
      widths: [360, width].filter((w, i, all) => w <= width && all.indexOf(w) === i),
      format: "webp",
    });
    const items = await Promise.all(
      a.spots.map(async (s) => {
        const m = image(s.file);
        const full = await getImage({ src: m, width: Math.min(2400, m.width), format: "webp" });
        return {
          title: "",
          caption: "",
          alt: `${s.airline} ${s.type} ${s.registration}${s.movement ? `, ${s.movement.toLowerCase()}` : ""}`,
          placeholder: false,
          thumb: "",
          full: full.src,
          heading: `${s.registration} · ${s.airline} · ${s.type}`,
          place: spotLine(s),
          note: noteLine(s),
          settings: s.settings,
        };
      }),
    );
    return { ...a, thumb, items };
  }),
);

type Card = (typeof cards)[number];
const pad = (n: number, width = 2) => String(n).padStart(width, "0");
const plural = (n: number, word: string) => `${pad(n)} ${word}${n === 1 ? "" : "s"}`;
const byType = (a: Airframe, b: Airframe) =>
  a.icao.localeCompare(b.icao) || a.registration.localeCompare(b.registration);
const shortDate = (iso: string) => formatDate(iso).toUpperCase();

// Default view (also the no-JavaScript view): one grid per airline.
const airlines = [...new Set(cards.map((c) => c.airline))]
  .map((name) => {
    const list = cards.filter((c) => c.airline === name).sort(byType);
    return { name, iata: list[0].iata, list, types: new Set(list.map((c) => c.icao)).size };
  })
  .sort((a, b) => b.list.length - a.list.length || a.name.localeCompare(b.name));
const aircraft = [...new Set(cards.map((c) => c.icao))]
  .map((icao) => {
    const list = cards.filter((c) => c.icao === icao);
    return { icao, name: list[0].type, n: list.length };
  })
  .sort((a, b) => b.n - a.n || a.icao.localeCompare(b.icao));

const latest = spots.map((s) => s.date).sort().at(-1) ?? "";
const sample = cards.some((c) => c.sample);
const galleryGroups = cards.map((c) => ({ key: c.key, title: c.registration, items: c.items }));
const json = (v: unknown) => JSON.stringify(v).replace(/</g, "\\u003c");
const searchText = (c: Card) =>
  [c.registration, c.registration.replace("-", ""), c.airline, c.iata, c.type, c.icao, c.family, c.name, c.livery]
    .join(" ")
    .toLowerCase();
---

<BaseLayout
  title="Aviation"
  description="A spotter’s logbook of aircraft photographed by Charles Jiang, by airline and type."
  bodyClass="theme-airside"
  wide
>
  <header class="av-head page-shell">
    <p class="eyebrow">Photography / Aviation</p><h1>Aviation logbook</h1><p>
      Every airframe I’ve photographed, filed by airline and type.
    </p>
  </header>
  <PhotoTabs current="aviation" />
  <div class="page-shell">
    <AviationTabs current="logbook" />
    {
      sample && (
        <p class="as-notice">
          <b>NOTICE</b>
          <span>
            Sample entries with illustrated placeholders, not real spots. My
            Heathrow photos will replace them.
          </span>
        </p>
      )
    }
    <dl class="as-stats">
      <div><dt>Airframes</dt><dd><span class="flap" set:html={flapHTML(pad(cards.length, 3))} /></dd></div>
      <div><dt>Airlines</dt><dd><span class="flap" set:html={flapHTML(pad(airlines.length))} /></dd></div>
      <div><dt>Aircraft types</dt><dd><span class="flap" set:html={flapHTML(pad(aircraft.length))} /></dd></div>
      <div><dt>Last spotted · LHR</dt><dd><span class="flap" set:html={flapHTML(shortDate(latest).slice(0, 6))} /></dd></div>
    </dl>

    <div class="as-panel" data-controls hidden>
      <div class="as-panel-row">
        <label class="as-label" for="logbook-search">Search</label>
        <input
          id="logbook-search"
          class="as-search"
          type="search"
          data-control="q"
          placeholder="Reg, airline, or type"
          autocomplete="off"
        />
      </div>
      <div class="as-panel-row">
        <span class="as-label">Airline</span>
        <div class="as-options" role="group" aria-label="Filter by airline">
          <button type="button" class="as-tile" data-airline="all" aria-pressed="true">All</button>
          {
            airlines.map((a) => (
              <button
                type="button"
                class="as-tile"
                data-airline={slug(a.name)}
                aria-pressed="false"
                title={a.name}
                aria-label={`${a.name}, ${a.list.length}`}
              >
                {a.iata}
                <sub>{a.list.length}</sub>
              </button>
            ))
          }
        </div>
      </div>
      <div class="as-panel-row">
        <span class="as-label">Aircraft</span>
        <div class="as-options" role="group" aria-label="Filter by aircraft type">
          <button type="button" class="as-tile" data-icao="all" aria-pressed="true">All</button>
          {
            aircraft.map((t) => (
              <button
                type="button"
                class="as-tile"
                data-icao={t.icao}
                aria-pressed="false"
                title={t.name}
                aria-label={`${t.name}, ${t.n}`}
              >
                {t.icao}
                <sub>{t.n}</sub>
              </button>
            ))
          }
        </div>
      </div>
      <div class="as-panel-row">
        <span class="as-label">Group · Sort</span>
        <div class="as-options as-view">
          <div class="as-options" role="group" aria-label="Group by">
            <button type="button" class="as-tile" data-group="airline" aria-pressed="true">Airline</button>
            <button type="button" class="as-tile" data-group="type" aria-pressed="false">Type</button>
            <button type="button" class="as-tile" data-group="none" aria-pressed="false">None</button>
          </div>
          <div class="as-options" role="group" aria-label="Sort by">
            <button type="button" class="as-tile" data-sort="type" aria-pressed="true">Type</button>
            <button type="button" class="as-tile" data-sort="newest" aria-pressed="false">Newest</button>
            <button type="button" class="as-tile" data-sort="registration" aria-pressed="false">Reg</button>
          </div>
          <p class="as-readout" aria-live="polite"></p>
        </div>
      </div>
    </div>

    <div id="logbook" class="logbook">
      {
        airlines.map((airline) => (
          <section class="av-group">
            <h2>
              <span class="as-tile">{airline.iata}</span>
              <span class="av-group-name">{airline.name}</span>
              <span class="av-group-meta">
                {plural(airline.list.length, "airframe")} · {plural(airline.types, "type")}
              </span>
            </h2>
            <div class="av-grid">
              {airline.list.map((c) => (
                <article
                  class="av-card"
                  data-reg={c.registration}
                  data-airline={slug(c.airline)}
                  data-airline-name={c.airline}
                  data-iata={c.iata}
                  data-icao={c.icao}
                  data-type={c.type}
                  data-date={c.latest}
                  data-search={searchText(c)}
                >
                  <a
                    class="av-photo"
                    href={c.items[0].full}
                    data-group={c.key}
                    data-index="0"
                    aria-label={`Open photo of ${c.registration}`}
                  >
                    <img
                      src={c.thumb.src}
                      srcset={c.thumb.srcSet.attribute}
                      sizes="(max-width: 600px) 46vw, 320px"
                      width={c.thumb.attributes.width}
                      height={c.thumb.attributes.height}
                      alt={c.items[0].alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <div class="av-strip">
                    <p class="av-reg">
                      {c.registration}
                      <span class="as-tile" title={c.type}>{c.icao}</span>
                    </p>
                    <p class="av-type">{c.type}</p>
                    <p class="av-meta">
                      {[c.iata, [c.spots[0].airport, c.spots[0].runway].filter(Boolean).join(" "), shortDate(c.latest)].join(" · ")}
                    </p>
                    {(c.livery || c.name) && (
                      <p class="av-tags">
                        {c.livery && <span class="av-tag is-livery">{c.livery}</span>}
                        {c.name && <span class="av-tag">“{c.name}”</span>}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
    <p class="as-empty av-empty" hidden>No airframes match. Clear a filter or the search.</p>
  </div>
  <script is:inline set:html={`window.__GALLERY__ = ${json(galleryGroups)};`} />
  <Lightbox />
</BaseLayout>
<script>
  type Group = "airline" | "type" | "none";
  type Sort = "type" | "newest" | "registration";

  const root = document.getElementById("logbook")!;
  const controls = document.querySelector<HTMLElement>("[data-controls]")!;
  const empty = document.querySelector<HTMLElement>(".av-empty")!;
  const readout = controls.querySelector<HTMLElement>(".as-readout")!;
  const search = controls.querySelector<HTMLInputElement>('[data-control="q"]')!;
  const cards = Array.from(root.querySelectorAll<HTMLElement>(".av-card"));

  const params = new URLSearchParams(location.search);
  const state = {
    q: params.get("q") ?? "",
    airline: params.get("airline") ?? "all",
    icao: params.get("aircraft") ?? "all",
    group: (params.get("group") as Group) ?? "airline",
    sort: (params.get("sort") as Sort) ?? "type",
  };
  if (!["airline", "type", "none"].includes(state.group)) state.group = "airline";
  if (!["type", "newest", "registration"].includes(state.sort)) state.sort = "type";

  const pad = (n: number) => String(n).padStart(2, "0");
  const plural = (n: number, word: string) => `${pad(n)} ${word}${n === 1 ? "" : "s"}`;
  const el = (tag: string, cls?: string, text?: string) => {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text !== undefined) node.textContent = text;
    return node;
  };
  const heading = (code: string, name: string, meta: string) => {
    const h = el("h2");
    h.append(el("span", "as-tile", code), el("span", "av-group-name", name), el("span", "av-group-meta", meta));
    return h;
  };
  const grid = (list: HTMLElement[]) => {
    const g = el("div", "av-grid");
    g.append(...list);
    return g;
  };
  const groupBy = (list: HTMLElement[], key: (c: HTMLElement) => string) => {
    const map = new Map<string, HTMLElement[]>();
    for (const c of list) map.set(key(c), [...(map.get(key(c)) ?? []), c]);
    return [...map.entries()].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
  };

  function render() {
    const q = state.q.trim().toLowerCase().replace(/\s+/g, " ");
    const visible = cards.filter(
      (c) =>
        (state.airline === "all" || c.dataset.airline === state.airline) &&
        (state.icao === "all" || c.dataset.icao === state.icao) &&
        (!q || c.dataset.search!.includes(q)),
    );
    const reg = (a: HTMLElement, b: HTMLElement) => a.dataset.reg!.localeCompare(b.dataset.reg!);
    visible.sort(
      state.sort === "registration"
        ? reg
        : state.sort === "newest"
          ? (a, b) => b.dataset.date!.localeCompare(a.dataset.date!) || reg(a, b)
          : (a, b) => a.dataset.icao!.localeCompare(b.dataset.icao!) || reg(a, b),
    );

    root.replaceChildren();
    if (state.group === "none") {
      root.append(grid(visible));
    } else if (state.group === "type") {
      for (const [icao, list] of groupBy(visible, (c) => c.dataset.icao!)) {
        const section = el("section", "av-group");
        const airlines = new Set(list.map((c) => c.dataset.airline)).size;
        section.append(
          heading(icao, list[0].dataset.type!, `${plural(list.length, "airframe")} · ${plural(airlines, "airline")}`),
          grid(list),
        );
        root.append(section);
      }
    } else {
      for (const [airline, list] of groupBy(visible, (c) => c.dataset.airlineName!)) {
        const section = el("section", "av-group");
        const types = new Set(list.map((c) => c.dataset.icao)).size;
        section.append(
          heading(list[0].dataset.iata!, airline, `${plural(list.length, "airframe")} · ${plural(types, "type")}`),
          grid(list),
        );
        root.append(section);
      }
    }

    empty.hidden = visible.length > 0;
    readout.textContent = `Showing ${pad(visible.length)} of ${pad(cards.length)}`;
    for (const key of ["airline", "icao", "group", "sort"] as const)
      controls.querySelectorAll<HTMLButtonElement>(`[data-${key}]`).forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset[key] === state[key])),
      );

    const next = new URLSearchParams();
    if (state.q) next.set("q", state.q);
    if (state.airline !== "all") next.set("airline", state.airline);
    if (state.icao !== "all") next.set("aircraft", state.icao);
    if (state.group !== "airline") next.set("group", state.group);
    if (state.sort !== "type") next.set("sort", state.sort);
    const query = next.toString();
    history.replaceState(null, "", query ? `?${query}` : location.pathname);
  }

  search.value = state.q;
  search.addEventListener("input", () => {
    state.q = search.value;
    render();
  });
  for (const key of ["airline", "icao", "group", "sort"] as const)
    controls.querySelectorAll<HTMLButtonElement>(`[data-${key}]`).forEach((b) =>
      b.addEventListener("click", () => {
        (state as Record<string, string>)[key] = b.dataset[key]!;
        render();
      }),
    );
  controls.hidden = false;
  render();
</script>
<style>
  .av-head {
    padding: 1rem 0 2.5rem;
  }
  .av-head h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin: 1.6rem 0 1rem;
  }
  .av-head > p:last-child {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 36rem;
  }
  .as-view {
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .as-view .as-readout {
    margin: 0 0 0 auto;
  }
  .logbook :global(.av-group) {
    padding: 0 0 2.5rem;
  }
  .logbook :global(.av-group h2) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .logbook :global(.av-group h2 .as-tile) {
    background: var(--as-sign);
    border-color: var(--as-sign);
    color: var(--as-ink);
    font-size: 0.85rem;
  }
  .logbook :global(.av-group-meta) {
    margin-left: auto;
    font: 0.8rem var(--font-mono);
    color: var(--as-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .logbook :global(.av-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 4px;
  }
  .av-card {
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
  }
  .av-photo {
    display: block;
    background: #0b0c0d;
  }
  .av-photo img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: opacity 0.15s;
  }
  .av-photo:hover img {
    opacity: 0.85;
  }
  .av-card:hover {
    border-color: var(--as-sign);
  }
  .av-strip {
    padding: 0.85rem 0.9rem 1rem;
    border-top: 2px solid #000;
  }
  .av-strip p {
    margin: 0;
  }
  .av-reg {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font: 700 1.3rem/1 var(--font-mono);
    color: var(--as-sign);
    letter-spacing: 0.04em;
  }
  .av-reg .as-tile {
    min-width: 0;
    font-size: 0.75rem;
    color: var(--fg);
  }
  .av-type {
    margin-top: 0.55rem !important;
    font-size: 0.9rem;
  }
  .av-meta {
    margin-top: 0.3rem !important;
    font: 0.75rem var(--font-mono);
    color: var(--as-dim);
    letter-spacing: 0.06em;
  }
  .av-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 0.7rem !important;
  }
  .av-tag {
    font: 0.75rem var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25em 0.5em;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .av-tag.is-livery {
    border-color: var(--as-sign);
    color: var(--as-sign);
  }
  .av-empty {
    color: var(--muted);
    padding: 2rem 0;
  }
  @media (max-width: 760px) {
    .logbook :global(.av-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .av-strip {
      padding: 0.7rem 0.7rem 0.8rem;
    }
    .av-reg {
      font-size: 1.05rem;
    }
    .av-type {
      font-size: 0.8rem;
    }
    .as-view .as-readout {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
