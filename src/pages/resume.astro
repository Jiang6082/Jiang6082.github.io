---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resume as r } from "../data/resume";
import { SITE, SOCIALS } from "../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sections = [
  "Education",
  "Experience",
  "Projects",
  "Leadership",
  "Skills",
  "Achievements",
];
---

<BaseLayout
  title="Résumé"
  description="Education, research, engineering experience, and projects of Bingde (Charles) Jiang."
  wide
>
  <div class="resume-layout">
    <aside>
      <p class="eyebrow">Résumé / August 2026</p><nav
        aria-label="Résumé sections"
      >
        {sections.map((s) => <a href={`#${s.toLowerCase()}`}>{s}</a>)}
      </nav><button class="print-button" hidden>Print / save PDF ↗</button>
    </aside>
    <article>
      <header>
        <h1>{r.name}</h1><p class="summary">{r.summary}</p><div class="contact">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><a
            href={SOCIALS.find((s) => s.name === "LinkedIn")!.url}
            >LinkedIn ↗</a
          ><a href="https://github.com/Jiang6082">GitHub ↗</a>
        </div>
      </header>
      <section id="education">
        <h2>Education</h2><div class="entry">
          <div class="entry-top">
            <h3>{r.education.school}</h3><span>{r.education.graduation}</span>
          </div><p>{r.education.degree}</p><p class="meta">
            {r.education.location} · GPA {r.education.gpa}
          </p><p>{r.education.abroad}</p><h4>Programs & certificates</h4><ul
            class="inline-list"
          >
            {r.education.programs.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </section>
      <section id="experience">
        <h2>Experience</h2><div class="timeline">
          {
            r.experience.map((e) => (
              <div class="entry">
                <>
                  <p class="dates">
                    {e.dates} · {e.location}
                  </p>
                  <h3>{e.organization}</h3>
                  <p class="role">{e.role}</p>
                  <ul>
                    {e.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                  <p class="meta">{e.tags.join(" / ")}</p>
                </>
              </div>
            ))
          }
        </div>
      </section>
      <section id="projects">
        <h2>Projects</h2>{
          r.projects.map((p) => (
            <div class="entry">
              <>
                <p class="dates">{p.dates}</p>
                <h3>{p.name}</h3>
                <p class="meta">{p.tools}</p>
                <ul>
                  {p.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <div class="project-links">
                  {p.links.map((l) => (
                    <a class="text-link" href={`${base}${l.href}`}>
                      {l.label} →
                    </a>
                  ))}
                </div>
              </>
            </div>
          ))
        }
      </section>
      <section id="leadership">
        <h2>Leadership</h2><div class="entry">
          <p class="dates">{r.leadership.dates} · {r.leadership.location}</p><h3
          >
            {r.leadership.organization}
          </h3><p class="role">{r.leadership.role}</p><p>
            {r.leadership.description}
          </p>
        </div>
      </section>
      <section id="skills">
        <h2>Skills</h2><dl class="skills">
          {
            r.skills.map((s) => (
              <div>
                <>
                  <dt>{s.group}</dt>
                  <dd>{s.items.join(" · ")}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </section>
      <section id="achievements">
        <h2>Achievements</h2><ul class="achievements">
          {r.achievements.map((a) => <li>{a}</li>)}
        </ul>
      </section>
      <p class="updated">
        Combined from my July engineering and August quantitative résumés. Dates
        marked “Present” reflect those versions.
      </p>
    </article>
  </div>
</BaseLayout>
<script>
  const button = document.querySelector<HTMLButtonElement>(".print-button");
  if (button) {
    button.hidden = false;
    button.addEventListener("click", () => window.print());
  }
</script>
<style>
  .resume-layout {
    display: grid;
    grid-template-columns: 12rem minmax(0, 48rem);
    gap: 4rem;
    max-width: 74rem;
    padding: 0 var(--gutter);
    margin: auto;
    align-items: start;
  }
  aside {
    position: sticky;
    top: 3rem;
  }
  aside nav {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin: 1.5rem 0;
  }
  aside a {
    font-size: 0.9rem;
    color: var(--muted);
  }
  aside a:hover {
    color: var(--accent);
  }
  .print-button {
    background: none;
    border: 1px solid var(--border);
    padding: 0.75rem;
    font: inherit;
    font-size: 0.8rem;
    color: var(--fg);
    cursor: pointer;
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 3.3rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.035em;
    margin: 0.8rem 0 1.5rem;
  }
  .summary {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--muted);
  }
  .contact,
  .project-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }
  header {
    padding-bottom: 2rem;
  }
  section {
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    scroll-margin-top: 2rem;
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 2rem;
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0.4rem 0;
  }
  h4 {
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: 1.5rem;
  }
  .entry {
    margin-bottom: 2.3rem;
  }
  .entry:last-child {
    margin-bottom: 0;
  }
  .entry-top {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .dates,
  .meta,
  .entry-top span,
  .updated {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .role {
    margin: 0.25rem 0 1rem;
  }
  .entry p {
    line-height: 1.75;
  }
  .entry ul {
    padding-left: 1.2rem;
  }
  .entry li {
    line-height: 1.8;
    margin: 0.6rem 0;
  }
  .timeline {
    border-left: 1px solid var(--border);
    padding-left: 1.6rem;
  }
  .timeline .entry {
    position: relative;
  }
  .timeline .entry:before {
    content: "";
    position: absolute;
    left: -1.85rem;
    top: 0.4rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .inline-list li {
    font-size: 0.85rem;
  }
  .skills div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .achievements {
    padding-left: 1.2rem;
    line-height: 2;
  }
  .updated {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  @media (max-width: 1000px) {
    .resume-layout {
      display: block;
      max-width: 52rem;
    }
    aside {
      position: static;
      margin-bottom: 2rem;
    }
    aside nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    aside {
      display: none !important;
    }
    :global(main) {
      padding: 0 !important;
    }
    :global(body) {
      background: white !important;
      color: black !important;
    }
    .resume-layout {
      display: block;
      max-width: none;
      padding: 0;
    }
    h1 {
      font-size: 24pt;
    }
    h2 {
      font-size: 16pt;
    }
    section {
      padding: 12pt 0;
    }
    .entry {
      break-inside: avoid;
    }
    p,
    li,
    dd {
      font-size: 10pt !important;
    }
    a {
      color: black;
    }
    .contact {
      font-size: 10pt;
    }
    .updated {
      font-size: 8pt;
    }
    header {
      padding-bottom: 12pt;
    }
  }
</style>
