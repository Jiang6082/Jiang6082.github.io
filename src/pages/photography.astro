---
import BaseLayout from "../layouts/BaseLayout.astro";
import { collections, singles, type Photo } from "../data/photos";
import { cld } from "../lib/cloudinary";

// Shape each photo into a plain object the client lightbox can consume,
// plus an aspect ratio for the justified row layout.
const toItem = (p: Photo) => {
  const ar = p.w && p.h ? p.w / p.h : 1.5;
  return {
    title: p.title ?? "",
    caption: p.caption ?? "",
    alt: p.alt || p.title || "Photo",
    placeholder: !!p.placeholder || !p.publicId,
    ar: Math.max(0.5, Math.min(ar, 2.6)), // clamp extremes
    thumb: p.publicId ? cld(p.publicId, { width: 900 }) : "",
    full: p.publicId ? cld(p.publicId, { width: 2000 }) : "",
  };
};

// One labeled group per collection, then a group for the standalone photos.
const groups = [
  ...collections.map((c) => ({
    key: `col-${c.id}`,
    title: c.title,
    description: c.description ?? "",
    items: c.photos.map(toItem),
  })),
  ...(singles.length
    ? [{ key: "singles", title: "Photos", description: "", items: singles.map(toItem) }]
    : []),
];
---

<BaseLayout title="Photography" description="Collections and single frames." wide>
  <header class="pg-head">
    <h1>Photography</h1>
    <p class="muted">
      Click any photo to view it full-screen — use the arrows or your ← / →
      keys to move through a set, Esc to close.
    </p>
  </header>

  {
    groups.map((g) => (
      <section class="group">
        <div class="group-label">
          <span class="g-title">{g.title}</span>
          {g.description && <span class="g-desc"> · {g.description}</span>}
        </div>
        <div class="pgrid">
          {g.items.map((item, i) => (
            <button
              class="cell"
              style={`--ar:${item.ar.toFixed(3)}`}
              data-group={g.key}
              data-index={i}
              aria-label={item.title || "Open photo"}
            >
              {item.placeholder ? (
                <span class="ph" />
              ) : (
                <img src={item.thumb} alt={item.alt} loading="lazy" />
              )}
              {item.title && <span class="cell-title">{item.title}</span>}
            </button>
          ))}
        </div>
      </section>
    ))
  }

  <!-- Lightbox overlay -->
  <div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="lb-btn lb-close" aria-label="Close">&times;</button>
    <button class="lb-btn lb-prev" aria-label="Previous photo">&#8249;</button>
    <button class="lb-btn lb-next" aria-label="Next photo">&#8250;</button>
    <figure class="lb-figure">
      <div class="lb-media"></div>
      <figcaption class="lb-cap">
        <h3 class="lb-title"></h3>
        <p class="lb-caption muted"></p>
        <span class="lb-counter muted small"></span>
      </figcaption>
    </figure>
  </div>

  <script is:inline set:html={`window.__GALLERY__ = ${JSON.stringify(groups)};`} />
</BaseLayout>

<script>
  interface Item {
    title: string;
    caption: string;
    alt: string;
    placeholder: boolean;
    thumb: string;
    full: string;
  }
  interface Group {
    key: string;
    title: string;
    items: Item[];
  }

  const groups: Group[] = (window as any).__GALLERY__ ?? [];
  const byKey = new Map(groups.map((g) => [g.key, g]));

  const lb = document.getElementById("lightbox")!;
  const media = lb.querySelector<HTMLElement>(".lb-media")!;
  const elTitle = lb.querySelector<HTMLElement>(".lb-title")!;
  const elCaption = lb.querySelector<HTMLElement>(".lb-caption")!;
  const elCounter = lb.querySelector<HTMLElement>(".lb-counter")!;
  const btnPrev = lb.querySelector<HTMLButtonElement>(".lb-prev")!;
  const btnNext = lb.querySelector<HTMLButtonElement>(".lb-next")!;
  const btnClose = lb.querySelector<HTMLButtonElement>(".lb-close")!;

  let current: Item[] = [];
  let index = 0;
  let lastFocus: HTMLElement | null = null;

  function render() {
    const item = current[index];
    if (!item) return;
    media.innerHTML = "";
    if (item.placeholder) {
      const ph = document.createElement("div");
      ph.className = "lb-placeholder";
      ph.textContent = item.title || "Photo";
      media.appendChild(ph);
    } else {
      const img = document.createElement("img");
      img.src = item.full;
      img.alt = item.alt;
      media.appendChild(img);
    }
    elTitle.textContent = item.title;
    elTitle.style.display = item.title ? "" : "none";
    elCaption.textContent = item.caption;
    elCaption.style.display = item.caption ? "" : "none";
    const multi = current.length > 1;
    elCounter.textContent = multi ? `${index + 1} / ${current.length}` : "";
    btnPrev.style.display = multi ? "" : "none";
    btnNext.style.display = multi ? "" : "none";
  }

  function open(groupKey: string, startIndex: number) {
    const group = byKey.get(groupKey);
    if (!group) return;
    current = group.items;
    index = Math.max(0, Math.min(startIndex, current.length - 1));
    lastFocus = document.activeElement as HTMLElement;
    lb.hidden = false;
    document.body.style.overflow = "hidden";
    render();
    btnClose.focus();
  }

  function close() {
    lb.hidden = true;
    document.body.style.overflow = "";
    media.innerHTML = "";
    lastFocus?.focus();
  }

  const next = () => {
    index = (index + 1) % current.length;
    render();
  };
  const prev = () => {
    index = (index - 1 + current.length) % current.length;
    render();
  };

  document.querySelectorAll<HTMLButtonElement>("[data-group]").forEach((el) => {
    el.addEventListener("click", () => {
      open(el.dataset.group!, Number(el.dataset.index || 0));
    });
  });

  btnNext.addEventListener("click", next);
  btnPrev.addEventListener("click", prev);
  btnClose.addEventListener("click", close);
  lb.addEventListener("click", (e) => {
    if (e.target === lb || e.target === lb.querySelector(".lb-figure")) close();
  });
  document.addEventListener("keydown", (e) => {
    if (lb.hidden) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowRight" && current.length > 1) next();
    else if (e.key === "ArrowLeft" && current.length > 1) prev();
  });
</script>

<style>
  /* Header keeps a little breathing room; grids go fully edge-to-edge. */
  .pg-head {
    padding: 0 clamp(0.75rem, 3vw, 1.5rem);
    max-width: 46rem;
  }
  .pg-head h1 {
    margin-bottom: 0.35rem;
  }

  .group {
    margin-top: 1.75rem;
  }
  .group-label {
    padding: 0 clamp(0.75rem, 3vw, 1.5rem);
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }
  .g-title {
    font-weight: 650;
    color: var(--fg);
  }
  .g-desc {
    color: var(--muted);
  }

  /* ── Justified, full-bleed, borderless grid (Google-Photos style) ─ */
  .pgrid {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    --row-h: 240px;
  }
  @media (max-width: 900px) {
    .pgrid {
      --row-h: 190px;
    }
  }
  @media (max-width: 600px) {
    .pgrid {
      --row-h: 150px;
      gap: 2px;
    }
  }
  .cell {
    position: relative;
    height: var(--row-h);
    /* grow / shrink / basis all scale with aspect ratio → rows fill width
       while photos keep their proportions. */
    flex: var(--ar) 1 calc(var(--ar) * var(--row-h));
    margin: 0;
    padding: 0;
    border: none;
    background: var(--surface-2);
    overflow: hidden;
    cursor: pointer;
  }
  .cell img,
  .cell .ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cell .ph {
    background: linear-gradient(
      135deg,
      var(--border),
      color-mix(in srgb, var(--border) 55%, var(--muted))
    );
  }
  .cell img {
    transition: transform 0.3s ease, filter 0.2s ease;
  }
  .cell:hover img {
    transform: scale(1.04);
  }
  .cell::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    transition: background 0.2s ease;
    pointer-events: none;
  }
  .cell:hover::after {
    background: rgba(0, 0, 0, 0.12);
  }
  .cell-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 1.6rem 0.6rem 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
    text-align: left;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .cell:hover .cell-title {
    opacity: 1;
  }

  /* ── Lightbox ─────────────────────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
    padding: 1.5rem;
    animation: lb-in 0.2s ease;
  }
  .lightbox[hidden] {
    display: none;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-figure {
    margin: 0;
    max-width: min(94vw, 1200px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .lb-media {
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 78vh;
  }
  .lb-media img {
    max-width: 100%;
    max-height: 78vh;
    border-radius: 6px;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .lb-placeholder {
    width: min(70vw, 640px);
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.75);
    background: linear-gradient(135deg, #3a3a44, #55556a);
  }
  .lb-cap {
    text-align: center;
    color: #fff;
    max-width: 40rem;
  }
  .lb-title {
    margin: 0;
    font-size: 1.15rem;
    color: #fff;
  }
  .lb-caption {
    margin: 0.25rem 0 0;
    color: rgba(255, 255, 255, 0.7) !important;
  }
  .lb-counter {
    display: inline-block;
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.55) !important;
  }
  .lb-btn {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    cursor: pointer;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .lb-close {
    top: 1.1rem;
    right: 1.1rem;
    width: 2.6rem;
    height: 2.6rem;
    font-size: 1.6rem;
    line-height: 1;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    font-size: 2rem;
    line-height: 1;
  }
  .lb-prev:hover,
  .lb-next:hover {
    transform: translateY(-50%) scale(1.06);
  }
  .lb-prev {
    left: 1.1rem;
  }
  .lb-next {
    right: 1.1rem;
  }
  @media (max-width: 560px) {
    .lb-prev {
      left: 0.4rem;
    }
    .lb-next {
      right: 0.4rem;
    }
  }
</style>
