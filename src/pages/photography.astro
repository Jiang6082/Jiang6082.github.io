---
import BaseLayout from "../layouts/BaseLayout.astro";
import { photos } from "../data/photos";
import { cld } from "../lib/cloudinary";
---

<BaseLayout title="Photography" description="A selection of photos I've taken.">
  <h1>Photography</h1>
  <p class="muted">A selection of shots I'm fond of. Click any image to view full size.</p>

  <div class="gallery">
    {
      photos.map((photo) => (
        <figure class="photo">
          {photo.placeholder ? (
            <div class="placeholder" aria-label={photo.alt}>
              <span>{photo.caption ?? "Photo"}</span>
            </div>
          ) : (
            <a href={cld(photo.publicId, { width: 2000 })} target="_blank" rel="noopener">
              <img
                src={cld(photo.publicId, { width: 800 })}
                srcset={`${cld(photo.publicId, { width: 400 })} 400w, ${cld(photo.publicId, { width: 800 })} 800w, ${cld(photo.publicId, { width: 1200 })} 1200w`}
                sizes="(max-width: 700px) 100vw, 350px"
                alt={photo.alt}
                loading="lazy"
              />
            </a>
          )}
          {photo.caption && <figcaption class="muted small">{photo.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</BaseLayout>

<style>
  .gallery {
    margin-top: 1.5rem;
    columns: 2;
    column-gap: 1rem;
  }
  @media (max-width: 560px) {
    .gallery {
      columns: 1;
    }
  }
  .photo {
    margin: 0 0 1rem;
    break-inside: avoid;
  }
  .photo img {
    width: 100%;
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }
  .photo a:hover img {
    opacity: 0.9;
  }
  .placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--border), color-mix(in srgb, var(--border) 60%, var(--muted)));
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  figcaption {
    margin-top: 0.4rem;
  }
</style>
