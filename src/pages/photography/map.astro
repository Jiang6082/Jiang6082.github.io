---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import { getImage } from "astro:assets";
import { collections, singles } from "../../data/photos";
import { detailsFor, settingsLine } from "../../data/photo-details";
import "leaflet/dist/leaflet.css";

const files = import.meta.glob("../../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const slug = (s: string) =>
  s
    .normalize("NFKD")
    .replace(/[^\w\s-]/g, "")
    .trim()
    .toLowerCase()
    .replace(/[\s_]+/g, "-");

interface MapItem {
  title: string;
  caption: string;
  alt: string;
  placeholder: false;
  thumb: string;
  srcset: string;
  full: string;
  width: number;
  height: number;
  place: string;
  settings: string;
}
interface MapPlace {
  key: string;
  name: string;
  lat: number;
  lon: number;
  items: MapItem[];
}

const places = new Map<string, MapPlace>();
let unplaced = 0;
for (const photo of [...collections.flatMap((c) => c.photos), ...singles]) {
  const meta = photo.src ? files[`../../photos/${photo.src}`]?.default : undefined;
  if (!meta) continue;
  const details = detailsFor(photo.src);
  if (!details.place) {
    unplaced++;
    continue;
  }
  const { name, lat, lon } = details.place;
  const thumbWidth = Math.min(640, meta.width);
  const [thumb, full] = await Promise.all([
    getImage({
      src: meta,
      width: thumbWidth,
      widths: [320, thumbWidth].filter((w, i, a) => w <= thumbWidth && a.indexOf(w) === i),
      format: "webp",
    }),
    getImage({ src: meta, width: Math.min(2400, meta.width), format: "webp" }),
  ]);
  const key = `place-${slug(name)}`;
  if (!places.has(key)) places.set(key, { key, name, lat, lon, items: [] });
  places.get(key)!.items.push({
    title: "",
    caption: "",
    alt: photo.alt || "Photograph by Charles Jiang",
    placeholder: false,
    thumb: thumb.src,
    srcset: thumb.srcSet.attribute,
    full: full.src,
    width: thumb.attributes.width as number,
    height: thumb.attributes.height as number,
    place: name,
    settings: settingsLine(details),
  });
}
const sorted = [...places.values()].sort(
  (a, b) => b.items.length - a.items.length || a.name.localeCompare(b.name),
);
const pins = sorted.map(({ key, name, lat, lon, items }) => ({
  key,
  name,
  lat,
  lon,
  count: items.length,
  thumb: items[0].thumb,
}));
const galleryGroups = sorted.map(({ key, name, items }) => ({
  key,
  title: name,
  items,
}));
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Photo map"
  description="Where Charles Jiang’s photographs were taken, to the nearest city."
  wide
>
  <div class="page-shell">
    <header class="map-heading">
      <a class="text-link" href={`${base}/photography`}
        ><span aria-hidden="true">←</span> Photography</a
      ><h1>Photo map</h1><p>
        Where the photographs were taken, to the nearest city.
      </p>
    </header>
    {
      pins.length > 0 ? (
        <div
          id="photo-map"
          class="photo-map"
          role="region"
          aria-label="Map of photo locations. Select a pin to open its photographs."
        />
      ) : (
        <p class="map-empty">
          Locations will appear here as photographs with location data are
          added.
        </p>
      )
    }
    {
      sorted.length > 0 && (
        <section class="places" aria-labelledby="places-heading">
          <h2 id="places-heading" class="eyebrow">
            By place / {String(sorted.length).padStart(2, "0")}
          </h2>
          {sorted.map((place) => (
            <section class="place" id={place.key}>
              <h3>
                {place.name} <span class="count">{place.items.length}</span>
              </h3>
              <div class="place-photos">
                {place.items.map((item, i) => (
                  <a
                    href={item.full}
                    data-group={place.key}
                    data-index={i}
                    aria-label={`Open photograph: ${item.alt}`}
                  >
                    <img
                      src={item.thumb}
                      srcset={item.srcset}
                      sizes="(max-width: 600px) 45vw, 240px"
                      width={item.width}
                      height={item.height}
                      alt={item.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                ))}
              </div>
            </section>
          ))}
        </section>
      )
    }
    {
      unplaced > 0 && (
        <p class="unplaced">
          {unplaced} {unplaced === 1 ? "photograph doesn’t" : "photographs don’t"}{" "}
          have a location yet.
        </p>
      )
    }
  </div>
  <script type="application/json" id="map-data" set:html={json(pins)} />
  <script is:inline set:html={`window.__GALLERY__ = ${json(galleryGroups)};`} />
  <Lightbox />
</BaseLayout>
<script>
  import L from "leaflet";

  interface Pin {
    key: string;
    name: string;
    lat: number;
    lon: number;
    count: number;
    thumb: string;
  }

  const el = document.getElementById("photo-map");
  const pins: Pin[] = JSON.parse(
    document.getElementById("map-data")?.textContent || "[]",
  );

  if (el && pins.length) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const map = L.map(el, {
      scrollWheelZoom: false,
      zoomAnimation: !still,
      fadeAnimation: !still,
      markerZoomAnimation: !still,
      worldCopyJump: true,
    });
    L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
      {
        subdomains: "abcd",
        maxZoom: 19,
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      },
    ).addTo(map);

    const pinIcon = (thumb: string, count: number) => {
      const photo = document.createElement("span");
      photo.className = "pin-photo";
      photo.style.backgroundImage = `url("${thumb}")`;
      const badge = document.createElement("span");
      badge.className = "pin-count";
      badge.textContent = String(count);
      const html = document.createElement("span");
      html.append(photo, badge);
      return L.divIcon({
        className: "photo-pin",
        html,
        iconSize: [60, 60],
        iconAnchor: [30, 60],
      });
    };
    const photos = (n: number) => `${n} ${n === 1 ? "photograph" : "photographs"}`;

    // Like Photos on iPhone: nearby places merge into one pin until you zoom in.
    const layer = L.layerGroup().addTo(map);
    function draw() {
      layer.clearLayers();
      const groups: { pins: Pin[]; point: L.Point }[] = [];
      for (const pin of pins) {
        const point = map.latLngToLayerPoint([pin.lat, pin.lon]);
        const near = groups.find((g) => g.point.distanceTo(point) < 64);
        if (near) near.pins.push(pin);
        else groups.push({ pins: [pin], point });
      }
      for (const group of groups) {
        const [first] = group.pins;
        const count = group.pins.reduce((sum, p) => sum + p.count, 0);
        const area = L.latLngBounds(group.pins.map((p) => [p.lat, p.lon]));
        const label = `${group.pins.map((p) => p.name).join(", ")}: ${photos(count)}`;
        L.marker(group.pins.length === 1 ? [first.lat, first.lon] : area.getCenter(), {
          icon: pinIcon(first.thumb, count),
          title: label,
          alt: label,
          keyboard: true,
          riseOnHover: true,
        })
          .on("click", () => {
            const zoom = map.getZoom();
            const target = Math.min(
              map.getBoundsZoom(area, false, L.point(160, 160)),
              zoom + 4,
            );
            if (group.pins.length > 1 && target > zoom)
              map.fitBounds(area, { padding: [80, 80], maxZoom: target });
            else (window as any).__openLightbox?.(first.key, 0);
          })
          .addTo(layer);
      }
    }

    const all = L.latLngBounds(pins.map((p) => [p.lat, p.lon]));
    if (pins.length === 1) map.setView(all.getCenter(), 10);
    else map.fitBounds(all, { padding: [56, 56], maxZoom: 11 });
    draw();
    map.on("zoomend", draw);
  }
</script>
<style>
  .map-heading {
    padding: 1rem 0 2.5rem;
  }
  .map-heading h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 2rem 0 1rem;
  }
  .map-heading p {
    font-size: 1.15rem;
    color: var(--muted);
  }
  .photo-map {
    /* Own stacking context so Leaflet's layers stay under the lightbox. */
    position: relative;
    z-index: 0;
    isolation: isolate;
    height: clamp(360px, 62vh, 660px);
    border: 1px solid var(--border);
    background: var(--surface-2);
  }
  :global(.no-js) .photo-map {
    display: none;
  }
  .photo-map :global(.photo-pin) {
    background: none;
    border: 0;
  }
  .photo-map :global(.pin-photo) {
    display: block;
    width: 52px;
    height: 52px;
    border: 3px solid #fff;
    border-radius: 10px;
    background: var(--surface-2) center / cover no-repeat;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.28);
  }
  .photo-map :global(.pin-count) {
    position: absolute;
    top: -8px;
    right: -6px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: var(--accent);
    color: #fff;
    font: 600 0.75rem/22px var(--font-sans);
    text-align: center;
  }
  .photo-map :global(.leaflet-marker-icon:focus-visible .pin-photo) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .photo-map :global(.leaflet-container) {
    font-family: var(--font-sans);
  }
  .map-empty,
  .unplaced {
    color: var(--muted);
  }
  .map-empty {
    border: 1px dashed var(--border);
    padding: 3rem 1.5rem;
    text-align: center;
  }
  .places {
    padding: 3rem 0 1rem;
  }
  .places > h2 {
    margin: 0 0 1.5rem;
  }
  .place {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 2rem;
    scroll-margin-top: 2rem;
  }
  .place h3 {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .count {
    font: 0.8125rem var(--font-mono);
    color: var(--accent);
    margin-left: 0.4rem;
  }
  .place-photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(45vw, 200px), 1fr));
    gap: 0.75rem;
  }
  .place-photos a {
    display: block;
    background: var(--surface-2);
  }
  .place-photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .unplaced {
    font-size: 0.875rem;
    padding-top: 1rem;
  }
</style>
