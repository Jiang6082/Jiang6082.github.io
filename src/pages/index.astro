---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import { SITE } from "../config";
import { projects } from "../data/projects";
import { resume } from "../data/resume";
import portrait from "../photos/IMG_0339.jpg";
import coast from "../photos/IMG_0047.jpg";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const responsive = (src: ImageMetadata, max: number, sizes: string) => {
  const width = Math.min(max, src.width);
  return getImage({
    src,
    width,
    widths: [480, 720, 960, 1200, max].filter((w) => w <= width),
    sizes,
    format: "webp",
  });
};
const portraitImage = await responsive(
  portrait,
  1400,
  "(max-width: 760px) calc(100vw - 2.5rem), 46vw",
);
const coastImage = await responsive(
  coast,
  1400,
  "(max-width: 760px) calc(100vw - 2.5rem), 55vw",
);
const work = projects.filter((p) => p.featured && p.slug);
// First-screen facts, from the résumé so they stay in sync.
const [uchicago, lse] = resume.education;
const [next] = resume.experience;
const facts = [
  `B.S. ${uchicago.dates.replace(/^Expected/, "expected")}`,
  `LSE ${lse.dates}`,
  `Incoming ${next.role.replace(/^Incoming /, "").replace(/ Intern$/, " intern")} at ${next.organization}, ${next.dates.match(/\d{4}/)![0]}`,
];
// "June 2027 – July 2027" → "2027"; "December 2024 – June 2026" → "2024–2026".
const years = (dates: string) => [...new Set(dates.match(/\d{4}/g) ?? [])].join("–");
---

<BaseLayout
  description="Charles Jiang — University of Chicago mathematics and computer science student. Research, software, and photography."
  wide
>
  <div class="page-shell">
    <section class="home-opening" aria-labelledby="home-heading">
      <div class="hero-copy">
        <h1 id="home-heading">Charles Jiang</h1><p class="hero-role">
          Mathematics &amp; Computer Science, University of Chicago
        </p><p class="hero-facts">{facts.join(" · ")}</p><p class="hero-blurb">
          I build things and I like to take photos.
        </p><div
          class="hero-links"
        >
          <a class="text-link" href="#selected-work"
            >Explore the projects <span aria-hidden="true">↓</span></a
          ><a class="text-link" href={`${base}/resume`}
            >Experience & résumé <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <a
        class="hero-photo"
        href={`${base}/photography`}
        aria-label="Photography gallery"
        ><img
          src={portraitImage.src}
          srcset={portraitImage.srcSet.attribute}
          sizes={portraitImage.attributes.sizes}
          width={portraitImage.attributes.width}
          height={portraitImage.attributes.height}
          alt="Charles photographing his reflection among hanging orchids"
          fetchpriority="high"
        /><span>Photography <span aria-hidden="true">→</span></span></a
      >
    </section>
    <section class="home-work" id="selected-work">
      <div class="section-heading">
        <h2>Projects</h2><a class="text-link" href={`${base}/projects`}
          >All projects <span aria-hidden="true">→</span></a
        >
      </div>{
        work.map((p) => (
          <a class="work-row" href={`${base}/projects/${p.slug}`}>
            <div>
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
            </div>
            <span class="work-kind">{p.kind}</span>
            <span class="work-arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </section>
    <section class="background">
      <h2>Experience</h2><div>
        <p>
          I have a pretty diverse background, from any perspective you can
          imagine.
        </p><ul class="employers">
          {
            resume.experience.map((e) => (
              <li>
                <span class="employer">{e.organization}</span>
                <span class="employer-role">{e.role}</span>
                <span class="employer-years">{years(e.dates)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <section class="photo-invitation">
      <a class="invite-photo" href={`${base}/photography`} aria-label="Photography gallery"
        ><img
          src={coastImage.src}
          srcset={coastImage.srcSet.attribute}
          sizes={coastImage.attributes.sizes}
          width={coastImage.attributes.width}
          height={coastImage.attributes.height}
          alt="A beach curving alongside a coastal road under a blue sky"
          loading="lazy"
          decoding="async"
        /></a
      ><div>
        <h2>Photography</h2><p>
          Trains, planes, coastlines, gardens, and streets.
        </p><a class="text-link" href={`${base}/photography`}
          >Browse the gallery <span aria-hidden="true">→</span></a
        >
      </div>
    </section>
    <section class="closing">
      <h2>Get in touch</h2><a class="text-link" href={`mailto:${SITE.email}`}
        >{SITE.email} <span aria-hidden="true">↗</span></a
      >
    </section>
  </div>
</BaseLayout>
<style>
  .home-opening {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    /* Short enough that the projects start on the first screen. */
    padding: 0 0 3rem;
  }
  .hero-copy h1 {
    font-size: var(--fs-display);
    letter-spacing: -0.04em;
    line-height: 1.03;
    margin: 0 0 1.25rem;
  }
  .hero-role {
    font-size: var(--fs-lede);
    line-height: 1.5;
    margin: 0 0 0.3rem;
  }
  .hero-facts {
    font-size: var(--fs-label);
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .hero-blurb {
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--muted);
    max-width: 34rem;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }
  .hero-photo,
  .invite-photo {
    display: block;
    position: relative;
    overflow: hidden;
  }
  .hero-photo img {
    display: block;
    width: 100%;
    height: clamp(300px, 34vw, 460px);
    object-fit: cover;
    object-position: center;
  }
  .hero-photo img,
  .invite-photo img {
    transition: transform 0.4s var(--ease-out);
  }
  /* On a mouse or trackpad, linked photos ease up slightly; they never dim. */
  @media (hover: hover) and (pointer: fine) {
    .hero-photo:hover img,
    .invite-photo:hover img {
      transform: scale(1.03);
      transition-duration: 0.6s;
    }
    .work-row:hover h3 {
      color: var(--accent);
    }
    .work-row:hover .work-arrow {
      transform: translateX(3px);
    }
  }
  .work-arrow {
    transition: transform 0.15s var(--ease-out);
  }
  .hero-photo > span {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    font-size: var(--fs-micro);
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .home-work {
    padding: 2rem 0 4rem;
    scroll-margin-top: 2rem;
  }
  .work-row {
    display: grid;
    grid-template-columns: 1fr 11rem 1rem;
    gap: 1.5rem;
    align-items: center;
    padding: 1.7rem 0;
    border-top: 1px solid var(--border);
    color: var(--fg);
  }
  .work-row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .work-row h3 {
    margin: 0;
    transition: color 0.15s;
  }
  .work-row p {
    color: var(--muted);
    margin: 0.4rem 0 0;
  }
  .work-kind {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .background {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    padding: 2rem 0 5rem;
  }
  .background p {
    font-size: var(--fs-lede);
    line-height: 1.5;
    max-width: 40rem;
  }
  .employers {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--border);
  }
  .employers li {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.4fr) 6.5rem;
    gap: 0.25rem 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .employer {
    font-weight: 500;
  }
  .employer-role,
  .employer-years {
    color: var(--muted);
  }
  .employer-years {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .photo-invitation {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 2rem 0 5rem;
  }
  .photo-invitation img {
    width: 100%;
    height: auto;
    display: block;
  }
  .photo-invitation p {
    color: var(--muted);
  }
  .closing {
    border-top: 1px solid var(--border);
    padding: 3rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .closing h2 {
    margin: 0;
  }
  @media (max-width: 760px) {
    .home-opening {
      grid-template-columns: 1fr;
      gap: 2rem;
      min-height: 0;
      padding-bottom: 2rem;
    }
    .hero-photo img {
      height: 360px;
      max-height: 55vh;
    }
    .hero-copy h1 {
      font-size: clamp(2.8rem, 10vw, 4.5rem);
    }
    .work-row {
      grid-template-columns: 1fr 1rem;
      gap: 1rem;
    }
    .work-kind {
      display: none;
    }
    .background {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: 2rem;
    }
    .employers li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .employer-role {
      grid-row: 2;
      grid-column: 1 / -1;
    }
    .photo-invitation {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-bottom: 3rem;
    }
  }
</style>
