---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { label: "Home", href: `${base}/` },
  { label: "Projects", href: `${base}/projects` },
  { label: "Photography", href: `${base}/photography` },
  { label: "Résumé", href: `${base}/resume` },
];
---

<BaseLayout title="Page not found" description="This page doesn’t exist.">
  <p class="eyebrow">404</p>
  <h1>Page not found</h1>
  <p class="muted">
    The link may be old, or the page may have moved. Try one of these instead.
  </p>
  <ul class="not-found-links">
    {
      links.map((l) => (
        <li>
          <a class="text-link" href={l.href}>
            {l.label} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
<style>
  h1 {
    margin: 2rem 0 1rem;
  }
  .not-found-links {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
</style>
