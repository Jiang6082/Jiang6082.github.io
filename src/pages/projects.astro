---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { projects } from "../data/projects";
import { walkthroughs } from "../data/research";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const names: Record<string, string> = {
  "project-emberforge": "Emberforge",
  "project-geld": "Geld",
  "market-volatility-forecasting": "Forecasting volatility",
  "Project-Olsen": "Olsen",
  "idx-exchange": "Property Search Platform",
};
const summaries: Record<
  string,
  { purpose: string; result: string; context: string }
> = {
  "project-emberforge": {
    purpose:
      "Find trading factors and test whether they survive statistical checks.",
    result: "24 candidates → 1 survivor",
    context: "Documented synthetic demo; not evidence of a live trading edge.",
  },
  "project-geld": {
    purpose:
      "Backtest equity strategies, account for trading costs, and run them in paper trading.",
    result: "15.92% annualized return vs. 15.30% for SPY",
    context:
      "V4 diagnostic, 2020–July 2026, at 10 bps slippage. Previously inspected history, not a fresh holdout.",
  },
  "market-volatility-forecasting": {
    purpose:
      "Forecast next-day volatility across 14 ETFs with walk-forward evaluation.",
    result: "39.7% lower QLIKE loss than persistence",
    context: "Recorded 2020–2025 ensemble forecasts; lower loss is better.",
  },
  "Project-Olsen": {
    purpose: "Research and backtest options strategies before paper trading.",
    result: "Explore an option’s payoff and price surface",
    context:
      "Illustrative options models; no strategy performance is published.",
  },
  "idx-exchange": {
    purpose:
      "Search properties on a map, narrow the results, and compare listings.",
    result: "Map filters → paginated listings → property comparison",
    context:
      "Implemented with React, Express, and MySQL. Demo listings are fictional.",
  },
};
---

<BaseLayout
  title="Work"
  description="Research tools, trading systems, and useful automation."
  wide
>
  <div class="page-shell">
    <header class="work-heading">
      <p class="eyebrow">Selected work / 01—05</p><h1>Projects</h1><p
        class="lede"
      >
        Research tools, trading systems, and useful automation.
      </p>
    </header>
    <div class="work-layout">
      <aside>
        <p class="eyebrow">Project index</p><nav aria-label="Project index">
          {
            projects.map((p, i) => (
              <a href={`#${p.name}`}>
                <span>{String(i + 1).padStart(2, "0")}</span>
                {names[p.name] || p.name}
              </a>
            ))
          }
        </nav>
      </aside>
      <div>
        {
          projects.map((p, i) => (
            <article id={p.name} class="project">
              <>
                <div class="project-meta eyebrow">
                  <>
                    <span>
                      {String(i + 1).padStart(2, "0")} / {p.language}
                    </span>
                    <span>
                      {p.visibility === "private"
                        ? "Private research"
                        : "Open source"}
                    </span>
                  </>
                </div>
                <h2>{names[p.name] || p.name}</h2>
                <p class="description">{summaries[p.name].purpose}</p>
                <p class="result">{summaries[p.name].result}</p>
                <p class="result-context">{summaries[p.name].context}</p>
                <div class="project-actions">
                  <details class="project-demo">
                    <summary>
                      Try demo <span aria-hidden="true">+</span>
                    </summary>
                    <ProjectVisual project={p.name} />
                  </details>
                  {walkthroughs.find((w) => w.project === p.name) && (
                    <a
                      class="text-link"
                      href={`${base}/projects/${walkthroughs.find((w) => w.project === p.name)!.slug}`}
                    >
                      Read walkthrough →
                    </a>
                  )}
                </div>
                <div class="project-bottom">
                  <p class="topics">{p.topics?.join(" / ")}</p>
                  {p.visibility === "public" && p.repo ? (
                    <a
                      class="text-link"
                      href={p.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Explore the code ↗
                    </a>
                  ) : (
                    <span class="private-note">Private repository</span>
                  )}
                  {p.demo && (
                    <a class="text-link" href={p.demo}>
                      View project ↗
                    </a>
                  )}
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .work-heading {
    padding: 1rem 0 5rem;
  }
  .work-heading h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 2rem 0;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--muted);
  }
  .work-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 5rem;
  }
  .work-layout aside {
    position: sticky;
    top: 3rem;
    align-self: start;
  }
  aside nav {
    display: flex;
    flex-direction: column;
  }
  aside a {
    display: flex;
    gap: 1.2rem;
    padding: 0.7rem 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  aside a span {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.8rem;
  }
  .project {
    border-top: 1px solid var(--border);
    padding: 2rem 0 3rem;
    scroll-margin-top: 2rem;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .project h2 {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 400;
    margin: 1rem 0;
    overflow-wrap: anywhere;
  }
  .description {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 44rem;
  }
  .result {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.3rem;
  }
  .result-context {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 43rem;
  }
  .project-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 0 1.5rem;
  }
  .project-actions > a {
    grid-area: 1 / 1;
    justify-self: end;
    align-self: start;
    position: relative;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .project-demo {
    grid-area: 1 / 1;
    min-width: 0;
  }
  .project-demo summary {
    width: max-content;
    cursor: pointer;
    list-style: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
  }
  .project-demo summary::-webkit-details-marker {
    display: none;
  }
  .project-demo[open] summary span {
    transform: rotate(45deg);
  }
  .project-demo :global(.project-visual) {
    min-width: 0;
  }
  .project-bottom {
    margin-top: 1.5rem;
  }
  .project-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .topics {
    font: 0.8125rem/1.8 var(--font-mono);
    max-width: 25rem;
    color: var(--muted);
    margin: 0;
  }
  .private-note {
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .work-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .work-layout aside {
      position: static;
    }
    .work-heading {
      padding-bottom: 2rem;
    }
    aside nav {
      flex-direction: row;
      gap: 0.3rem 1.2rem;
      flex-wrap: wrap;
    }
    .project {
      padding-bottom: 3rem;
    }
  }
</style>
