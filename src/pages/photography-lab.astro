---
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { collections, singles, type Photo } from "../data/photos";
import { getImage } from "astro:assets";

const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;

async function toItem(p: Photo) {
  const mod = p.src ? files[`../photos/${p.src}`] : undefined;
  if (!mod) return null;
  const meta = mod.default;
  const thumb = await getImage({ src: meta, width: Math.min(1100, meta.width), format: "webp" });
  const full = await getImage({ src: meta, width: Math.min(2400, meta.width), format: "webp" });
  return {
    title: p.title ?? "",
    caption: p.caption ?? "",
    alt: p.alt || p.title || "Photo",
    placeholder: false,
    ar: meta.width / meta.height,
    thumb: thumb.src,
    full: full.src,
  };
}

const all: Photo[] = [...collections.flatMap((c) => c.photos), ...singles];
const items = (await Promise.all(all.map(toItem))).filter(Boolean) as NonNullable<
  Awaited<ReturnType<typeof toItem>>
>[];

const step = items.length ? 360 / items.length : 40;
---

<BaseLayout title="Photography · Lab" description="An experimental 3D view of the gallery." wide>
  <div class="ring-head">
    <span class="eyebrow">EXPERIMENT</span>
    <h1>Standing in the gallery</h1>
    <p class="muted lede">
      You're in the middle, photos all around you. <strong>Scroll</strong> to
      turn and look around the room; <strong>click</strong> a photo to open it
      (scroll to zoom, drag to pan, ← / → to move). The
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/photography`}>standard gallery</a>
      is still the main one.
    </p>
  </div>

  <div class="lab-clip">
    <div class="ring-scene" id="scene">
      <div class="ring" id="ring">
        {
          items.map((it, i) => (
            <button
              class="ring-item"
              data-group="lab"
              data-index={i}
              data-a={(i * step).toFixed(3)}
              style={`--a:${(i * step).toFixed(3)}deg; width:clamp(13rem, 22vw, 19rem); aspect-ratio:${it.ar.toFixed(3)}`}
              aria-label={it.title || "Open photo"}
            >
              <img src={it.thumb} alt={it.alt} loading="lazy" draggable="false" />
            </button>
          ))
        }
      </div>
      <span class="ring-hint" aria-hidden="true">scroll to look around ⟲</span>
    </div>
  </div>

  <script
    is:inline
    set:html={`window.__GALLERY__ = [${JSON.stringify({
      key: "lab",
      title: "Photos",
      items: items.map((it) => ({
        title: it.title,
        caption: it.caption,
        alt: it.alt,
        placeholder: it.placeholder,
        thumb: it.thumb,
        full: it.full,
      })),
    })}];`}
  />

  <Lightbox />
</BaseLayout>

<script>
  const scene = document.getElementById("scene");
  const ring = document.getElementById("ring");
  const lb = document.getElementById("lightbox");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (scene && ring) {
    const faces = Array.from(ring.querySelectorAll<HTMLElement>(".ring-item"));
    const angles = faces.map((f) => parseFloat(f.dataset.a || "0"));
    const FADE = 74; // degrees from center at which a photo fully fades out

    let rot = 0;
    let target = 0;
    const norm = (a: number) => ((((a % 360) + 540) % 360) - 180);

    const loop = () => {
      rot += (target - rot) * 0.09;
      ring.style.setProperty("--rot", `${rot}deg`);
      // Fade photos out as they swing to your sides / behind you — this also
      // hides the extreme scaling CSS produces near the edges of view.
      for (let i = 0; i < faces.length; i++) {
        const d = Math.abs(norm(rot + angles[i]));
        const op = Math.max(0, Math.min(1, 1 - d / FADE));
        faces[i].style.opacity = String(op);
        faces[i].style.pointerEvents = op > 0.6 ? "auto" : "none";
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    scene.addEventListener(
      "wheel",
      (e) => {
        if (lb && !lb.hidden) return;
        e.preventDefault();
        target += e.deltaY * 0.16;
      },
      { passive: false }
    );

    // Drag / swipe to turn; suppress the click that opens a photo if dragged.
    let down = false;
    let moved = false;
    let lastX = 0;
    scene.addEventListener("pointerdown", (e) => {
      down = true;
      moved = false;
      lastX = e.clientX;
    });
    scene.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      if (Math.abs(dx) > 2) moved = true;
      target -= dx * 0.3;
    });
    const up = () => (down = false);
    scene.addEventListener("pointerup", up);
    scene.addEventListener("pointercancel", up);
    scene.addEventListener(
      "click",
      (e) => {
        if (moved) {
          e.stopPropagation();
          e.preventDefault();
        }
      },
      true
    );
  }
</script>

<style>
  .ring-head {
    max-width: var(--max-width-wide);
    margin: 0 auto 0.5rem;
    padding: 0 1.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .ring-head h1 {
    margin: 0.5rem 0 0.4rem;
  }
  .lede {
    max-width: 44rem;
    margin: 0;
  }
  .lede strong {
    color: var(--fg);
    font-weight: 600;
  }

  .lab-clip {
    overflow: hidden;
  }
  .ring-scene {
    position: relative;
    height: min(76vh, 42rem);
    margin-top: 1rem;
    /* Small perspective = wide field of view = feels immersive/first-person. */
    perspective: 900px;
    perspective-origin: 50% 50%;
    cursor: grab;
    touch-action: pan-y;
  }
  .ring-scene:active {
    cursor: grabbing;
  }
  /* The ring's rotation point is pushed out to the camera, so we sit at the
     centre of the circle of photos and rotating looks *around* the room. */
  .ring {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-style: preserve-3d;
    transform: translateZ(900px) rotateY(var(--rot, 0deg));
  }
  .ring-item {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    transform: translate(-50%, -50%) rotateY(var(--a)) translateZ(-700px);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 55px rgba(0, 0, 0, 0.55);
    backface-visibility: hidden;
    will-change: opacity;
  }
  .ring-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ring-hint {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--muted);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .ring {
      transform: translateZ(720px) rotateY(var(--rot, 0deg));
    }
    .ring-scene {
      perspective: 720px;
    }
    .ring-item {
      transform: translate(-50%, -50%) rotateY(var(--a)) translateZ(-560px);
    }
  }
</style>
