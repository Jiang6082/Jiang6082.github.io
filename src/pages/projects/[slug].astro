---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PropertyTrace from "../../components/PropertyTrace.astro";
import ProjectPlayground from "../../components/ProjectPlayground.astro";
import PageHeader from "../../components/PageHeader.astro";
import { walkthroughs } from "../../data/research";
import { projects, project } from "../../data/projects";
export function getStaticPaths() {
  return walkthroughs.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Title from the project record, so every page uses the same name.
const title = project(p.project).title;
// Previous / next walkthrough, in the Projects page order.
const order = projects.filter((x) => walkthroughs.some((w) => w.project === x.id));
const at = order.findIndex((x) => x.id === p.project);
const prev = at > 0 ? order[at - 1] : undefined;
const next = at < order.length - 1 ? order[at + 1] : undefined;
---

<BaseLayout title={title} description={p.intro} wide>
  <div class="reading-layout">
    <nav class="contents" aria-label="Walkthrough sections">
      <span class="label">On this page</span>
      {p.demo && <a href={`#demo-${p.project}`}>Try the interactive demo</a>}
      {p.sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
    </nav>
    <article class="walkthrough">
      <PageHeader
        title={title}
        lede={p.intro}
        crumbs={[{ label: "Projects", href: `${base}/projects#${p.project}` }, { label: title }]}
      >
        <dl class="summary" aria-label="Summary">
          <div>
            <dt>The problem</dt>
            <dd>{p.summary.problem}</dd>
          </div>
          <div>
            <dt>What I built</dt>
            <dd>{p.summary.built}</dd>
          </div>
          <div>
            <dt>Key decisions</dt>
            <dd>
              <ul>
                {p.summary.decisions.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </dd>
          </div>
          <div>
            <dt>What I’d do next</dt>
            <dd>{p.summary.next}</dd>
          </div>
        </dl>
        <p class="scope">{p.caveat}</p>
        <dl class="facts">
          {
            p.facts.map((f) => (
              <div>
                <>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </PageHeader>
      <ProjectPlayground project={p.project} headingLevel={2} />
      {
        p.sections.map((s) => (
          <section id={s.id}>
            <h2>{s.title}</h2>
            {p.slug === "idx-exchange" && s.id === "request-path" && (
              <PropertyTrace />
            )}
            {s.paragraphs.map((text) => (
              <p>{text}</p>
            ))}
            {s.code && (
              <pre><code>{s.code}</code></pre>
            )}
            {s.table && (
              <div
                class="table-scroll"
                tabindex="0"
                role="region"
                aria-label={s.table.caption}
              >
                <table>
                  <caption>{s.table.caption}</caption>
                  <thead>
                    <tr>
                      {s.table.columns.map((c) => (
                        <th scope="col">{c}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((row) => (
                      <tr>
                        {row.map((cell, i) =>
                          i === 0 ? (
                            <th scope="row">{cell}</th>
                          ) : (
                            <td>{cell}</td>
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {s.image && (
              <figure>
                <a href={`${base}${s.image.src}`}>
                  <img
                    src={`${base}${s.image.src}`}
                    alt={s.image.alt}
                    width="550"
                    height="550"
                    loading="lazy"
                  />
                </a>
                <figcaption>{s.image.caption}</figcaption>
              </figure>
            )}
            {s.sources.length > 0 && (
              <ul class="sources" aria-label={`Sources for ${s.title}`}>
                {s.sources.map((source) => (
                  <li>
                    <a href={source.url} target="_blank" rel="noopener noreferrer"
                      >{source.label} <span aria-hidden="true">↗</span></a
                    >
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
      <footer>
        <div class="repo">
          {
            p.source ? (
              <a class="text-link" href={p.source} target="_blank" rel="noopener noreferrer">
                Code on GitHub <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="private-note">Private repository</span>
            )
          }
        </div>
        <nav class="pager" aria-label="More walkthroughs">
          {
            prev && (
              <a href={`${base}/projects/${prev.slug}`} rel="prev">
                <span class="pager-dir"><span aria-hidden="true">←</span> Previous</span>
                <span class="pager-title">{prev.title}</span>
              </a>
            )
          }
          {
            next && (
              <a href={`${base}/projects/${next.slug}`} rel="next" class="pager-next">
                <span class="pager-dir">Next <span aria-hidden="true">→</span></span>
                <span class="pager-title">{next.title}</span>
              </a>
            )
          }
        </nav>
      </footer>
    </article>
  </div>
</BaseLayout>
<script>
  import { spySections } from "../../scripts/section-spy";
  spySections(".contents a");
</script>
<style>
  .reading-layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 48rem);
    gap: clamp(2rem, 4vw, 4rem);
    max-width: 70rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    align-items: start;
  }
  .walkthrough {
    padding: 1rem 0 4rem;
    min-width: 0;
  }
  .walkthrough :global(.page-head) {
    padding-bottom: 1rem;
  }
  .summary {
    margin: 2rem 0 0;
    border-top: 1px solid var(--border);
  }
  .summary > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .summary dt {
    font-size: var(--fs-label);
    color: var(--muted);
    line-height: 1.7;
    padding-top: 0.1rem;
  }
  .summary dd {
    margin: 0;
    line-height: 1.65;
    max-width: 68ch;
  }
  .summary ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .summary li + li {
    margin-top: 0.35rem;
  }
  .scope {
    color: var(--muted);
    max-width: 68ch;
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    margin: 2rem 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border);
    margin: 2rem 0 0;
    gap: 1.5rem;
    padding: 1.5rem 0;
  }
  .facts div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
  }
  .facts dt {
    font-size: var(--fs-label);
    color: var(--muted);
    line-height: 1.5;
  }
  .facts dd {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    margin: 0;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.025em;
  }
  .contents {
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 3rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    padding: 1rem 0;
    margin-top: 1rem;
    border-left: 1px solid var(--border);
    font-size: var(--fs-label);
    line-height: 1.5;
  }
  .contents > .label {
    padding: 0 1rem 0.75rem;
  }
  .contents a {
    color: var(--muted);
    display: flex;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    border-left: 2px solid transparent;
    margin-left: -1px;
    text-decoration: none;
  }
  .contents a:hover,
  .contents a[aria-current="location"] {
    color: var(--accent);
    background: var(--surface-2);
    border-left-color: var(--accent);
  }
  @media (max-width: 1000px) {
    .reading-layout {
      display: block;
      max-width: 48rem;
    }
    .contents {
      position: static;
      max-height: none;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.35rem 0.5rem;
      margin: 0 0 2rem;
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }
    .contents > .label {
      flex-basis: 100%;
      padding: 0 0 0.5rem;
    }
    .contents a {
      padding: 0.5rem;
      margin: 0;
    }
  }
  section {
    margin: 3.5rem 0;
    scroll-margin-top: 2rem;
  }
  section > p {
    font-size: var(--fs-body);
    line-height: 1.65;
    max-width: 68ch;
  }
  pre {
    padding: 1.5rem;
    background: var(--surface-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  code {
    font: var(--fs-label) / 1.8 var(--font-mono);
  }
  .table-scroll {
    overflow-x: auto;
    max-width: 100%;
    margin: 2rem 0;
    overscroll-behavior-x: contain;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-label);
    font-variant-numeric: tabular-nums;
    text-align: left;
  }
  caption {
    text-align: left;
    font-variant-numeric: normal;
    color: var(--muted);
    font-size: var(--fs-label);
    line-height: 1.6;
    padding-bottom: 1rem;
    caption-side: top;
  }
  th,
  td {
    padding: 0.85rem 0.8rem;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  th:first-child {
    white-space: normal;
    min-width: 8rem;
  }
  thead {
    background: var(--surface-2);
  }
  thead th {
    font-size: var(--fs-micro);
    font-weight: 600;
  }
  tbody th {
    font-weight: 400;
  }
  td {
    text-align: right;
  }
  thead th:not(:first-child) {
    text-align: right;
  }
  tbody tr:hover {
    background: var(--surface-2);
  }
  figure {
    margin: 2rem 0;
  }
  img {
    display: block;
    width: 100%;
    max-width: 550px;
    height: auto;
    margin: auto;
    background: white;
  }
  figcaption {
    font-size: var(--fs-label);
    color: var(--muted);
    line-height: 1.6;
    margin-top: 1rem;
  }
  .sources {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    font-size: var(--fs-label);
    line-height: 1.6;
    margin-top: 1.5rem;
  }
  .sources a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .private-note {
    font-size: var(--fs-label);
    color: var(--muted);
    align-self: center;
  }
  footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    color: var(--fg);
    transition: transform 0.16s var(--ease-out);
  }
  .pager a:hover {
    text-decoration: none;
  }
  .pager a:active {
    transform: scale(0.98);
  }
  .pager-next {
    grid-column: 2;
    text-align: right;
  }
  .pager-dir {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .pager-title {
    font-size: var(--fs-h3);
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  @media (hover: hover) and (pointer: fine) {
    .pager a:hover .pager-title {
      color: var(--accent);
    }
  }
  @media (max-width: 560px) {
    .summary > div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
  @media (max-width: 480px) {
    .facts {
      gap: 0.75rem;
    }
    th,
    td {
      padding: 0.75rem 0.55rem;
    }
    .facts dt {
      font-size: var(--fs-micro);
    }
  }
</style>
