---
import { SITE } from "../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  { label: "Work", href: `${base}/projects` },
  { label: "Photography", href: `${base}/photography` },
  { label: "Résumé", href: `${base}/resume` },
  { label: "Notes", href: `${base}/blog` },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={`${base}/`} aria-label={`${SITE.name}, home`}
      >charles jiang<span aria-hidden="true">.</span></a
    ><nav aria-label="Main navigation">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={current.startsWith(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }<a class="contact" href={`mailto:${SITE.email}`}>Say hello ↗</a>
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--bg);
  }
  .header-inner {
    margin: 0 var(--gutter);
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    gap: 1rem;
  }
  .brand {
    color: var(--fg);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.07em;
    white-space: nowrap;
  }
  .brand span {
    color: var(--accent);
  }
  nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  nav a {
    color: var(--muted);
    font-size: 0.875rem;
    padding: 12px 0;
  }
  nav a[aria-current] {
    color: var(--accent);
  }
  .contact {
    margin-left: 1.5rem;
    color: var(--fg);
  }
  @media (max-width: 800px) {
    .header-inner {
      height: auto;
      min-height: 92px;
      flex-wrap: wrap;
      gap: 0;
      padding: 12px 0;
    }
    .brand {
      font-size: 1.15rem;
    }
    nav {
      gap: 1rem;
      flex-wrap: wrap;
    }
    nav a {
      font-size: 0.875rem;
    }
    .contact {
      display: none;
    }
  }
</style>
