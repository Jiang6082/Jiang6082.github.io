---
import { SITE, SOCIALS } from "../config";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="socials">
      {
        SOCIALS.map((s) => (
          <a href={s.url} target={s.url.startsWith("http") ? "_blank" : undefined} rel="noopener">
            {s.name}
          </a>
        ))
      }
    </div>
    <p class="muted small">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .socials {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .socials a {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .socials a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .site-footer p {
    margin: 0;
  }
</style>
