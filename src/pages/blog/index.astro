---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title="Blog" description="Writing and notes.">
  <h1>Blog</h1>
  <p class="muted">Thoughts, notes, and things I'm working on.</p>

  {posts.length === 0 && <p class="muted">No posts yet — check back soon.</p>}

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a class="title" href={`${base}/blog/${post.id}`}>
            {post.data.title}
          </a>
          <time class="muted small" datetime={post.data.date.toISOString()}>
            {fmt(post.data.date)}
          </time>
          {post.data.description && <p class="muted excerpt">{post.data.description}</p>}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }
  .post-list li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--fg);
    display: block;
  }
  .title:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .excerpt {
    margin: 0.35rem 0 0;
  }
</style>
