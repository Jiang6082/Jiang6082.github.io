---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PhotoTabs from "../../../components/PhotoTabs.astro";
import PageHeader from "../../../components/PageHeader.astro";
import AviationTabs from "../../../components/AviationTabs.astro";
import DarkroomMotion from "../../../components/DarkroomMotion.astro";
import "@fontsource/b612/400.css";
import "@fontsource/b612/700.css";
import "@fontsource/b612-mono/400.css";
import "@fontsource/b612-mono/700.css";
import "../../../styles/darkroom.css";
import "../../../styles/airside.css";
import { AVIATION } from "../../../config";
import { catches } from "../../../data/aviation";
import recordCsv from "../../../data/heathrow-record.csv?raw";
import { parseRecord, buildRecord, renderRecord, defaultState } from "../../../lib/record.js";
import { flapHTML } from "../../../lib/flap.js";

const rows = parseRecord(recordCsv);
const model = buildRecord(rows, catches);
const first = renderRecord(model, defaultState);
const alliances = [...new Set(model.map((a) => a.alliance))].sort((a, b) =>
  a === "Unaligned" ? 1 : b === "Unaligned" ? -1 : a.localeCompare(b),
);
const sampleTicks = catches.some((c) => c.sample);
const json = (v: unknown) => JSON.stringify(v).replace(/</g, "\\u003c");
const pad = (n: number, w = 2) => String(n).padStart(w, "0");
const pct = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Heathrow record"
  description="Every airline at London Heathrow and the aircraft they fly, ticked off as Charles Jiang photographs them."
  bodyClass="theme-darkroom theme-airside"
  wide
>
  <PageHeader
    class="page-shell"
    title="Heathrow record"
    crumbs={[
      { label: "Photography", href: `${base}/photography` },
      { label: "Aviation", href: `${base}/photography/aviation` },
      { label: "Record" },
    ]}
  />
  <PhotoTabs current="aviation" />
  <div class="page-shell">
    <AviationTabs current="record" />
    {
      sampleTicks && (
        <p class="ph-notice">
          <b>NOTICE</b>
          <span>
            Lit types come from the sample logbook entries and will go dark with
            them. Real ticks come from my Google Sheet and logbook photos.
          </span>
        </p>
      )
    }
    <dl class="ph-stats">
      <div>
        <dt>Types photographed</dt>
        <dd><span class="flap" data-stat="caught" aria-label={`${pad(first.stats.caught, 3)}/${pad(first.stats.types, 3)}`} set:html={flapHTML(`${pad(first.stats.caught, 3)}/${pad(first.stats.types, 3)}`)} /></dd>
      </div>
      <div>
        <dt>Complete</dt>
        <dd><span class="flap" data-stat="pct" aria-label={`${pad(pct(first.stats.caught, first.stats.types))}%`} set:html={flapHTML(`${pad(pct(first.stats.caught, first.stats.types))}%`)} /></dd>
      </div>
      <div>
        <dt>Airlines started</dt>
        <dd><span class="flap" data-stat="started" aria-label={`${pad(first.stats.started)}/${pad(first.stats.airlines)}`} set:html={flapHTML(`${pad(first.stats.started)}/${pad(first.stats.airlines)}`)} /></dd>
      </div>
      <div>
        <dt>Airlines finished</dt>
        <dd><span class="flap" data-stat="complete" aria-label={pad(first.stats.complete)} set:html={flapHTML(pad(first.stats.complete))} /></dd>
      </div>
    </dl>

    <div class="ph-panel" data-controls hidden>
      <div class="ph-panel-row">
        <label class="ph-label" for="record-search">Search</label>
        <input
          id="record-search"
          class="ph-search"
          type="search"
          data-control="q"
          placeholder="Airline, code, or aircraft"
          autocomplete="off"
        />
      </div>
      <div class="ph-panel-row">
        <span class="ph-label">Show</span>
        <div class="ph-options" role="group" aria-label="Show">
          <button type="button" class="ph-tile" data-show="all" aria-pressed="true">All</button>
          <button type="button" class="ph-tile" data-show="caught" aria-pressed="false">Photographed</button>
          <button type="button" class="ph-tile" data-show="missing" aria-pressed="false">To find</button>
        </div>
      </div>
      <div class="ph-panel-row">
        <span class="ph-label">Alliance</span>
        <div class="ph-options" role="group" aria-label="Alliance">
          <button type="button" class="ph-tile" data-alliance="all" aria-pressed="true">All</button>
          {
            alliances.map((a) => (
              <button type="button" class="ph-tile" data-alliance={a} aria-pressed="false">
                {a}
              </button>
            ))
          }
        </div>
      </div>
      <div class="ph-panel-row">
        <span class="ph-label">Aircraft · Sort</span>
        <div class="ph-options rec-view">
          <div class="ph-options" role="group" aria-label="Aircraft">
            <button type="button" class="ph-tile" data-scope="heathrow" aria-pressed="true">Seen at LHR</button>
            <button type="button" class="ph-tile" data-scope="fleet" aria-pressed="false">Whole fleet</button>
          </div>
          <div class="ph-options" role="group" aria-label="Sort by">
            <button type="button" class="ph-tile" data-sort="az" aria-pressed="true">A–Z</button>
            <button type="button" class="ph-tile" data-sort="caught" aria-pressed="false">Most lit</button>
            <button type="button" class="ph-tile" data-sort="progress" aria-pressed="false">Closest</button>
          </div>
          <p class="ph-readout" data-source>
            {AVIATION.recordSheetCsv ? "Loading the latest sheet…" : "Source: last site update"}
          </p>
        </div>
      </div>
    </div>

    <ul class="rec-legend" aria-label="Key">
      <li class="as-cell is-caught"><b>A388</b><span>Photographed</span></li>
      <li class="as-cell"><b>B789</b><span>Flies to LHR</span></li>
      <li class="as-cell is-occasional"><b>A21N</b><span>Occasional</span></li>
    </ul>

    <div id="record" class="as-board" data-sheet={AVIATION.recordSheetCsv} set:html={first.html} />
    <p class="ph-note">
      Codes are ICAO aircraft types: A388 is the A380-800, B77W the 777-300ER.
      Hover over one for the full name and when it usually arrives (UK time; ≈
      marks times that haven’t been checked against a timetable). Airlines and
      aircraft come from public schedule and fleet information as of November
      2026, and some are best guesses.
    </p>
  </div>
  <script type="application/json" id="record-data" set:html={json({ rows, catches })} />
  <DarkroomMotion />
</BaseLayout>
<script>
  import { parseRecord, buildRecord, renderRecord, defaultState } from "../../../lib/record.js";
  import { rollFlap } from "../../../lib/flap.js";

  const root = document.getElementById("record")!;
  const controls = document.querySelector<HTMLElement>("[data-controls]")!;
  const source = controls.querySelector<HTMLElement>("[data-source]")!;
  const { rows, catches } = JSON.parse(document.getElementById("record-data")!.textContent!);
  let model = buildRecord(rows, catches);

  const params = new URLSearchParams(location.search);
  const state: Record<string, string> = {
    ...defaultState,
    q: params.get("q") ?? "",
    show: params.get("show") ?? "all",
    scope: params.get("scope") ?? "heathrow",
    alliance: params.get("alliance") ?? "all",
    sort: params.get("sort") ?? "az",
  };
  const pad = (n: number, w = 2) => String(n).padStart(w, "0");
  const set = (name: string, text: string) => {
    const el = document.querySelector(`[data-stat="${name}"]`);
    if (el && el.getAttribute("aria-label") !== text) rollFlap(el as HTMLElement, text);
  };

  let drawn = false;
  function render() {
    const { html, stats } = renderRecord(model, state as typeof defaultState);
    // Only the first draw plays the fill-in animation.
    if (drawn) root.classList.add("is-settled");
    drawn = true;
    root.innerHTML = html;
    set("caught", `${pad(stats.caught, 3)}/${pad(stats.types, 3)}`);
    set("pct", `${pad(stats.types ? Math.round((stats.caught / stats.types) * 100) : 0)}%`);
    set("started", `${pad(stats.started)}/${pad(stats.airlines)}`);
    set("complete", pad(stats.complete));
    for (const key of ["show", "alliance", "scope", "sort"])
      controls.querySelectorAll<HTMLButtonElement>(`[data-${key}]`).forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset[key] === state[key])),
      );
    const next = new URLSearchParams();
    for (const [key, value] of Object.entries(state))
      if (value && value !== (defaultState as Record<string, string>)[key]) next.set(key, value);
    const query = next.toString();
    history.replaceState(null, "", query ? `?${query}` : location.pathname);
  }

  const search = controls.querySelector<HTMLInputElement>('[data-control="q"]')!;
  search.value = state.q;
  // Wait for a pause in typing before redrawing the board.
  let typing = 0;
  search.addEventListener("input", () => {
    clearTimeout(typing);
    typing = window.setTimeout(() => ((state.q = search.value), render()), 120);
  });
  for (const key of ["show", "alliance", "scope", "sort"])
    controls.querySelectorAll<HTMLButtonElement>(`[data-${key}]`).forEach((b) =>
      b.addEventListener("click", () => ((state[key] = b.dataset[key]!), render())),
    );
  controls.hidden = false;
  render();

  // Live data: the published Google Sheet, when one is configured.
  const sheet = root.dataset.sheet;
  if (sheet) {
    const url = `${sheet}${sheet.includes("?") ? "&" : "?"}t=${Date.now()}`;
    fetch(url)
      .then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status)))))
      .then((text) => {
        const live = parseRecord(text);
        if (!live.length) throw new Error("empty sheet");
        model = buildRecord(live, catches);
        source.textContent = "Source: live Google Sheet";
        render();
      })
      .catch(() => {
        source.textContent = "Source: last site update (live sheet didn’t load)";
      });
  }
</script>
<style>
  .rec-view {
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .rec-view .ph-readout {
    margin: 0 0 0 auto;
  }
  .rec-legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 0;
    margin: 0 0 1rem;
  }
  /* Board rows are rendered by src/lib/record.js, so these are global. */
  .as-board :global(.as-row),
  .rec-legend {
    --cell: 5.6rem;
  }
  .as-board {
    border-top: 2px solid var(--accent);
  }
  .as-board :global(.as-row) {
    display: grid;
    grid-template-columns: minmax(15rem, 19rem) minmax(0, 1fr);
    gap: 1rem 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .as-board :global(.as-row-head) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.8rem;
    align-content: start;
  }
  .as-board :global(.as-row-head .ph-tile) {
    grid-row: span 2;
    align-self: start;
    background: var(--surface-2);
  }
  .as-board :global(.as-row.is-complete .as-row-head .ph-tile) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .as-board :global(.as-row-name h2) {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.25;
  }
  .as-board :global(.as-row-name p) {
    font: var(--fs-micro) var(--font-mono);
    color: var(--dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0.2rem 0 0;
  }
  .as-board :global(.as-row-progress) {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.35rem 0 0;
  }
  .as-board :global(.as-row-count) {
    font: 700 var(--fs-label) var(--font-mono);
    color: var(--accent);
    white-space: nowrap;
  }
  .as-board :global(.as-row-count span) {
    color: var(--dim);
    font-weight: 400;
  }
  .as-board :global(.as-bar) {
    flex: 1;
    max-width: 8rem;
    height: 4px;
    background: var(--surface-2);
  }
  .as-board :global(.as-bar span) {
    display: block;
    height: 100%;
    background: var(--accent);
  }
  .as-board :global(.as-cells) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--cell), 1fr));
    gap: 4px;
    align-content: start;
  }
  .as-board :global(.as-cell),
  .rec-legend .as-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0.55rem 0.55rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .rec-legend .as-cell {
    min-width: var(--cell);
  }
  .as-board :global(.as-cell b),
  .rec-legend .as-cell b {
    font: 700 1rem/1 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .as-board :global(.as-cell span:not(.sr-only)),
  .rec-legend .as-cell span {
    font-size: var(--fs-micro);
    line-height: 1.2;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .as-board :global(.as-cell.is-caught),
  .rec-legend .as-cell.is-caught {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .as-board :global(.as-cell.is-caught span:not(.sr-only)),
  .rec-legend .as-cell.is-caught span {
    color: #4a4206;
  }
  .as-board :global(.as-cell.is-caught)::after,
  .rec-legend .as-cell.is-caught::after {
    content: "✓";
    content: "✓" / "";
    position: absolute;
    top: 0.4rem;
    right: 0.5rem;
    font: 700 var(--fs-micro)/1 var(--font-mono);
  }
  .as-board :global(.as-cell.is-occasional),
  .rec-legend .as-cell.is-occasional {
    border-style: dashed;
    border-color: #4a4e52;
  }
  /* The board fills in once, when the page opens: rows first, then the
     types along each row, with the gaps shrinking down the page. Photographed
     types then light up. Filtering and searching just redraw it. */
  .as-board :global(.as-cell) {
    animation: cell-in 0.4s var(--ease-out) both;
    animation-delay: calc(min(var(--r, 0), 8) * 25ms + min(var(--c, 0), 8) * 14ms);
    animation-delay: calc(sqrt(min(var(--r, 0), 8)) * 70ms + min(var(--c, 0), 8) * 14ms);
  }
  .as-board :global(.as-cell.is-caught) {
    animation-name: cell-in, cell-lit;
    animation-duration: 0.4s, 0.5s;
  }
  .as-board.is-settled :global(.as-cell) {
    animation: none;
  }
  @keyframes cell-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @keyframes cell-lit {
    from {
      background: var(--surface);
      color: var(--fg);
    }
  }
  .as-board :global(.as-cell.is-elsewhere) {
    background: transparent;
    color: var(--dim);
  }
  .as-board :global(.ph-empty) {
    color: var(--muted);
    padding: 2rem 0;
  }
  .as-board :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .as-board :global(.as-row) {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .as-board :global(.as-row),
    .rec-legend {
      --cell: 5.4rem;
    }
    .rec-view .ph-readout {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
