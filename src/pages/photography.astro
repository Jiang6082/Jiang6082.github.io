---
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { collections, singles } from "../data/photos";
import { SITE } from "../config";
import { getImage } from "astro:assets";
const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const albums = [
  ...collections,
  ...(singles.length
    ? [
        {
          id: "singles",
          title: "Other photographs",
          description: "",
          photos: singles,
        },
      ]
    : []),
];
const entries = albums.flatMap((album) =>
  album.photos.map((photo) => ({ photo, album })),
);
const processed = await Promise.all(
  entries.map(async ({ photo: p, album }, i) => {
    const meta = p.src ? files[`../photos/${p.src}`]?.default : undefined;
    if (!meta) return null;
    const thumb = await getImage({
      src: meta,
      width: Math.min(1100, meta.width),
      format: "webp",
    });
    const full = await getImage({
      src: meta,
      width: Math.min(2400, meta.width),
      format: "webp",
    });
    return {
      title: p.title || `Photograph ${i + 1}`,
      caption: p.caption || "",
      alt: p.alt || p.title || `Photograph ${i + 1} by Charles Jiang`,
      location: p.location || "",
      date: p.date || "",
      album: album.id,
      albumTitle: album.title,
      placeholder: false,
      thumb: thumb.src,
      full: full.src,
      width: meta.width,
      height: meta.height,
    };
  }),
);
const items = processed.filter(
  (item): item is NonNullable<typeof item> => item !== null,
);
const galleryGroups = [
  { key: "photographs", title: "All photographs", items },
  ...albums.map((a) => ({
    key: `album-${a.id}`,
    title: a.title,
    items: items.filter((it) => it.album === a.id),
  })),
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Photography"
  description="A personal collection of photographs by Charles Jiang."
  wide
>
  <header class="gallery-heading page-shell">
    <p class="eyebrow">
      Away from the screen / {String(items.length).padStart(2, "0")} frames
    </p><div>
      <h1>Photography</h1><p>
        Travel, light, and the things<br />I wanted to remember.
      </p>
    </div>
  </header>
  <div class="gallery-toolbar page-shell">
    <div class="album-switch" role="group" aria-label="Filter by album" hidden>
      <button type="button" data-album="all" aria-pressed="true"
        >All photographs <span>{items.length}</span></button
      >{
        albums.map((a) => (
          <button
            type="button"
            data-album={a.id}
            data-description={a.description}
            aria-pressed="false"
          >
            {a.title}{" "}
            <span>{items.filter((it) => it.album === a.id).length}</span>
          </button>
        ))
      }
    </div><div
      class="view-switch"
      role="group"
      aria-label="Gallery view"
      hidden
    >
      <button type="button" data-view="strip" aria-pressed="false"
        >3D filmstrip</button
      ><button type="button" data-view="sheet" aria-pressed="true"
        >Contact sheet</button
      >
    </div>
  </div>
  <div class="album-summary page-shell">
    <p id="album-description">All photographs</p><a
      href={`${base}/photography-classic`}>Classic view ↗</a
    >
  </div>
  <div class="strip-shell page-shell">
    <section
      class="photo-collection"
      id="photo-collection"
      aria-label="Photographs"
      tabindex="0"
      aria-describedby="gallery-help"
    >
      {
        items.map((it, i) => (
          <figure data-album-id={it.album} data-photo-index={i}>
            <>
              <a
                href={it.full}
                class="photo-open"
                data-group="photographs"
                data-index={i}
                aria-label={`Open ${it.title}`}
              >
                <>
                  <img
                    src={it.thumb}
                    alt={it.alt}
                    width={it.width}
                    height={it.height}
                    loading={i < 2 ? "eager" : "lazy"}
                    draggable="false"
                  />
                  <span class="open-hint" aria-hidden="true">
                    View photograph ↗
                  </span>
                </>
              </a>
              <figcaption>
                <>
                  <div class="caption-title">
                    <>
                      <span>{it.title}</span>
                      <span class="frame-number">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                    </>
                  </div>
                  <p>{it.caption}</p>
                  <div class="caption-meta">
                    <span>{it.albumTitle}</span>
                    {it.location && <span>{it.location}</span>}
                    {it.date && <span>{it.date}</span>}
                  </div>
                </>
              </figcaption>
            </>
          </figure>
        ))
      }
    </section>
  </div>
  <div class="gallery-controls page-shell" hidden>
    <div class="step-controls">
      <button
        type="button"
        id="previous-photo"
        aria-label="Previous photograph"
        aria-controls="photo-collection">←</button
      ><span
        id="gallery-position"
        role="status"
        aria-live="polite"
        aria-atomic="true">1 / {items.length}</span
      ><button
        type="button"
        id="next-photo"
        aria-label="Next photograph"
        aria-controls="photo-collection">→</button
      >
    </div><p id="gallery-help">
      Scroll up or down to browse. You can also swipe or use the arrow keys.
    </p><button class="depth-toggle" type="button" aria-pressed="true"
      >Depth on</button
    >
  </div>
  <p class="gallery-end page-shell">
    That’s the collection, for now. <a href={`mailto:${SITE.email}`}
      >Say hello ↗</a
    >
  </p>
  <script
    is:inline
    set:html={`window.__GALLERY__ = ${JSON.stringify(galleryGroups).replace(/</g, "\\u003c")};`}
  /><Lightbox />
</BaseLayout>
<script src="../scripts/photography.ts"></script>
<style>
  .gallery-heading {
    padding: 1rem 0 3rem;
  }
  .gallery-heading > div {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
  }
  .gallery-heading h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin: 1.8rem 0 0;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .gallery-heading > div > p {
    font-size: 1.15rem;
    color: var(--muted);
  }
  .gallery-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding: 1.2rem 0;
  }
  .album-switch,
  .view-switch {
    display: flex;
    gap: 0.4rem 1.3rem;
    flex-wrap: wrap;
  }
  .gallery-toolbar button,
  .depth-toggle {
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0.6rem 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .gallery-toolbar button[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .album-switch span {
    font-size: 0.75rem;
    margin-left: 0.35rem;
    color: var(--muted);
  }
  .album-switch[hidden],
  .view-switch[hidden],
  .gallery-controls[hidden] {
    display: none;
  }
  .album-summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .album-summary p {
    margin-bottom: 0;
  }
  .album-summary a {
    color: inherit;
  }
  .photo-collection {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem 3rem;
    padding-top: 2rem;
  }
  .photo-collection figure {
    margin: 0;
    min-width: 0;
    perspective: 1300px;
  }
  .photo-collection figure:nth-child(3n + 2) {
    padding-top: 4rem;
  }
  .photo-collection figure[hidden] {
    display: none;
  }
  .photo-open {
    display: block;
    position: relative;
    background: var(--surface-2);
    transform: perspective(1300px) rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg));
    transition: transform 0.18s ease-out;
    transform-origin: center;
    outline-offset: 8px;
  }
  .photo-open img {
    width: 100%;
    height: auto;
  }
  .open-hint {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    color: #fff;
    background: #222d;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .photo-open:hover .open-hint,
  .photo-open:focus-visible .open-hint {
    opacity: 1;
  }
  figcaption {
    padding-top: 1rem;
    color: var(--fg);
  }
  .caption-title {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1rem;
  }
  .frame-number {
    font: 0.8125rem var(--font-mono);
    color: var(--muted);
  }
  figcaption p {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0.45rem 0;
    color: var(--muted);
  }
  .caption-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .strip-shell {
    --frame-width: min(64vw, 680px);
  }
  .filmstrip {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    padding: 2rem max(0px, calc((100% - var(--frame-width)) / 2)) 1.5rem;
    touch-action: pan-x pan-y;
    isolation: isolate;
  }
  .filmstrip figure,
  .filmstrip figure:nth-child(3n + 2) {
    padding-top: 0;
    flex: 0 0 var(--frame-width);
    scroll-snap-align: center;
    scroll-snap-stop: normal;
  }
  .filmstrip.wheel-browsing {
    scroll-snap-type: none;
  }
  .filmstrip .photo-open img {
    height: clamp(240px, 48svh, 520px);
    object-fit: contain;
  }
  .filmstrip .photo-open {
    background: transparent;
  }
  .filmstrip.depth-on .photo-open {
    transform: perspective(1300px) translateZ(var(--depth, 0px))
      rotateY(var(--rotation, 0deg)) rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg));
    transition: transform 0.12s ease-out;
  }
  .gallery-controls {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-top: 1.2rem;
  }
  .step-controls {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .step-controls button {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    background: none;
    color: var(--fg);
    border-radius: 50%;
    font-size: 1.25rem;
  }
  .step-controls button:disabled {
    opacity: 0.35;
  }
  .step-controls span {
    font: 0.8125rem var(--font-mono);
    min-width: 4rem;
    text-align: center;
  }
  .gallery-controls p {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0;
  }
  .depth-toggle:disabled {
    opacity: 0.5;
  }
  .gallery-end {
    padding-top: 4rem;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }
  @media (max-width: 700px) {
    .gallery-heading > div {
      display: block;
    }
    .gallery-heading > div > p {
      margin-top: 1.5rem;
    }
    .photo-collection {
      gap: 2rem 1rem;
    }
    .photo-collection figure:nth-child(3n + 2) {
      padding-top: 2rem;
    }
    .strip-shell {
      --frame-width: 80vw;
    }
    .filmstrip {
      gap: 1rem;
    }
    .filmstrip figure:nth-child(3n + 2) {
      padding-top: 0;
    }
    .gallery-controls {
      flex-wrap: wrap;
      gap: 1rem;
    }
    .gallery-controls p {
      order: 3;
      width: 100%;
    }
    .gallery-end {
      flex-wrap: wrap;
    }
    .album-summary {
      align-items: start;
    }
    .caption-meta {
      font-size: 0.8125rem;
    }
  }
  @media (max-width: 420px) {
    .photo-collection:not(.filmstrip) {
      grid-template-columns: 1fr;
    }
    .photo-collection figure:nth-child(3n + 2) {
      padding-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-open,
    .filmstrip.depth-on .photo-open {
      transform: none !important;
      transition: none;
    }
  }
</style>
