---
import { SITE, SOCIALS } from "../config";
---

<footer class="site-footer page-shell">
  <p>© {new Date().getFullYear()} {SITE.name}</p><div>
    {
      SOCIALS.map((s) => (
        <a
          href={s.url}
          target={s.url.startsWith("http") ? "_blank" : undefined}
          rel="noopener noreferrer"
        >
          {s.name} ↗
        </a>
      ))
    }
  </div><a href="#top">Back to top ↑</a>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--muted);
  }
  p {
    margin: 0;
  }
  div {
    display: flex;
    gap: 1.5rem;
  }
  a {
    color: inherit;
  }
  @media (max-width: 640px) {
    .site-footer {
      flex-wrap: wrap;
    }
    div {
      gap: 1rem;
    }
  }
</style>
