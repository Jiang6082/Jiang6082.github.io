---
import { SITE, SOCIALS } from "../config";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <ul class="social-row socials">
      {
        SOCIALS.map((s) => (
          <li>
            <a
              class="social-icon"
              href={s.url}
              target={s.url.startsWith("http") ? "_blank" : undefined}
              rel="noopener"
              aria-label={s.name}
              title={s.name}
            >
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="muted small">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 0;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: var(--max-width-wide);
  }
  .socials {
    gap: 0.25rem;
  }
  .site-footer p {
    margin: 0;
  }
</style>
