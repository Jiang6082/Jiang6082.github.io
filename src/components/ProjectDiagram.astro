---
// A clear, representative figure for each project (they're code repos, not
// visual products). `kind` selects which one.
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<div class="diagram" data-kind={kind}>
  {
    kind === "funnel" && (
      <svg viewBox="0 0 240 150" role="img" aria-label="Many candidate factors filtered down to a few survivors">
        <text class="cap" x="120" y="12" text-anchor="middle">~1000 candidate factors</text>
        {Array.from({ length: 11 }).map((_, i) => (
          <circle class="dot" cx={26 + i * 19} cy="24" r="3" />
        ))}
        <path class="funnel" d="M30,36 L210,36 L146,96 L94,96 Z" />
        <text class="cap mid" x="120" y="70" text-anchor="middle">FDR · gates</text>
        <circle class="hit" cx="108" cy="118" r="5" />
        <circle class="hit" cx="120" cy="122" r="5" />
        <circle class="hit" cx="132" cy="118" r="5" />
        <text class="cap" x="120" y="142" text-anchor="middle">survivors</text>
      </svg>
    )
  }
  {
    kind === "equity" && (
      <svg viewBox="0 0 240 150" role="img" aria-label="Backtest equity curve">
        <line class="axis" x1="28" y1="18" x2="28" y2="122" />
        <line class="axis" x1="28" y1="122" x2="222" y2="122" />
        <path class="area" d="M28,104 L64,86 L96,94 L128,66 L160,74 L196,40 L216,30 L216,122 L28,122 Z" />
        <path class="curve" d="M28,104 L64,86 L96,94 L128,66 L160,74 L196,40 L216,30" />
        <text class="cap" x="34" y="16">equity</text>
      </svg>
    )
  }
  {
    kind === "predactual" && (
      <svg viewBox="0 0 240 150" role="img" aria-label="Predicted versus actual volatility">
        <line class="axis" x1="24" y1="122" x2="222" y2="122" />
        <path class="actual" d="M26,96 L52,58 L78,88 L104,42 L130,78 L156,50 L182,92 L208,60" />
        <path class="pred" d="M26,90 L52,66 L78,82 L104,52 L130,72 L156,58 L182,84 L208,66" />
        <g class="legend">
          <line class="actual" x1="150" y1="14" x2="166" y2="14" />
          <text class="cap" x="170" y="17">actual</text>
          <line class="pred" x1="150" y1="28" x2="166" y2="28" />
          <text class="cap" x="170" y="31">forecast</text>
        </g>
      </svg>
    )
  }
  {
    kind === "options" && (
      <svg viewBox="0 0 240 150" role="img" aria-label="Option payoff">
        <line class="axis" x1="30" y1="76" x2="222" y2="76" />
        <line class="axis" x1="120" y1="20" x2="120" y2="128" />
        <path class="payoff" d="M36,104 L120,104 L206,34" />
        <circle class="hit" cx="120" cy="104" r="4.5" />
        <text class="cap" x="126" y="122">strike</text>
        <text class="cap" x="200" y="30" text-anchor="end">profit</text>
      </svg>
    )
  }
  {
    kind === "scanlist" && (
      <ul class="scan">
        <li><span class="s-dot on" /><span class="s-co">Optiver</span><span class="s-role">Quant Intern · 2027</span></li>
        <li><span class="s-dot on" /><span class="s-co">Jane Street</span><span class="s-role">Quant Trader Intern</span></li>
        <li><span class="s-dot" /><span class="s-co">Citadel</span><span class="s-role">SWE Intern · new</span></li>
        <li><span class="s-dot on" /><span class="s-co">Virtu</span><span class="s-role">Quant Trading · 2027</span></li>
        <li><span class="s-dot" /><span class="s-co">Akuna</span><span class="s-role">Research Intern</span></li>
      </ul>
    )
  }
</div>

<style>
  .diagram {
    width: 100%;
    color: var(--accent);
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .axis {
    stroke: var(--border);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .cap {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
  }
  .cap.mid {
    fill: var(--fg);
    font-size: 8px;
  }
  .dot {
    fill: var(--muted);
    opacity: 0.65;
  }
  .hit {
    fill: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  .funnel {
    fill: color-mix(in srgb, var(--accent) 10%, transparent);
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    opacity: 0.85;
  }
  .area {
    fill: var(--accent);
    opacity: 0.12;
  }
  .curve {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 360;
    stroke-dashoffset: 360;
    animation: draw 4.5s ease-in-out infinite;
  }
  .actual {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .pred {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-dasharray: 3 4;
    stroke-linecap: round;
  }
  .payoff {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    animation: draw 4.5s ease-in-out infinite;
  }

  /* scan list (QJS) */
  .scan {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: var(--font-mono);
  }
  .scan li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.1rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-label);
  }
  .scan li:last-child {
    border-bottom: none;
  }
  .s-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--border);
    flex-shrink: 0;
  }
  .s-dot.on {
    background: var(--accent);
  }
  .s-co {
    color: var(--fg);
    font-weight: 600;
  }
  .s-role {
    color: var(--muted);
    margin-left: auto;
  }

  @keyframes draw {
    0% {
      stroke-dashoffset: var(--len, 360);
    }
    55%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .curve,
    .payoff,
    .hit {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 500px) {
    .s-role {
      display: none;
    }
  }
</style>
