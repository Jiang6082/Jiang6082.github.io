---
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import PhotoTabs from "../components/PhotoTabs.astro";
import DarkroomMotion from "../components/DarkroomMotion.astro";
import { collections, singles } from "../data/photos";
import { detailsFor, settingsLine } from "../data/photo-details";
import { SITE } from "../config";
import { getImage } from "astro:assets";
import { flapHTML } from "../lib/flap.js";
import "@fontsource/b612-mono/400.css";
import "@fontsource/b612-mono/700.css";
import "../styles/darkroom.css";
const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const albums = [
  ...collections,
  ...(singles.length
    ? [
        {
          id: "singles",
          title: "Other photographs",
          description: "",
          photos: singles,
        },
      ]
    : []),
];
const entries = albums.flatMap((album) =>
  album.photos.map((photo) => ({ photo, album })),
);
const processed = await Promise.all(
  entries.map(async ({ photo: p, album }, i) => {
    const meta = p.src ? files[`../photos/${p.src}`]?.default : undefined;
    if (!meta) return null;
    const thumbWidth = Math.min(1100, meta.width);
    const thumb = await getImage({
      src: meta,
      width: thumbWidth,
      widths: [400, 700, 1100].filter((w) => w <= thumbWidth),
      format: "webp",
    });
    const full = await getImage({
      src: meta,
      width: Math.min(2400, meta.width),
      format: "webp",
    });
    return {
      title: p.title || `Photograph ${i + 1}`,
      caption: p.caption || "",
      alt: p.alt || p.title || `Photograph ${i + 1} by Charles Jiang`,
      location: p.location || "",
      date: p.date || "",
      place: detailsFor(p.src).place?.name ?? "",
      settings: settingsLine(detailsFor(p.src)),
      album: album.id,
      albumTitle: album.title,
      placeholder: false,
      thumb: thumb.src,
      srcset: thumb.srcSet.attribute,
      full: full.src,
      width: meta.width,
      height: meta.height,
    };
  }),
);
const items = processed.filter(
  (item): item is NonNullable<typeof item> => item !== null,
);
const galleryGroups = [
  { key: "photographs", title: "All photographs", items },
  ...albums.map((a) => ({
    key: `album-${a.id}`,
    title: a.title,
    items: items.filter((it) => it.album === a.id),
  })),
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pad = (n: number, w = 2) => String(n).padStart(w, "0");
const cities = new Set(items.map((it) => it.place).filter(Boolean)).size;
---

<BaseLayout
  title="Photography"
  description="A personal collection of photographs by Charles Jiang."
  bodyClass="theme-darkroom"
  wide
>
  <header class="ph-head page-shell">
    <p class="eyebrow">Photography / Gallery</p><h1>Photography</h1><p>
      Trains, planes, coastlines, gardens, and streets.
    </p>
  </header>
  <PhotoTabs current="gallery" />
  <div class="page-shell">
    <dl class="ph-stats" style={`--n:${cities ? 3 : 2}`}>
      <div><dt>Frames</dt><dd><span class="flap" set:html={flapHTML(pad(items.length, 3))} /></dd></div>
      <div><dt>Albums</dt><dd><span class="flap" set:html={flapHTML(pad(albums.length))} /></dd></div>
      {cities > 0 && <div><dt>Cities</dt><dd><span class="flap" set:html={flapHTML(pad(cities))} /></dd></div>}
    </dl>
    <div class="ph-panel gallery-panel">
      <div class="ph-panel-row">
        <span class="ph-label">Album</span>
        <div class="ph-options album-switch" role="group" aria-label="Filter by album" hidden>
          <button type="button" class="ph-tile" data-album="all" aria-pressed="true"
            >All <sub>{items.length}</sub></button
          >{
            albums.map((a) => (
              <button
                type="button"
                class="ph-tile"
                data-album={a.id}
                data-description={a.description}
                aria-pressed="false"
              >
                {a.title} <sub>{items.filter((it) => it.album === a.id).length}</sub>
              </button>
            ))
          }
        </div>
      </div>
      <div class="ph-panel-row">
        <span class="ph-label">View</span>
        <div class="ph-options view-row">
          <div class="ph-options view-switch" role="group" aria-label="Gallery view" hidden>
            <button type="button" class="ph-tile" data-view="strip" aria-pressed="false"
              >3D filmstrip</button
            ><button type="button" class="ph-tile" data-view="sheet" aria-pressed="true"
              >Contact sheet</button
            >
          </div>
          <p class="ph-readout" id="album-description">All photographs</p>
          <a class="classic-link" href={`${base}/photography-classic`}
            >Classic view <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </div>
  </div>
  <div class="strip-shell page-shell">
    <section
      class="photo-collection"
      id="photo-collection"
      aria-label="Photographs"
      tabindex="0"
      aria-describedby="gallery-help"
    >
      {
        items.map((it, i) => (
          <figure data-album-id={it.album} data-photo-index={i} style={`--i:${i}`}>
            <>
              <a
                href={it.full}
                class="photo-open"
                data-group="photographs"
                data-index={i}
                aria-label={`Open ${it.title}`}
              >
                <>
                  <img
                    src={it.thumb}
                    srcset={it.srcset}
                    sizes="(max-width: 420px) 90vw, (max-width: 700px) 80vw, min(64vw, 680px)"
                    alt={it.alt}
                    width={it.width}
                    height={it.height}
                    loading={i < 2 ? "eager" : "lazy"}
                    class="ph-img"
                    draggable="false"
                  />
                  <span class="open-hint" aria-hidden="true">
                    View photograph ↗
                  </span>
                </>
              </a>
            </>
          </figure>
        ))
      }
    </section>
  </div>
  <div class="gallery-controls page-shell" hidden>
    <div class="step-controls">
      <button
        type="button"
        class="ph-tile"
        id="previous-photo"
        aria-label="Previous photograph"
        aria-controls="photo-collection">←</button
      ><span
        id="gallery-position"
        role="status"
        aria-live="polite"
        aria-atomic="true">1 / {items.length}</span
      ><button
        type="button"
        class="ph-tile"
        id="next-photo"
        aria-label="Next photograph"
        aria-controls="photo-collection">→</button
      >
    </div><p id="gallery-help">
      Scroll up or down to browse. You can also swipe or use the arrow keys.
    </p><button class="depth-toggle ph-tile" type="button" aria-pressed="true"
      >Depth on</button
    >
  </div>
  <p class="gallery-end page-shell">
    That’s the collection, for now. <a href={`mailto:${SITE.email}`}
      >Say hello <span aria-hidden="true">↗</span></a
    >
  </p>
  <script
    is:inline
    set:html={`window.__GALLERY__ = ${JSON.stringify(galleryGroups).replace(/</g, "\\u003c")};`}
  /><Lightbox />
  <DarkroomMotion />
</BaseLayout>
<script src="../scripts/photography.ts"></script>
<style>
  .view-row {
    gap: 0.75rem 1.25rem;
  }
  .view-row .ph-readout {
    flex: 1;
    min-width: 12rem;
  }
  .classic-link {
    font: 0.8rem var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .gallery-controls[hidden] {
    display: none;
  }
  .photo-collection {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem 3rem;
    padding-top: 2rem;
  }
  .photo-collection figure {
    margin: 0;
    min-width: 0;
    perspective: 1300px;
    animation: ph-rise 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(min(var(--i, 0), 12) * 45ms);
  }
  .photo-collection figure:nth-child(3n + 2) {
    padding-top: 4rem;
  }
  .photo-collection figure[hidden] {
    display: none;
  }
  .photo-open {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--surface-2);
    transition: transform 0.18s ease-out;
    transform-origin: center;
    outline-offset: 8px;
  }
  .photo-open img {
    width: 100%;
    height: auto;
  }
  .photo-collection:not(.filmstrip) .photo-open img {
    transition:
      opacity 0.6s ease,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .photo-collection:not(.filmstrip) .photo-open:hover img {
    transform: scale(1.035);
  }
  .open-hint {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    color: var(--fg);
    background: rgb(15 15 14 / 0.85);
    border: 1px solid var(--border);
    padding: 0.45rem 0.7rem;
    font: 700 0.75rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .photo-open:hover .open-hint,
  .photo-open:focus-visible .open-hint {
    opacity: 1;
    transform: none;
  }
  .strip-shell {
    --frame-width: min(64vw, 680px);
  }
  .filmstrip {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    padding: 2rem max(0px, calc((100% - var(--frame-width)) / 2)) 1.5rem;
    touch-action: pan-x pan-y;
    isolation: isolate;
  }
  .filmstrip figure,
  .filmstrip figure:nth-child(3n + 2) {
    padding-top: 0;
    flex: 0 0 var(--frame-width);
    scroll-snap-align: center;
    scroll-snap-stop: normal;
  }
  .filmstrip.wheel-browsing {
    scroll-snap-type: none;
  }
  .filmstrip .photo-open img {
    height: clamp(240px, 48svh, 520px);
    object-fit: contain;
  }
  .filmstrip .photo-open {
    background: transparent;
  }
  .filmstrip.depth-on .photo-open {
    transform: perspective(1300px) translateZ(var(--depth, 0px))
      rotateY(var(--rotation, 0deg));
    transition: transform 0.12s ease-out;
  }
  .gallery-controls {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    padding-top: 1.2rem;
  }
  .step-controls {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .step-controls .ph-tile {
    width: 44px;
    height: 44px;
    min-width: 0;
    padding: 0;
    align-items: center;
    font-size: 1.1rem;
  }
  .step-controls button:disabled {
    opacity: 0.35;
  }
  .step-controls span {
    font: 700 0.85rem var(--font-mono);
    color: var(--accent);
    min-width: 4rem;
    text-align: center;
  }
  .gallery-controls p {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0;
  }
  .depth-toggle:disabled {
    opacity: 0.5;
  }
  .gallery-end {
    padding-top: 4rem;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }
  @media (max-width: 700px) {
    .gallery-heading > div {
      display: block;
    }
    .gallery-heading > div > p {
      margin-top: 1.5rem;
    }
    .photo-collection {
      gap: 2rem 1rem;
    }
    .photo-collection figure:nth-child(3n + 2) {
      padding-top: 2rem;
    }
    .strip-shell {
      --frame-width: 80vw;
    }
    .filmstrip {
      gap: 1rem;
    }
    .filmstrip figure:nth-child(3n + 2) {
      padding-top: 0;
    }
    .gallery-controls {
      flex-wrap: wrap;
      gap: 1rem;
    }
    .gallery-controls p {
      order: 3;
      width: 100%;
    }
    .gallery-end {
      flex-wrap: wrap;
    }
    .album-summary {
      align-items: start;
    }
  }
  @media (max-width: 420px) {
    .photo-collection:not(.filmstrip) {
      grid-template-columns: 1fr;
    }
    .photo-collection figure:nth-child(3n + 2) {
      padding-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-open,
    .filmstrip.depth-on .photo-open {
      transform: none !important;
      transition: none;
    }
  }
</style>
