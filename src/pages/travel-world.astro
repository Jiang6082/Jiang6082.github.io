---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import { collections, singles } from "../data/photos";
import "../styles/labs.css";
import { destinations, photoDestinations } from "../data/travel";
const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const photos = [...collections.flatMap((c) => c.photos), ...singles].filter(
  (p) => p.src && files[`../photos/${p.src}`],
);
const items = await Promise.all(
  photos.map(async (p, i) => {
    const meta = files[`../photos/${p.src}`].default;
    const small = await getImage({
      src: meta,
      width: Math.min(360, meta.width),
      format: "webp",
    });
    const texture = await getImage({
      src: meta,
      width: Math.min(1400, meta.width),
      format: "webp",
    });
    const full = await getImage({
      src: meta,
      width: Math.min(2400, meta.width),
      format: "webp",
    });
    return {
      destinations: photoDestinations(p.src!),
      thumb: small.src,
      texture: texture.src,
      full: full.src,
      aspect: meta.width / meta.height,
      alt: p.alt || `Photograph ${i + 1} by Charles Jiang`,
    };
  }),
);
---

<BaseLayout
  title="Travel world"
  description="Explore a miniature island and Charles Jiang’s photographs."
  wide
>
  <div class="lab-shell world-shell">
    <header class="world-heading">
      <div>
        <a class="text-link" href="/photography">← Photography</a><h1>
          Travel world.
        </h1>
      </div><p>
        A small, imaginary island.<br />Choose a stop and look around.
      </p>
    </header>
    <div class="world-layout">
      <div>
        <div class="lab-stage" id="room-stage">
          <svg
            class="world-preview"
            viewBox="0 0 900 550"
            width="100%"
            height="100%"
            role="img"
            aria-label="Island map with a railway, airfield, coast, garden and streets"
          >
            <rect width="900" height="550" fill="#b7d1cf"></rect><ellipse
              cx="450"
              cy="300"
              rx="345"
              ry="190"
              fill="#e2cfaa"></ellipse><ellipse
              cx="450"
              cy="283"
              rx="325"
              ry="173"
              fill="#9daf86"></ellipse>
            <ellipse
              cx="450"
              cy="285"
              rx="284"
              ry="140"
              fill="none"
              stroke="#656a5b"
              stroke-width="8"></ellipse><ellipse
              cx="450"
              cy="285"
              rx="284"
              ry="140"
              fill="none"
              stroke="#e9e1cf"
              stroke-width="3"
              stroke-dasharray="2 8"></ellipse>
            <path
              d="M380 330h170M450 250v160"
              stroke="#777c71"
              stroke-width="24"></path><path
              d="M525 203h175"
              stroke="#737a74"
              stroke-width="40"></path><path
              d="M525 203h175"
              stroke="#f4f1e9"
              stroke-width="2"
              stroke-dasharray="14 12"></path>
            <g fill="#526f56"
              ><circle cx="302" cy="208" r="22"></circle><circle
                cx="349"
                cy="181"
                r="24"></circle><circle cx="390" cy="210" r="20"></circle></g
            >
            <g fill="#e9e3d3" stroke="#ae624c" stroke-width="8"
              ><path d="M390 275v-35h35v35Z"></path><path
                d="M481 306v-42h40v42Z"></path><path d="M481 388v-42h40v42Z"
              ></path></g
            >
            <rect x="181" y="270" width="65" height="30" rx="4" fill="#b43d28"
            ></rect><path d="M690 358l8 60h-16Z" fill="#f8f3e6"></path>
            <g font-family="Arial" font-size="17" fill="#252822"
              ><text x="172" y="329">Railway</text><text x="299" y="250"
                >Garden</text
              ><text x="556" y="258">Airfield</text><text x="373" y="429"
                >Streets</text
              ><text x="648" y="443">Coast</text></g
            >
          </svg>
          <button class="lab-start" id="start-room" hidden
            >Explore the island ↗</button
          >
        </div>
        <div class="lab-controls" data-world-live hidden>
          <button id="world-home">Whole island</button><button
            id="world-train"
            aria-pressed="false">Run the train</button
          ><button id="world-plane">Fly the plane</button><button
            id="world-left">Rotate left</button
          ><button id="world-right">Rotate right</button>
        </div>
        <p class="lab-status" id="room-status" role="status">
          Enter the island for 3D, or choose a stop below to browse photographs.
        </p>
      </div>
      <aside class="world-stops">
        <p class="eyebrow">Pick a stop</p><div class="stop-buttons">
          {
            destinations.map((d, i) => (
              <button data-stop={d.id} aria-pressed="false">
                <span>0{i + 1}</span>
                {d.name}
                <span aria-hidden="true">↗</span>
              </button>
            ))
          }
        </div><button class="all-photos" data-stop="all" aria-pressed="true"
          >All photographs</button
        ><p class="world-note">
          Drag to orbit. Visit a stop to see its photos in the world, then click
          a photo to open it. The train and plane move only when you start them.
        </p>
      </aside>
    </div>
    <section class="world-album" aria-labelledby="world-album-title">
      <div class="album-heading">
        <h2 id="world-album-title">All photographs</h2><span id="world-count"
          >{items.length} photographs</span
        >
      </div><p id="world-empty" hidden>
        No plane photographs yet. Take a flight around the island, or explore
        another stop.
      </p>
      <div class="world-photos">
        {
          items.map((p, i) => (
            <a
              href={p.full}
              data-photo={i}
              data-destinations={p.destinations.join(" ")}
              aria-label={"Open photograph " + (i + 1)}
            >
              <img
                src={p.thumb}
                alt={p.alt}
                width="360"
                height={Math.round(360 / p.aspect)}
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
    </section>
    <dialog id="room-dialog" aria-label="Photograph viewer">
      <button id="room-dismiss" autofocus>Close ×</button><img
        id="room-full"
        alt=""
      />
    </dialog>
    <script
      type="application/json"
      id="room-data"
      set:html={JSON.stringify(items).replace(/</g, "\\u003c")}
    />
  </div>
</BaseLayout>
<script>
  import { destinations } from "../data/travel";
  const start = document.querySelector<HTMLButtonElement>("#start-room")!,
    status = document.querySelector<HTMLElement>("#room-status")!;
  const photos = JSON.parse(document.querySelector("#room-data")!.textContent!);
  let world: { visit: (id: string) => void } | undefined;
  let selected = "all";
  const select = (id: string, fromScene = false) => {
    selected = id;
    document
      .querySelectorAll<HTMLElement>("[data-stop]")
      .forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.stop === id)),
      );
    let count = 0;
    document.querySelectorAll<HTMLElement>("[data-photo]").forEach((a) => {
      a.hidden =
        id !== "all" && !a.dataset.destinations!.split(" ").includes(id);
      if (!a.hidden) count++;
    });
    document.querySelector("#world-album-title")!.textContent =
      destinations.find((d) => d.id === id)?.name || "All photographs";
    document.querySelector("#world-count")!.textContent =
      count + " photographs";
    document.querySelector<HTMLElement>("#world-empty")!.hidden = count > 0;
    status.textContent =
      id === "all"
        ? "Photos mark the island’s destinations. Click a preview to visit its collection."
        : count === 0
          ? "No photographs at this stop yet. Explore another destination."
          : destinations.find((d) => d.id === id)?.name +
            ": " +
            count +
            (world
              ? " photographs in the scene. Click one to open it."
              : " photographs below.");
    if (!fromScene) world?.visit(id);
  };
  document
    .querySelectorAll<HTMLElement>("[data-stop]")
    .forEach((b) => b.addEventListener("click", () => select(b.dataset.stop!)));
  const dialog = document.querySelector<HTMLDialogElement>("#room-dialog")!,
    image = document.querySelector<HTMLImageElement>("#room-full")!;
  const openPhoto = (i: number) => {
    image.src = photos[i].full;
    image.alt = photos[i].alt;
    dialog.showModal();
  };
  document.querySelectorAll<HTMLAnchorElement>("[data-photo]").forEach((a, i) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      openPhoto(i);
    }),
  );
  document
    .querySelector("#room-dismiss")!
    .addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  start.hidden = false;
  start.addEventListener("click", async () => {
    start.disabled = true;
    status.textContent = "Building the island…";
    try {
      const { createTravelWorld } = await import("../scripts/travel-world");
      world = createTravelWorld(
        document.querySelector("#room-stage")!,
        (id) => select(id, true),
        photos,
        openPhoto,
      );
      start.hidden = true;
      document
        .querySelectorAll<HTMLElement>("[data-world-live]")
        .forEach((el) => (el.hidden = false));
      select(selected);
    } catch {
      start.disabled = false;
      status.textContent =
        "3D is unavailable in this browser. The destination buttons and photographs still work.";
    }
  });
</script>
<style>
  .world-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .world-heading h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin: 0.6rem 0 0;
  }
  .world-heading p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }
  .world-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: 2rem;
  }
  .lab-stage {
    height: clamp(400px, 65vh, 700px);
    border-radius: 3px;
  }
  .world-stops {
    padding-top: 1rem;
  }
  .stop-buttons {
    display: grid;
    gap: 0.5rem;
  }
  .stop-buttons button {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    text-align: left;
    border: 0;
    border-bottom: 1px solid var(--border);
    padding: 1rem 0.3rem;
  }
  .stop-buttons span:first-child {
    font: 0.7rem var(--font-mono);
    color: var(--muted);
  }
  .stop-buttons span:last-child {
    margin-left: auto;
  }
  .stop-buttons button[aria-pressed="true"],
  .all-photos[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .all-photos {
    margin-top: 1rem;
  }
  .world-note {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.8;
    margin-top: 2rem;
  }
  .world-album {
    margin: 2rem 0;
  }
  .album-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }
  .album-heading h2 {
    font-size: 1.5rem;
    font-weight: 500;
  }
  .album-heading span {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .world-photos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .world-photos img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    display: block;
  }
  .world-photos a:hover img {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  dialog {
    border: 0;
    padding: 3rem 1rem 1rem;
    background: var(--bg);
    max-width: 94vw;
    max-height: 94vh;
  }
  dialog::backdrop {
    background: #171a16e8;
  }
  dialog img {
    max-width: 88vw;
    max-height: 80vh;
    object-fit: contain;
    display: block;
  }
  dialog button {
    position: absolute;
    right: 0.5rem;
    top: 0.3rem;
  }
  @media (max-width: 850px) {
    .world-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .world-stops {
      padding: 0;
    }
    .stop-buttons {
      grid-template-columns: repeat(5, 1fr);
      gap: 0.5rem;
    }
    .stop-buttons button {
      font-size: 0.78rem;
      padding: 0.7rem 0.2rem;
    }
    .stop-buttons span {
      display: none;
    }
    .world-note {
      margin-top: 0.8rem;
    }
    .world-photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .world-heading p {
      display: none;
    }
    .lab-stage {
      height: 430px;
    }
  }
</style>
