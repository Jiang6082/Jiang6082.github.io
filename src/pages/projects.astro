---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { projects } from "../data/projects";
import { walkthroughs } from "../data/research";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const range = `01—${String(projects.length).padStart(2, "0")}`;
---

<BaseLayout
  title="Projects"
  description="Research tools, trading systems, and full-stack software by Charles Jiang."
  wide
>
  <div class="page-shell">
    <header class="work-heading">
      <p class="eyebrow">Selected work / {range}</p><h1>Projects</h1><p
        class="lede"
      >
        Research tools, trading systems, and full-stack software.
      </p>
    </header>
    <div class="work-layout">
      <aside>
        <p class="eyebrow">Project index</p><nav aria-label="Project index">
          {
            projects.map((p, i) => (
              <a href={`#${p.id}`}>
                <span>{String(i + 1).padStart(2, "0")}</span>
                {p.title}
              </a>
            ))
          }
        </nav>
      </aside>
      <div>
        {
          projects.map((p, i) => (
            <article id={p.id} class="project">
              <div class="project-meta eyebrow">
                <span>
                  {String(i + 1).padStart(2, "0")} / {p.language}
                </span>
                <span>
                  {p.visibility === "private"
                    ? "Private research"
                    : "Open source"}
                </span>
              </div>
              <h2>{p.title}</h2>
              <p class="description">{p.purpose}</p>
              <p class="result">{p.result}</p>
              <p class="result-context">{p.context}</p>
              <div class="project-actions">
                <details class="project-demo">
                  <summary>
                    {walkthroughs.find((w) => w.project === p.id)?.demo
                      ? "Try demo"
                      : "See results"}{" "}
                    <span aria-hidden="true">+</span>
                  </summary>
                  <ProjectVisual project={p.id} />
                </details>
                {p.slug && (
                  <a class="text-link" href={`${base}/projects/${p.slug}`}>
                    Read walkthrough <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
              <div class="project-bottom">
                <p class="topics">{p.topics.join(" / ")}</p>
                {p.visibility === "public" && p.repo ? (
                  <a
                    class="text-link"
                    href={p.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Explore the code <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="private-note">Private repository</span>
                )}
                {p.demo && (
                  <a class="text-link" href={p.demo}>
                    View project <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .work-heading {
    padding: 1rem 0 5rem;
  }
  .work-heading h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 2rem 0;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--muted);
  }
  .work-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 5rem;
  }
  .work-layout aside {
    position: sticky;
    top: 3rem;
    align-self: start;
  }
  aside nav {
    display: flex;
    flex-direction: column;
  }
  aside a {
    display: flex;
    gap: 1.2rem;
    padding: 0.7rem 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  aside a span {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.8rem;
  }
  .project {
    border-top: 1px solid var(--border);
    padding: 2rem 0 3rem;
    scroll-margin-top: 2rem;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .project h2 {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 400;
    margin: 1rem 0;
    overflow-wrap: anywhere;
  }
  .description {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 44rem;
  }
  .result {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.3rem;
  }
  .result-context {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 43rem;
  }
  .project-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 0 1.5rem;
  }
  .project-actions > a {
    grid-area: 1 / 1;
    justify-self: end;
    align-self: start;
    position: relative;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .project-demo {
    grid-area: 1 / 1;
    min-width: 0;
  }
  .project-demo summary {
    width: max-content;
    cursor: pointer;
    list-style: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
  }
  .project-demo summary::-webkit-details-marker {
    display: none;
  }
  .project-demo[open] summary span {
    transform: rotate(45deg);
  }
  .project-demo :global(.project-visual) {
    min-width: 0;
  }
  .project-bottom {
    margin-top: 1.5rem;
  }
  .project-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .topics {
    font: 0.8125rem/1.8 var(--font-mono);
    max-width: 25rem;
    color: var(--muted);
    margin: 0;
  }
  .private-note {
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .work-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .work-layout aside {
      position: static;
    }
    .work-heading {
      padding-bottom: 2rem;
    }
    aside nav {
      flex-direction: row;
      gap: 0.3rem 1.2rem;
      flex-wrap: wrap;
    }
    .project {
      padding-bottom: 3rem;
    }
  }
</style>
