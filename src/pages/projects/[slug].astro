---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { walkthroughs } from "../../data/walkthroughs";
export function getStaticPaths() {
  return walkthroughs.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={p.title} description={p.intro}>
  <article class="walkthrough">
    <a class="text-link" href={`${base}/projects#${p.project}`}
      >← All projects</a
    >
    <header>
      <p class="eyebrow">Project walkthrough</p><h1>{p.title}</h1><p
        class="intro"
      >
        {p.intro}
      </p>
    </header>
    <section><h2>The problem</h2><p>{p.problem}</p></section>
    <section><h2>What I built</h2><p>{p.built}</p></section>
    <figure>
      {
        p.image ? (
          <a href={`${base}${p.image}`}>
            <img src={`${base}${p.image}`} alt={p.imageAlt} loading="lazy" />
          </a>
        ) : (
          <div class="artifact">
            <code>{p.artifact}</code>
          </div>
        )
      }<figcaption>{p.artifactLabel}</figcaption>
    </figure>
    <section>
      <h2>How it works</h2><ol>
        {
          p.steps.map(([title, text]) => (
            <li>
              <>
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </li>
          ))
        }
      </ol>
    </section>
    <section><h2>The part that mattered</h2><p>{p.detail}</p></section>
    <section>
      <h2>Where it stands</h2><p>{p.result}</p>{
        p.evidence && (
          <a class="text-link" href={p.evidence}>
            View the recorded results ↗
          </a>
        )
      }
    </section>
    <footer>
      <a class="text-link" href={p.source}>Explore the repository ↗</a><a
        class="text-link"
        href={`${base}/projects`}>Back to projects</a>
    </footer>
  </article>
</BaseLayout>
<style>
  .walkthrough {
    padding: 1rem 0 4rem;
  }
  header {
    padding: 3rem 0 2rem;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 1rem 0;
  }
  .intro {
    font-size: 1.3rem;
    color: var(--muted);
  }
  section {
    margin: 2.7rem 0;
  }
  h2 {
    font-size: 1.4rem;
    font-weight: 500;
  }
  p {
    line-height: 1.8;
  }
  figure {
    margin: 3rem 0;
  }
  img {
    width: 100%;
    height: auto;
    background: white;
  }
  .artifact {
    padding: 3rem 2rem;
    background: var(--surface-2);
    overflow-wrap: anywhere;
  }
  code {
    font: 1rem/1.8 var(--font-mono);
  }
  figcaption {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 1rem;
  }
  ol {
    padding-left: 1.5rem;
  }
  li {
    padding-left: 0.8rem;
    margin: 1.6rem 0;
  }
  li::marker {
    color: var(--accent);
  }
  h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  li p {
    margin-top: 0;
    color: var(--muted);
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
