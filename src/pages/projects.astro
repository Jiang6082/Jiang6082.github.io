---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectDiagram from "../components/ProjectDiagram.astro";
import { GITHUB } from "../config";
import { projects, type Project } from "../data/projects";

const codeLink = (p: Project) =>
  p.visibility === "public" && p.repo ? p.repo : null;
const pad = (n: number) => String(n).padStart(2, "0");
const kindOf = (name: string) =>
  ({
    "project-emberforge": "distribution",
    "project-geld": "candles",
    "market-volatility-forecasting": "volatility",
    "Project-Olsen": "options",
    QJS: "scan",
  })[name] ?? "distribution";

const N = projects.length;
---

<BaseLayout title="Projects" description="Selected work." wide>
  <div class="pscroll" style={`height:${(N + 1) * 100}vh`}>
    <div class="pstage" id="pstage">
      <div class="pbg" aria-hidden="true">WORK</div>

      <div class="pmeta">
        <span class="eyebrow">SELECTED WORK</span>
        <span class="pcount"><span class="cur">01</span> / {pad(N)}</span>
      </div>

      {
        projects.map((p, i) => {
          const href = codeLink(p);
          return (
            <article class="pcard" data-i={i}>
              <div class="pcard-visual">
                <ProjectDiagram kind={kindOf(p.name)} />
              </div>
              <div class="pcard-info">
                <span class="pcard-idx">{pad(i + 1)}</span>
                <h2 class="pcard-name">{p.name}</h2>
                <p class="pcard-desc">{p.description}</p>
                {p.topics && p.topics.length > 0 && (
                  <div class="pcard-tags">
                    {p.topics.slice(0, 5).map((t) => (
                      <span class="pcard-tag">{t}</span>
                    ))}
                  </div>
                )}
                {href ? (
                  <a class="pcard-link" href={href} target="_blank" rel="noopener">
                    View code ↗
                  </a>
                ) : (
                  <span class="pcard-priv">Private repository</span>
                )}
              </div>
            </article>
          );
        })
      }

      <span class="phint" aria-hidden="true">scroll ↓</span>
    </div>
  </div>

  <p class="pmore muted small">
    More on
    <a href={`https://github.com/${GITHUB.username}`} target="_blank" rel="noopener">GitHub</a>.
  </p>
</BaseLayout>

<script>
  const track = document.querySelector<HTMLElement>(".pscroll");
  const stage = document.getElementById("pstage");
  if (track && stage) {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>(".pcard"));
    const counter = stage.querySelector<HTMLElement>(".pcount .cur");
    const N = cards.length;
    let ticking = false;

    const update = () => {
      ticking = false;
      const scrollable = track.offsetHeight - window.innerHeight;
      const scrolled = Math.min(Math.max(-track.getBoundingClientRect().top, 0), scrollable);
      const progress = scrollable > 0 ? scrolled / scrollable : 0;
      const pos = progress * N - 0.5; // -0.5 .. N-0.5

      // Alternate projects between a top and bottom row. Because consecutive
      // projects sit in opposite rows AND are offset along the scroll, the two
      // on screen at once always appear diagonally — never in the same column.
      const jitter = [0, -4, 3, -2, 5];
      cards.forEach((card, i) => {
        const local = pos - i; // <0 = incoming (right); >0 = outgoing (left)
        const a = Math.abs(local);
        const x = -local * 60; // vw: right → centre → left
        const ty = (i % 2 === 0 ? -19 : 19) + jitter[i % jitter.length]; // vh: two rows
        const ry = local * 26; // deg: arc around the viewer
        const s = 1 - Math.min(a, 1) * 0.16;
        const tz = -Math.min(a, 1) * 300;
        const op = a < 0.35 ? 1 : Math.max(0, 1 - (a - 0.35) / 0.5);
        card.style.opacity = String(op);
        card.style.transform = `translate(-50%, -50%) translateX(${x}vw) translateY(${ty}vh) translateZ(${tz}px) rotateY(${ry}deg) scale(${s})`;
        card.style.zIndex = String(100 - Math.round(a * 20));
        card.style.pointerEvents = op > 0.75 ? "auto" : "none";
      });

      if (counter) {
        const active = Math.round(Math.min(Math.max(pos, 0), N - 1));
        counter.textContent = String(active + 1).padStart(2, "0");
      }
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", update);
    update();
  }
</script>

<style>
  .pscroll {
    position: relative;
  }
  .pstage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    perspective: 1600px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Giant faint backdrop word */
  .pbg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 40vw;
    letter-spacing: -0.04em;
    color: var(--fg);
    opacity: 0.035;
    user-select: none;
    pointer-events: none;
  }

  .pmeta {
    position: absolute;
    top: 1.25rem;
    left: 0;
    right: 0;
    padding: 0 clamp(1rem, 4vw, 3rem);
    display: flex;
    justify-content: space-between;
    z-index: 200;
  }
  .eyebrow,
  .pcount {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .pcount .cur {
    color: var(--accent);
  }

  /* ── Flying project cards ─────────────────────────────────────── */
  .pcard {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(88vw, 44rem);
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.45);
    opacity: 0;
    will-change: transform, opacity;
  }
  .pcard-visual {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.4rem;
    display: flex;
    align-items: center;
  }
  .pcard-idx {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .pcard-name {
    margin: 0.25rem 0 0.6rem;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .pcard-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .pcard-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .pcard-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
  }
  .pcard-link {
    display: inline-block;
    margin-top: 1.1rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .pcard-priv {
    display: inline-block;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .phint {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--muted);
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translate(-50%, 5px);
    }
  }

  .pmore {
    text-align: center;
    padding: 2rem 0 3rem;
  }

  @media (max-width: 640px) {
    .pcard {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.25rem;
    }
  }

  /* No-JS / reduced-motion fallback: simple stacked list */
  :global(html.no-js) .pscroll {
    height: auto !important;
  }
  :global(html.no-js) .pstage {
    position: static;
    height: auto;
    display: block;
    perspective: none;
    padding: 2rem 1rem;
  }
  :global(html.no-js) .pcard {
    position: relative;
    left: auto;
    top: auto;
    transform: none !important;
    opacity: 1 !important;
    margin: 0 auto 1.5rem;
  }
  :global(html.no-js) .pbg,
  :global(html.no-js) .phint {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .phint {
      animation: none;
    }
  }
</style>
