---
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { collections, singles, type Photo } from "../data/photos";
import { getImage } from "astro:assets";

const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;

async function toItem(p: Photo) {
  const mod = p.src ? files[`../photos/${p.src}`] : undefined;
  if (!mod) return null;
  const meta = mod.default;
  const thumb = await getImage({ src: meta, width: Math.min(1100, meta.width), format: "webp" });
  const full = await getImage({ src: meta, width: Math.min(2400, meta.width), format: "webp" });
  return {
    title: p.title ?? "",
    caption: p.caption ?? "",
    alt: p.alt || p.title || "Photo",
    placeholder: false,
    ar: meta.width / meta.height,
    thumb: thumb.src,
    full: full.src,
  };
}

const all: Photo[] = [...collections.flatMap((c) => c.photos), ...singles];
const items = (await Promise.all(all.map(toItem))).filter(Boolean) as NonNullable<
  Awaited<ReturnType<typeof toItem>>
>[];

// Keep the original index (for the lightbox) while splitting into two rows.
const indexed = items.map((it, i) => ({ ...it, idx: i }));
const top = indexed.filter((_, i) => i % 2 === 0);
const bottom = indexed.filter((_, i) => i % 2 === 1);

// Deterministic scatter so a row reads as loose/individual, not a rigid line.
const ty = (i: number) => [26, -34, 14, -20, 40, -10, 30, -26][i % 8];
const rot = (i: number) => [-3.5, 2, -1.5, 3, -2.5, 1.5, -2, 2.5][i % 8];
---

<BaseLayout title="Photography" description="A few frames I'm fond of." wide>
  <div class="lab-head">
    <h1>Photography</h1>
    <p class="muted lede">
      Two rows of photos drifting by. <strong>Hover</strong> a row to pause it,
      <strong>click</strong> a photo to open it (scroll to zoom, drag to pan,
      ← / → to move). Prefer a plain grid?
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/photography-classic`}>Classic view</a>.
    </p>
  </div>

  <div class="rows">
    <div class="rowwrap">
      <div class="marquee" style="--speed:78s">
        {
          [...top, ...top].map((it, i) => (
            <button
              class="m-item"
              data-group="lab"
              data-index={it.idx}
              style={`--ty:${ty(i)}px;--rot:${rot(i)}deg;width:clamp(13rem,22vw,18rem);aspect-ratio:${it.ar.toFixed(3)}`}
              aria-label={it.title || "Open photo"}
              aria-hidden={i >= top.length ? "true" : undefined}
              tabindex={i >= top.length ? -1 : undefined}
            >
              <img src={it.thumb} alt={it.alt} loading="lazy" draggable="false" />
            </button>
          ))
        }
      </div>
    </div>

    <div class="rowwrap">
      <div class="marquee rev" style="--speed:92s">
        {
          [...bottom, ...bottom].map((it, i) => (
            <button
              class="m-item"
              data-group="lab"
              data-index={it.idx}
              style={`--ty:${ty(i + 3)}px;--rot:${rot(i + 2)}deg;width:clamp(13rem,22vw,18rem);aspect-ratio:${it.ar.toFixed(3)}`}
              aria-label={it.title || "Open photo"}
              aria-hidden={i >= bottom.length ? "true" : undefined}
              tabindex={i >= bottom.length ? -1 : undefined}
            >
              <img src={it.thumb} alt={it.alt} loading="lazy" draggable="false" />
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <script
    is:inline
    set:html={`window.__GALLERY__ = [${JSON.stringify({
      key: "lab",
      title: "Photos",
      items: items.map((it) => ({
        title: it.title,
        caption: it.caption,
        alt: it.alt,
        placeholder: it.placeholder,
        thumb: it.thumb,
        full: it.full,
      })),
    })}];`}
  />

  <Lightbox />
</BaseLayout>

<style>
  .lab-head {
    max-width: var(--max-width-wide);
    margin: 0 auto 1.5rem;
    padding: 0 1.5rem;
  }
  .lab-head h1 {
    margin: 0.5rem 0 0.4rem;
  }
  .lede {
    max-width: 44rem;
    margin: 0;
  }
  .lede strong {
    color: var(--fg);
    font-weight: 600;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    padding: 1.5rem 0 3rem;
  }
  .rowwrap {
    overflow: hidden;
  }
  .marquee {
    display: flex;
    gap: 3rem;
    width: max-content;
    padding: 2.5rem 0.8rem;
    align-items: center;
    animation: scroll var(--speed, 50s) linear infinite;
  }
  .marquee.rev {
    animation-direction: reverse;
  }
  .marquee:hover {
    animation-play-state: paused;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .m-item {
    flex: 0 0 auto;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    transform: translateY(var(--ty, 0)) rotate(var(--rot, 0deg));
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease;
  }
  .m-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.88) saturate(0.95);
    transition: filter 0.3s ease;
  }
  .m-item:hover {
    transform: translateY(calc(var(--ty, 0px) - 14px)) rotate(0deg) scale(1.06);
    box-shadow: 0 34px 70px rgba(0, 0, 0, 0.6);
    z-index: 3;
  }
  .m-item:hover img {
    filter: brightness(1.08) saturate(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    /* Stop the drift, but keep every photo reachable: the row becomes a
       normal horizontal scroller instead of hiding its overflow. */
    .marquee {
      animation: none;
    }
    .rowwrap {
      overflow-x: auto;
      scrollbar-width: thin;
    }
    .m-item {
      transform: none;
    }
  }
</style>
