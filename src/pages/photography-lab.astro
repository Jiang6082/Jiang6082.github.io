---
import BaseLayout from "../layouts/BaseLayout.astro";
import { collections, singles, type Photo } from "../data/photos";
import { getImage } from "astro:assets";

const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;

async function toItem(p: Photo) {
  const mod = p.src ? files[`../photos/${p.src}`] : undefined;
  if (!mod) return null;
  const meta = mod.default;
  const thumb = await getImage({ src: meta, width: Math.min(1000, meta.width), format: "webp" });
  return {
    title: p.title ?? "",
    alt: p.alt || p.title || "Photo",
    src: thumb.src,
    ar: meta.width / meta.height,
  };
}

// Same photos as the main gallery, flattened into one spatial wall.
const all: Photo[] = [...collections.flatMap((c) => c.photos), ...singles];
const items = (await Promise.all(all.map(toItem))).filter(Boolean) as NonNullable<
  Awaited<ReturnType<typeof toItem>>
>[];

// Deterministic per-tile depth so the wall has real dimensionality.
const depths = [-90, 40, -30, 110, -60, 70, 0, -120, 50, 20, -70, 90, 10, -40, 130];
const dz = (i: number) => depths[i % depths.length];
---

<BaseLayout title="Photography · Lab" description="An experimental 3D view of the gallery." wide>
  <div class="lab-head">
    <span class="eyebrow">EXPERIMENT</span>
    <h1>Gallery, in space</h1>
    <p class="muted lede">
      A prototype 3D view of the same photos. Move your cursor — the wall tilts,
      and the frames float at different depths. (The
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/photography`}>standard gallery</a>
      is still the main one.)
    </p>
  </div>

  <div class="scene" id="scene">
    <div class="stage" id="stage">
      {
        items.map((it, i) => (
          <figure class="tile" style={`--z:${dz(i)}px; aspect-ratio:${it.ar.toFixed(3)}`}>
            <img src={it.src} alt={it.alt} loading="lazy" draggable="false" />
            {it.title && <figcaption>{it.title}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const scene = document.getElementById("scene");
  const stage = document.getElementById("stage");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canHover = window.matchMedia("(hover: hover)").matches;

  if (scene && stage && !reduce && canHover) {
    let raf = 0;
    let tx = 0,
      ty = 0;
    const apply = () => {
      raf = 0;
      stage.style.transform = `rotateX(${ty}deg) rotateY(${tx}deg)`;
    };
    scene.addEventListener("pointermove", (e) => {
      const r = scene.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 14;
      ty = -((e.clientY - r.top) / r.height - 0.5) * 12;
      if (!raf) raf = requestAnimationFrame(apply);
    });
    scene.addEventListener("pointerleave", () => {
      stage.style.transform = "";
    });
  }
</script>

<style>
  .lab-head {
    max-width: var(--max-width-wide);
    margin: 0 auto 2rem;
    padding: 0 1.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .lab-head h1 {
    margin: 0.5rem 0 0.4rem;
  }
  .lede {
    max-width: 42rem;
    margin: 0;
  }

  .scene {
    perspective: 1500px;
    perspective-origin: 50% 40%;
    padding: 2rem 1.5rem 6rem;
    overflow: visible;
  }
  .stage {
    max-width: 84rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.75rem;
    transform-style: preserve-3d;
    transition: transform 0.2s ease-out;
    will-change: transform;
  }
  .tile {
    margin: 0;
    position: relative;
    transform-style: preserve-3d;
    transform: translateZ(var(--z, 0));
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
    cursor: pointer;
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tile:hover {
    transform: translateZ(calc(var(--z, 0px) + 80px)) scale(1.02);
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
    z-index: 2;
  }
  .tile figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.4rem 0.7rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .tile:hover figcaption {
    opacity: 1;
  }

  @media (hover: none) {
    .stage {
      transform: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage,
    .tile {
      transition: none;
    }
  }
</style>
