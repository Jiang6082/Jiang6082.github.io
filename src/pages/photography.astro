---
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { collections, singles } from "../data/photos";
import { getImage } from "astro:assets";
const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const all = [...collections.flatMap((c) => c.photos), ...singles];
const items = (
  await Promise.all(
    all.map(async (p, i) => {
      const meta = p.src ? files[`../photos/${p.src}`]?.default : undefined;
      if (!meta) return null;
      const thumb = await getImage({
        src: meta,
        width: Math.min(1100, meta.width),
        format: "webp",
      });
      const full = await getImage({
        src: meta,
        width: Math.min(2400, meta.width),
        format: "webp",
      });
      return {
        title: p.title || "",
        caption: p.caption || "",
        alt: p.alt || p.title || `Photograph ${i + 1} by Charles Jiang`,
        placeholder: false,
        thumb: thumb.src,
        full: full.src,
        width: meta.width,
        height: meta.height,
      };
    }),
  )
).filter(Boolean) as {
  title: string;
  caption: string;
  alt: string;
  placeholder: boolean;
  thumb: string;
  full: string;
  width: number;
  height: number;
}[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Photography"
  description="A personal collection of photographs by Charles Jiang."
  wide
>
  <header class="gallery-heading page-shell">
    <p class="eyebrow">
      Away from the screen / {String(items.length).padStart(2, "0")} frames
    </p><div>
      <h1>Photography</h1><p>
        Travel, light, and the things<br />I wanted to remember.
      </p>
    </div>
  </header>
  <div class="gallery-toolbar page-shell">
    <span class="eyebrow">The photo collection</span><div
      class="view-switch"
      hidden
    >
      <button type="button" data-view="sheet" aria-pressed="true"
        >Contact sheet</button
      ><button type="button" data-view="strip" aria-pressed="false"
        >Filmstrip ↔</button
      >
    </div><a class="classic" href={`${base}/photography-classic`}
      >Classic view ↗</a
    >
  </div>
  <section class="photo-collection page-shell" aria-label="Photographs">
    {
      items.map((it, i) => (
        <figure>
          <>
            <a
              href={it.full}
              class="photo-open"
              data-group="photographs"
              data-index={i}
              aria-label={`Open photograph ${i + 1}${it.title ? `: ${it.title}` : ""}`}
            >
              <>
                <img
                  src={it.thumb}
                  alt={it.alt}
                  width={it.width}
                  height={it.height}
                  loading={i < 2 ? "eager" : "lazy"}
                />
                <span class="open-hint" aria-hidden="true">
                  View photograph ↗
                </span>
              </>
            </a>
            <figcaption>
              <>
                <span>{String(i + 1).padStart(2, "0")}</span>
                <span>{it.title || "From my camera roll"}</span>
              </>
            </figcaption>
          </>
        </figure>
      ))
    }
  </section>
  <p class="gallery-end page-shell">
    That’s the collection, for now. <a
      href={`mailto:${"leung.jor@northeastern.edu"}`}>Say hello ↗</a
    >
  </p>
  <script
    is:inline
    set:html={`window.__GALLERY__ = ${JSON.stringify([{ key: "photographs", title: "Photographs", items }]).replace(/</g, "\\u003c")};`}
  /><Lightbox />
</BaseLayout>
<script>
  const controls = document.querySelector<HTMLElement>(".view-switch");
  const collection = document.querySelector<HTMLElement>(".photo-collection");
  if (controls && collection) {
    controls.hidden = false;
    controls.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
      button.addEventListener("click", () => {
        collection.classList.toggle(
          "filmstrip",
          button.dataset.view === "strip",
        );
        controls
          .querySelectorAll("button")
          .forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      }),
    );
  }
</script>
<style>
  .gallery-heading {
    padding: 1rem 0 4rem;
  }
  .gallery-heading > div {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
  }
  .gallery-heading h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin: 1.8rem 0 0;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .gallery-heading > div > p {
    font-size: 1.15rem;
    color: var(--muted);
  }
  .gallery-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding: 1.2rem 0;
  }
  .view-switch {
    display: flex;
    gap: 1rem;
  }
  .view-switch[hidden] {
    display: none;
  }
  .view-switch button {
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0.6rem 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .view-switch button[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
  }
  .classic {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .photo-collection {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem 3rem;
    padding-top: 2rem;
  }
  .photo-collection figure {
    margin: 0;
    min-width: 0;
  }
  .photo-collection figure:nth-child(3n + 2) {
    padding-top: 6rem;
  }
  .photo-open {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--surface-2);
  }
  .photo-open img {
    width: 100%;
    height: auto;
    transition: transform 0.6s;
  }
  .photo-open:hover img {
    transform: scale(1.025);
  }
  .open-hint {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    color: white;
    background: #222c;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .photo-open:hover .open-hint,
  .photo-open:focus-visible .open-hint {
    opacity: 1;
  }
  figcaption {
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    color: var(--muted);
    font: 0.8125rem/1.5 var(--font-mono);
    padding-top: 0.8rem;
  }
  .filmstrip {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 2rem;
  }
  .filmstrip figure,
  .filmstrip figure:nth-child(3n + 2) {
    padding-top: 0;
    flex: 0 0 min(70vw, 800px);
    scroll-snap-align: start;
  }
  .filmstrip .photo-open img {
    height: 60svh;
    object-fit: contain;
  }
  .gallery-end {
    padding-top: 5rem;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }
  @media (max-width: 700px) {
    .gallery-heading > div {
      display: block;
    }
    .gallery-heading > div > p {
      margin-top: 1.5rem;
    }
    .photo-collection {
      gap: 2rem 1rem;
    }
    .photo-collection figure:nth-child(3n + 2) {
      padding-top: 2rem;
    }
    figcaption {
      font-size: 0.75rem;
      gap: 0.5rem;
    }
    figcaption span:last-child {
      display: none;
    }
    .gallery-toolbar > .eyebrow {
      width: 100%;
    }
    .gallery-end {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 420px) {
    .photo-collection:not(.filmstrip) {
      grid-template-columns: 1fr;
    }
    .photo-collection figure:nth-child(3n + 2) {
      padding-top: 0;
    }
  }
</style>
