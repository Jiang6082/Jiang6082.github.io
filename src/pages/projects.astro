---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB } from "../config";
import { projects, type Project } from "../data/projects";
import { langColor } from "../lib/colors";

const codeLink = (p: Project) =>
  p.visibility === "public" && p.repo ? p.repo : null;
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout title="Projects" description="Selected work." wide>
  <div class="proj">
    <header class="work-head">
      <span class="eyebrow">SELECTED WORK</span>
      <h1>Projects</h1>
      <p class="muted lede">
        Mostly quantitative finance, research, and automation.
      </p>
    </header>

    <ul class="work-list">
      {
        projects.map((p, i) => {
          const href = codeLink(p);
          return (
            <li>
              <a
                class:list={["work-row", { islink: !!href }]}
                href={href ?? undefined}
                target={href ? "_blank" : undefined}
                rel={href ? "noopener" : undefined}
                aria-disabled={href ? undefined : "true"}
                style={`--accent-line:${langColor(p.language)}`}
              >
                <span class="w-idx">{pad(i + 1)}</span>
                <div class="w-main">
                  <div class="w-head">
                    <span class="w-name">{p.name}</span>
                    <span class="w-meta">
                      {p.language}
                      {p.visibility === "private" ? " · private" : ""}
                      <span class="w-arrow" aria-hidden="true">{href ? " ↗" : ""}</span>
                    </span>
                  </div>
                  {p.description && <p class="w-desc">{p.description}</p>}
                  {p.topics && p.topics.length > 0 && (
                    <div class="w-tags">
                      {p.topics.slice(0, 6).map((t) => (
                        <span class="w-tag">{t}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="more muted small">
      More on
      <a href={`https://github.com/${GITHUB.username}`} target="_blank" rel="noopener">GitHub</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .proj {
    width: 100%;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .work-head {
    margin-bottom: 2.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .work-head h1 {
    margin: 0.5rem 0 0.4rem;
  }
  .lede {
    max-width: 40rem;
    margin: 0;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .work-row {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.5rem;
    padding: 1.6rem 0.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--fg);
    position: relative;
    transition: padding 0.28s cubic-bezier(0.22, 1, 0.36, 1), background 0.28s ease;
  }
  /* Accent bar that grows on hover (uses the project's language color). */
  .work-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent-line, var(--accent));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  a.work-row:hover {
    text-decoration: none;
  }
  .work-row[aria-disabled] {
    cursor: default;
  }
  .w-idx {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    padding-top: 0.4rem;
  }
  .w-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .w-name {
    font-size: clamp(1.4rem, 3.2vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: color 0.2s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .w-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .w-desc {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.6;
    max-width: 46rem;
  }
  .w-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }
  .w-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
  }

  @media (hover: hover) {
    .work-row:hover {
      padding-left: 1.35rem;
      background: var(--surface-2);
    }
    .work-row:hover::before {
      transform: scaleY(1);
    }
    .work-row.islink:hover .w-name {
      color: var(--accent);
    }
    .work-row.islink:hover .w-tag {
      border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
      color: var(--accent);
    }
  }

  .more {
    margin-top: 2.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .work-row,
    .work-row::before,
    .w-name {
      transition: none;
    }
  }
</style>
