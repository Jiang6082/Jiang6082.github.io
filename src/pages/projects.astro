---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { GITHUB } from "../config";
import { projects, languageBreakdown, type Project } from "../data/projects";
import { langColor } from "../lib/colors";

const breakdown = languageBreakdown(projects);
const total = projects.length;

const codeLink = (p: Project) =>
  p.visibility === "public" && p.repo ? p.repo : null;
---

<BaseLayout title="Projects" description="A few things I've built.">
  <h1>Projects</h1>
  <p class="muted">
    A few things I've been building — mostly around quantitative finance and
    automation.
  </p>

  {
    breakdown.length > 0 && (
      <section class="langs" aria-label="Language distribution">
        <div class="bar">
          {breakdown.map((b) => (
            <span
              class="seg"
              style={`width:${(b.count / total) * 100}%;background:${langColor(b.lang)}`}
              title={`${b.lang}: ${b.count}`}
            />
          ))}
        </div>
        <ul class="legend">
          {breakdown.map((b) => (
            <li>
              <span class="dot" style={`background:${langColor(b.lang)}`} />
              {b.lang} <span class="muted">{b.count}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="grid">
    {
      projects.map((p) => {
        const href = codeLink(p);
        return (
          <article class="card">
            <div class="card-head">
              {href ? (
                <a class="repo-name" href={href} target="_blank" rel="noopener">
                  <Icon name="github" size={16} />
                  {p.name}
                </a>
              ) : (
                <span class="repo-name">
                  <Icon name="github" size={16} />
                  {p.name}
                </span>
              )}
              <span class:list={["badge", p.visibility]}>{p.visibility}</span>
            </div>

            {p.description && <p class="desc">{p.description}</p>}

            {p.topics && p.topics.length > 0 && (
              <div class="topics">
                {p.topics.slice(0, 6).map((t) => (
                  <span class="topic">{t}</span>
                ))}
              </div>
            )}

            <div class="foot">
              {p.language && (
                <span class="lang">
                  <span class="dot" style={`background:${langColor(p.language)}`} />
                  {p.language}
                </span>
              )}
              <span class="links">
                {href && (
                  <a href={href} target="_blank" rel="noopener">
                    Code →
                  </a>
                )}
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener">
                    Live demo →
                  </a>
                )}
              </span>
            </div>
          </article>
        );
      })
    }
  </div>

  <p class="more muted small">
    More on <a href={`https://github.com/${GITHUB.username}`} target="_blank" rel="noopener">GitHub</a>.
  </p>
</BaseLayout>

<style>
  /* Language distribution */
  .langs {
    margin: 1.75rem 0 2.25rem;
  }
  .bar {
    display: flex;
    height: 12px;
    border-radius: 999px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .seg {
    height: 100%;
    min-width: 3px;
  }
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    padding: 0;
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
  }

  /* Cards */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.15rem 1.25rem;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow-hover);
  }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .repo-name {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 650;
    font-size: 1.05rem;
    color: var(--fg);
    word-break: break-word;
  }
  a.repo-name:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .badge {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .badge.public {
    color: #16a34a;
    border-color: color-mix(in srgb, #16a34a 45%, var(--border));
    background: color-mix(in srgb, #16a34a 10%, transparent);
  }
  .desc {
    margin: 0.6rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
    flex: 1;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.7rem;
  }
  .topic {
    font-size: 0.72rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.08rem 0.5rem;
    border-radius: 999px;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.95rem;
    font-size: 0.85rem;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--fg);
  }
  .links {
    display: inline-flex;
    gap: 1rem;
    font-weight: 500;
  }
  .more {
    margin-top: 2rem;
  }
</style>
