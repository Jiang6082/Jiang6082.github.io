---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<BaseLayout title="Blog" description="Writing and notes.">
  <h1>Blog</h1>
  <p class="muted">Thoughts, notes, and things I'm working on.</p>

  {posts.length === 0 && <p class="muted">No posts yet — check back soon.</p>}

  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="card">
          <a class="card-link" href={`${base}/blog/${post.id}`}>
            <time class="muted small" datetime={post.data.date.toISOString()}>
              {fmt(post.data.date)}
            </time>
            <span class="title">{post.data.title}</span>
            {post.data.description && <p class="muted excerpt">{post.data.description}</p>}
            {post.data.tags.length > 0 && (
              <span class="tags">
                {post.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform 0.15s ease, border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow-hover);
  }
  .card-link {
    display: block;
    padding: 1.25rem 1.4rem;
    color: inherit;
  }
  .card-link:hover {
    text-decoration: none;
  }
  .title {
    display: block;
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin-top: 0.2rem;
  }
  .card:hover .title {
    color: var(--accent);
  }
  .excerpt {
    margin: 0.4rem 0 0;
  }
  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
  }
</style>
