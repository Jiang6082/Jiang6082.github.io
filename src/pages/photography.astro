---
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import PhotoHeader from "../components/PhotoHeader.astro";
import PhotoTabs from "../components/PhotoTabs.astro";
import DarkroomMotion from "../components/DarkroomMotion.astro";
import { collections, singles } from "../data/photos";
import { detailsFor, settingsLine } from "../data/photo-details";
import { getImage } from "astro:assets";
import "@fontsource/b612-mono/400.css";
import "@fontsource/b612-mono/700.css";
import "../styles/darkroom.css";

// Every image under src/photos, so Astro can optimize it and read its size.
const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;

const albums = [
  ...collections,
  ...(singles.length
    ? [{ id: "singles", title: "Other photographs", description: "", photos: singles }]
    : []),
];

// Keep extreme panoramas and tall portraits from wrecking a row.
const clampAr = (ar: number) => Math.max(0.5, Math.min(ar, 2.6));

const sections = await Promise.all(
  albums.map(async (album) => {
    const items = await Promise.all(
      album.photos.map(async (p) => {
        const meta = p.src ? files[`../photos/${p.src}`]?.default : undefined;
        if (!meta) return null;
        const thumbWidth = Math.min(900, meta.width);
        const [thumb, full] = await Promise.all([
          getImage({
            src: meta,
            width: thumbWidth,
            widths: [400, 650, 900].filter((w) => w <= thumbWidth),
            format: "webp",
          }),
          // Full size for the viewer, never upscaled past the original.
          getImage({ src: meta, width: Math.min(2400, meta.width), format: "webp" }),
        ]);
        const details = detailsFor(p.src);
        return {
          title: p.title || "",
          alt: p.alt || p.title || "Photograph by Charles Jiang",
          place: details.place?.name ?? "",
          settings: settingsLine(details),
          ar: clampAr(meta.width / meta.height),
          thumb: thumb.src,
          srcset: thumb.srcSet.attribute,
          full: full.src,
          width: meta.width,
          height: meta.height,
        };
      }),
    );
    return {
      ...album,
      items: items.filter((it): it is NonNullable<typeof it> => it !== null),
    };
  }),
);
// Number the photos in page order: the viewer steps through all of them.
let index = 0;
const shown = sections
  .filter((s) => s.items.length)
  .map((s) => ({ ...s, items: s.items.map((it) => ({ ...it, index: index++ })) }));
// What the photo viewer (Lightbox.astro) needs for each photo.
const galleryGroups = [
  {
    key: "photographs",
    title: "All photographs",
    items: shown.flatMap((s) =>
      s.items.map((it) => ({
        title: it.title || `Photograph ${it.index + 1}`,
        caption: "",
        alt: it.alt,
        place: it.place,
        settings: it.settings,
        album: s.id,
        placeholder: false,
        thumb: it.thumb,
        full: it.full,
      })),
    ),
  },
];
const json = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Photography"
  description="A personal collection of photographs by Charles Jiang."
  bodyClass="theme-darkroom"
  wide
>
  <PhotoHeader title="Photography" crumbs={[{ label: "Photography" }, { label: "Gallery" }]} />
  <PhotoTabs current="gallery" />
  <div class="page-shell">
    {
      shown.map((s) => (
        <section class="album" data-album={s.id} aria-labelledby={`album-${s.id}`}>
          <h2 class="ph-section-head" id={`album-${s.id}`}>
            {s.title}
            <span class="ph-count">{s.items.length}</span>
            {s.description && <span class="ph-section-meta">{s.description}</span>}
          </h2>
          <div class="pgrid">
            {s.items.map((it) => (
              <a
                class="cell ph-photo"
                href={it.full}
                style={`--ar:${it.ar.toFixed(3)}`}
                data-ar={it.ar.toFixed(4)}
                data-group="photographs"
                data-index={it.index}
                aria-label={`Open photograph: ${it.alt}`}
              >
                <img
                  src={it.thumb}
                  srcset={it.srcset}
                  sizes="(max-width: 480px) 100vw, (max-width: 1100px) 50vw, 640px"
                  alt={it.alt}
                  width={it.width}
                  height={it.height}
                  class="ph-img"
                  loading={it.index < 6 ? "eager" : "lazy"}
                  decoding="async"
                  draggable="false"
                />
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
  <script is:inline set:html={`window.__GALLERY__ = ${json(galleryGroups)};`} />
  <Lightbox />
  <DarkroomMotion />
</BaseLayout>

<script>
  // Justified rows, like Google Photos: every row fills the width and every
  // photo keeps its aspect ratio (no cropping). CSS flex gives a close
  // approximation before this runs, and without JavaScript.
  function layout() {
    document.querySelectorAll<HTMLElement>(".pgrid").forEach((grid) => {
      const style = getComputedStyle(grid);
      const gap = parseFloat(style.columnGap) || 4;
      const target = parseFloat(style.getPropertyValue("--row-h")) || 320;
      const width = grid.clientWidth;
      if (!width) return;
      let row: HTMLElement[] = [];
      let sum = 0;
      const flush = (last: boolean) => {
        if (!row.length) return;
        let h = (width - gap * (row.length - 1)) / sum;
        if (last && h > target) h = target; // don't blow up a short last row
        for (const cell of row) {
          cell.style.flex = "0 0 auto";
          cell.style.width = `${Math.floor(Number(cell.dataset.ar) * h)}px`;
          cell.style.height = `${Math.round(h)}px`;
        }
        row = [];
        sum = 0;
      };
      for (const cell of Array.from(grid.children) as HTMLElement[]) {
        row.push(cell);
        sum += Number(cell.dataset.ar) || 1.5;
        if (sum * target + gap * (row.length - 1) >= width) flush(false);
      }
      flush(true);
    });
  }
  layout();
  let width = window.innerWidth;
  let timer = 0;
  window.addEventListener("resize", () => {
    if (window.innerWidth === width) return; // ignore mobile toolbar resizes
    width = window.innerWidth;
    clearTimeout(timer);
    timer = window.setTimeout(layout, 120);
  });
  document.fonts?.ready.then(layout);
</script>

<style>
  .album {
    margin: 0 0 3rem;
  }
  .album:last-child {
    margin-bottom: 0;
  }
  .pgrid {
    --row-h: 340px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  @media (max-width: 1100px) {
    .pgrid {
      --row-h: 280px;
    }
  }
  @media (max-width: 760px) {
    .pgrid {
      --row-h: 220px;
      gap: 3px;
    }
  }
  @media (max-width: 480px) {
    .pgrid {
      --row-h: 180px;
    }
  }
  .cell {
    position: relative;
    height: var(--row-h);
    /* Grow, shrink, and basis all follow the aspect ratio, so rows fill the
       width while photos keep their shape. */
    flex: var(--ar) 1 calc(var(--ar) * var(--row-h));
  }
  .cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
