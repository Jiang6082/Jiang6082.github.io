---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE, SOCIALS } from "../config";

const firstName = SITE.name.split(" ")[0];
const photoSrc = SITE.photo
  ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}${SITE.photo}`
  : null;

// Interactive "focus areas" — edit freely.
const focus = [
  {
    icon: "chart",
    title: "Quantitative Finance",
    body: "Options research, backtesting, and paper-trading systems for equities and derivatives.",
  },
  {
    icon: "code",
    title: "Software Engineering",
    body: "Full-stack tools and automation — from data pipelines to job-scanning agents.",
  },
  {
    icon: "camera",
    title: "Photography",
    body: "Shooting for the love of light and composition. See the gallery for a few favorites.",
  },
];

// Tools I reach for — edit freely.
const stack = [
  "Python", "TypeScript", "JavaScript", "Node.js",
  "Pandas", "NumPy", "Alpaca API", "Git", "Astro",
];
---

<BaseLayout title="About">
  <section class="hero reveal">
    <div class="hero-main">
      <p class="eyebrow">Hi, I'm</p>
      <h1>{SITE.name}</h1>
      <p class="tagline muted">{SITE.tagline}</p>
      <p class="intro">
        <!-- Edit this to your own words. -->
        I'm a student at Northeastern University working at the intersection of
        <strong>quantitative finance</strong> and <strong>software</strong>. I
        build trading and research tools, write about what I learn, and shoot
        photos on the side.
      </p>
      <ul class="social-row">
        {
          SOCIALS.map((s) => (
            <li>
              <a
                class="social-btn"
                href={s.url}
                target={s.url.startsWith("http") ? "_blank" : undefined}
                rel="noopener"
              >
                <Icon name={s.icon} size={18} />
                <span>{s.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="portrait-wrap">
      <div class="glow" aria-hidden="true"></div>
      <div class="portrait">
        {
          photoSrc ? (
            <img src={photoSrc} alt={SITE.name} width="360" height="450" />
          ) : (
            <div class="portrait-placeholder">
              <Icon name="user" size={56} />
              <span>Your photo goes here</span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="focus">
    <h2 class="reveal">What I do</h2>
    <div class="focus-grid">
      {
        focus.map((f, i) => (
          <article class="focus-card reveal" style={`--reveal-delay:${i * 90}ms`}>
            <span class="focus-icon"><Icon name={f.icon} size={22} /></span>
            <h3>{f.title}</h3>
            <p class="muted">{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="stack-section reveal">
    <h2>Tools I reach for</h2>
    <ul class="pills">
      {stack.map((t) => <li class="pill">{t}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.3rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.1rem);
    margin: 0;
    background: linear-gradient(120deg, var(--fg) 30%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .tagline {
    font-size: 1.1rem;
    margin: 0.4rem 0 1.1rem;
  }
  .intro {
    font-size: 1.02rem;
    max-width: 34rem;
    margin: 0 0 1.5rem;
  }
  .intro strong {
    color: var(--fg);
    font-weight: 650;
  }

  /* ── Portrait slot (reserves space for the future photo) ──────── */
  .portrait-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .glow {
    position: absolute;
    inset: -18%;
    background: radial-gradient(
      circle at 50% 40%,
      color-mix(in srgb, var(--accent) 55%, transparent),
      transparent 70%
    );
    filter: blur(28px);
    opacity: 0.6;
    z-index: 0;
    pointer-events: none;
  }
  .portrait {
    position: relative;
    z-index: 1;
    width: 15rem;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    padding: 4px;
    background: linear-gradient(140deg, #6366f1, #a855f7 50%, #ec4899);
    box-shadow: var(--shadow);
    animation: float 6.5s ease-in-out infinite;
  }
  .portrait img,
  .portrait-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 16px;
    object-fit: cover;
    display: block;
  }
  .portrait-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
    padding: 1rem;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait {
      animation: none;
    }
  }

  /* ── Focus cards ──────────────────────────────────────────────── */
  .focus {
    margin-bottom: 3.5rem;
  }
  .focus h2,
  .stack-section h2 {
    margin-top: 0;
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }
  .focus-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.4rem;
    transition: transform 0.18s ease, border-color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .focus-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    box-shadow: var(--shadow-hover);
  }
  .focus-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    color: var(--accent);
    background: var(--accent-soft);
    margin-bottom: 0.85rem;
    transition: transform 0.18s ease;
  }
  .focus-card:hover .focus-icon {
    transform: scale(1.08) rotate(-4deg);
  }
  .focus-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.12rem;
  }
  .focus-card p {
    margin: 0;
    font-size: 0.92rem;
  }

  /* ── Tech stack pills ─────────────────────────────────────────── */
  .pills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .pill {
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    cursor: default;
    transition: transform 0.15s ease, color 0.15s ease,
      border-color 0.15s ease, background 0.15s ease;
  }
  .pill:hover {
    transform: translateY(-2px);
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  /* ── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: left;
    }
    .portrait-wrap {
      order: -1;
    }
    .portrait {
      width: 11rem;
    }
  }
</style>
