---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getImage } from "astro:assets";
import { SITE, SOCIALS } from "../config";
import { singles } from "../data/photos";

// Optimized portrait for the hero, resolved from src/photos.
const photoFiles = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const portraitMod = SITE.photo ? photoFiles[`../photos/${SITE.photo}`] : undefined;
const portrait = portraitMod
  ? await getImage({ src: portraitMod.default, width: 700, format: "webp" })
  : null;

// Dimmed floating photos for the ambient 3D background.
async function bgThumb(p: (typeof singles)[number]) {
  const mod = p.src ? photoFiles[`../photos/${p.src}`] : undefined;
  if (!mod) return null;
  const t = await getImage({ src: mod.default, width: 700, format: "webp" });
  return { src: t.src, ar: mod.default.width / mod.default.height };
}
const bg = (await Promise.all(singles.map(bgThumb))).filter(Boolean) as {
  src: string;
  ar: number;
}[];
// Scatter spots: x%, y%, depth(px), width(rem).
const bgSpots = [
  { x: 16, y: 26, z: -260, w: 17 },
  { x: 74, y: 18, z: 100, w: 15 },
  { x: 42, y: 60, z: -520, w: 20 },
  { x: 88, y: 62, z: -80, w: 14 },
  { x: 8, y: 70, z: 40, w: 16 },
  { x: 58, y: 30, z: -700, w: 22 },
  { x: 32, y: 86, z: 180, w: 13 },
  { x: 92, y: 42, z: -340, w: 15 },
  { x: 64, y: 80, z: -160, w: 17 },
];
const bgSpot = (i: number) => bgSpots[i % bgSpots.length];

// Roles cycled by the typewriter effect — edit freely.
const roles = ["Student", "Developer", "Photographer", "Traveler"];

// What I'm interested in — edit freely.
const interests = [
  {
    title: "Quantitative finance",
    body: "Systematic strategies, factor research, and how markets actually behave.",
  },
  {
    title: "Software",
    body: "Building tools and automation — data pipelines, trading systems, agents.",
  },
  {
    title: "Photography & travel",
    body: "Chasing light and composition on the road. See the gallery.",
  },
];

// Tools I reach for — edit freely.
const stack = [
  "Python", "TypeScript", "JavaScript", "Node.js",
  "Pandas", "NumPy", "Alpaca API", "Git", "Astro",
];
---

<BaseLayout title="About">
  <div class="bg-space" aria-hidden="true">
    <div class="bg-stage">
      {
        bg.map((b, i) => {
          const s = bgSpot(i);
          return (
            <span
              class="bg-tile"
              style={`left:${s.x}%;top:${s.y}%;--z:${s.z}px;--w:${s.w}rem;--delay:${(i * 0.7).toFixed(2)}s;--dur:${7 + (i % 4)}s;aspect-ratio:${b.ar.toFixed(3)}`}
            >
              <img src={b.src} alt="" loading="lazy" />
            </span>
          );
        })
      }
    </div>
  </div>

  <div class="about-content">
  <section class="hero reveal">
    <div class="hero-main">
      <p class="eyebrow">HI, I'M</p>
      <h1 class="name">{SITE.name}</h1>
      <p class="tagline muted">
        a <span id="typewriter" data-roles={JSON.stringify(roles)}>{roles[0]}</span
        ><span class="caret" aria-hidden="true"></span>
      </p>
      <p class="intro">
        I build trading and research tools, write about what I learn, travel,
        and shoot photos on the side.
      </p>
      <ul class="social-row">
        {
          SOCIALS.map((s) => (
            <li>
              <a
                class="social-btn"
                href={s.url}
                target={s.url.startsWith("http") ? "_blank" : undefined}
                rel="noopener"
              >
                <Icon name={s.icon} size={18} />
                <span>{s.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="portrait-wrap">
      <div class="portrait" id="portrait">
        {
          portrait ? (
            <img src={portrait.src} alt={SITE.name} width="280" height="350" />
          ) : (
            <div class="portrait-placeholder">
              <Icon name="user" size={56} />
              <span>Your photo goes here</span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="block reveal">
    <span class="section-label">INTERESTS</span>
    <ul class="rows">
      {
        interests.map((it) => (
          <li class="row">
            <span class="row-title">{it.title}</span>
            <span class="row-body muted">{it.body}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block reveal">
    <span class="section-label">TOOLS</span>
    <ul class="tools">
      {stack.map((t) => <li>{t}</li>)}
    </ul>
  </section>
  </div>
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ── Typewriter role cycler ──────────────────────────────────────
  const tw = document.getElementById("typewriter");
  if (tw) {
    let roles: string[] = [];
    try {
      roles = JSON.parse(tw.dataset.roles || "[]");
    } catch {}
    if (roles.length && !reduce) {
      let wi = 0,
        ci = 0,
        deleting = false;
      const tick = () => {
        const word = roles[wi];
        ci += deleting ? -1 : 1;
        tw.textContent = word.slice(0, ci);
        let delay = deleting ? 55 : 110;
        if (!deleting && ci === word.length) {
          deleting = true;
          delay = 1500;
        } else if (deleting && ci === 0) {
          deleting = false;
          wi = (wi + 1) % roles.length;
          delay = 350;
        }
        window.setTimeout(tick, delay);
      };
      window.setTimeout(tick, 1200);
    } else if (roles.length) {
      tw.textContent = roles.join(" · ");
    }
  }

  // ── Subtle 3D parallax tilt on the portrait ─────────────────────
  const portrait = document.getElementById("portrait");
  if (portrait && !reduce) {
    const wrap = portrait.parentElement!;
    wrap.style.perspective = "800px";
    wrap.addEventListener("pointermove", (e) => {
      const r = wrap.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      portrait.style.transform = `rotateX(${py * -8}deg) rotateY(${px * 10}deg)`;
    });
    wrap.addEventListener("pointerleave", () => {
      portrait.style.transform = "";
    });
  }
</script>

<style>
  /* ── Ambient 3D photo background ──────────────────────────────── */
  .about-content {
    position: relative;
    z-index: 1;
  }
  .bg-space {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none; /* gaps pass through; tiles re-enable below */
    overflow: hidden;
    perspective: 1200px;
  }
  .bg-stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  /* Each photo floats gently in place (no more global rotation) and reacts
     to the cursor: grey + dim at rest, full colour + lift on hover. */
  .bg-tile {
    position: absolute;
    width: var(--w, 16rem);
    transform: translate(-50%, -50%) translateZ(var(--z, 0)) scale(var(--s, 1));
    border-radius: 12px;
    overflow: hidden;
    opacity: 0.24;
    pointer-events: auto;
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s ease;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0);
  }
  .bg-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.55) brightness(0.7);
    transition: filter 0.4s ease, transform 0.4s ease;
    animation: floaty var(--dur, 8s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  .bg-tile:hover {
    --s: 1.12;
    opacity: 1;
    z-index: 5;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
  }
  .bg-tile:hover img {
    filter: grayscale(0) brightness(1.05);
  }
  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-16px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bg-tile img {
      animation: none;
    }
  }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: 4.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .name {
    font-size: clamp(2.2rem, 6vw, 3.1rem);
    margin: 0;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 1.15rem;
    margin: 0.4rem 0 1.1rem;
    min-height: 1.6em;
  }
  #typewriter {
    color: var(--fg);
    font-weight: 600;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .intro {
    font-size: 1.02rem;
    max-width: 34rem;
    margin: 0 0 1.5rem;
  }

  /* ── Portrait ─────────────────────────────────────────────────── */
  .portrait-wrap {
    flex-shrink: 0;
  }
  .portrait {
    position: relative;
    width: 15rem;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.2s ease-out;
    transform-style: preserve-3d;
  }
  .portrait img,
  .portrait-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .portrait-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
    padding: 1rem;
  }

  /* ── Editorial sections (interests / tools) ───────────────────── */
  .block {
    margin-bottom: 3.25rem;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .rows {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border);
  }
  .row-title {
    font-weight: 650;
    font-size: 1.05rem;
  }
  .row-body {
    font-size: 0.95rem;
  }

  .tools {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .tools li {
    position: relative;
    transition: color 0.15s ease;
  }
  .tools li:hover {
    color: var(--accent);
  }
  .tools li:not(:last-child)::after {
    content: "";
    position: absolute;
    right: -0.78rem;
    top: 0.15em;
    bottom: 0.15em;
    width: 1px;
    background: var(--border);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait-wrap {
      order: -1;
    }
    .portrait {
      width: 11rem;
    }
  }
</style>
