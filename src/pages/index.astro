---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import { SITE } from "../config";
import portrait from "../photos/IMG_0339.jpg";
import coast from "../photos/IMG_0047.jpg";
import shrine from "../photos/IMG_9433-2.jpg";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const frames = await Promise.all(
  [
    {
      image: portrait,
      label: "Behind the camera",
      alt: "Charles photographing his reflection among hanging orchids",
    },
    {
      image: coast,
      label: "Along the coast",
      alt: "A beach curving alongside a coastal road under a blue sky",
    },
    {
      image: shrine,
      label: "A little further in",
      alt: "Red torii gates against stone markers in a bamboo grove",
    },
  ].map(async (f) => ({
    ...f,
    optimized: await getImage({
      src: f.image,
      width: Math.min(1800, f.image.width),
      format: "webp",
    }),
  })),
);
---

<BaseLayout
  description="Charles Jiang — trading and research tools, photographs, and things I’m learning."
  wide
  bodyClass="home"
>
  <section class="opening" aria-labelledby="home-heading">
    <div class="opening-stage">
      <div class="opening-top eyebrow">
        <span>A personal collection</span><span
          >Code, photographs & other observations</span
        ><button class="motion-toggle" type="button" aria-pressed="false" hidden
          >Motion off</button
        >
      </div>
      <div class="hero-copy">
        <h1 id="home-heading">Projects &<br />photographs.</h1><p class="intro">
          Trading tools, research projects, and photos from my travels.
        </p><a class="text-link" href="#selected-work"
          >Explore my work <span aria-hidden="true">↘</span></a
        >
      </div>
      <div class="photo-window">
        {
          frames.map((f, i) => (
            <img
              class:list={["hero-frame", { first: i === 0 }]}
              src={f.optimized.src}
              alt={f.alt}
              width={f.optimized.attributes.width}
              height={f.optimized.attributes.height}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              data-frame={i}
              data-label={f.label}
            />
          ))
        }<div class="frame-caption">
          <span id="frame-label">Behind the camera</span><button
            class="next-frame"
            type="button"
            aria-label="Next photograph"
            hidden>Next ↗</button
          ><span><span id="frame-number">01</span> / 03</span>
        </div>
      </div>
      <div class="opening-bottom eyebrow">
        <span>Student / Developer / Photographer</span><a href="#selected-work"
          >Scroll to look around ↓</a
        >
      </div>
    </div>
  </section>
  <section class="home-about page-shell" id="about">
    <p class="eyebrow">01 / A little context</p><div>
      <h2>Interests</h2><p>
        I’m interested in how markets behave, how useful software gets made, and
        what catches my eye when I’m somewhere new.
      </p><p>Here’s some of what I’ve been working on.</p>
    </div>
  </section>
  <section class="home-work page-shell" id="selected-work">
    <div class="section-heading">
      <p class="eyebrow">02 / Selected work</p><a
        class="text-link"
        href={`${base}/projects`}>All projects ↗</a
      >
    </div>
    <a class="work-row" href={`${base}/projects#project-emberforge`}
      ><span class="work-number">01</span><div>
        <h3>Emberforge</h3><p>
          Finding trading factors that hold up to scrutiny.
        </p>
      </div><span class="work-kind">Quantitative research</span><span
        class="work-arrow">↗</span
      ></a
    >
    <a class="work-row" href={`${base}/projects#project-geld`}
      ><span class="work-number">02</span><div>
        <h3>Geld</h3><p>From an idea to a backtest to paper trading.</p>
      </div><span class="work-kind">Trading systems</span><span
        class="work-arrow">↗</span
      ></a
    >
    <a class="work-row" href={`${base}/projects#QJS`}
      ><span class="work-number">03</span><div>
        <h3>QJS</h3><p>A little automation for the internship search.</p>
      </div><span class="work-kind">Tools & automation</span><span
        class="work-arrow">↗</span
      ></a
    >
  </section>
  <section class="photo-invitation page-shell">
    <a href={`${base}/photography`} class="photo-link"
      ><img
        src={frames[1].optimized.src}
        width="1800"
        height="1200"
        alt={frames[1].alt}
        loading="lazy"
      /><span>Photography <span aria-hidden="true">↗</span></span></a
    ><div class="photo-note">
      <p class="eyebrow">03 / Away from the screen</p><p>
        Photos from my travels.
      </p><a class="text-link" href={`${base}/photography`}
        >Open the photo collection ↗</a
      >
    </div>
  </section>
  <section class="closing page-shell">
    <p class="eyebrow">Keep in touch</p><h2>Get in touch</h2><a
      class="text-link"
      href={`mailto:${SITE.email}`}>Say hello ↗</a
    ><a class="journal-link" href={`${base}/blog`}
      >Or read what I’m learning →</a
    >
  </section>
</BaseLayout>
<style>
  .opening {
    height: auto;
    padding: 0 var(--gutter);
  }
  .opening-stage {
    position: relative;
    min-height: 740px;
    height: calc(100svh - 88px);
    max-height: 1100px;
    max-width: 1560px;
    margin: auto;
  }
  .opening-top,
  .opening-bottom {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .opening-top {
    top: 22px;
  }
  .opening-bottom {
    bottom: 24px;
  }
  .opening-bottom a {
    color: inherit;
  }
  .hero-copy {
    position: absolute;
    left: 0;
    top: 14%;
    z-index: 2;
    width: 56%;
  }
  h1 {
    font-size: clamp(2.3rem, 4.5vw, 4.5rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0 0 1.7rem;
  }
  .intro {
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    line-height: 1.65;
    max-width: 30rem;
  }
  .photo-window {
    position: absolute;
    left: 59%;
    top: 12%;
    width: 38%;
    height: 72%;
    overflow: hidden;
    background: #273526;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .hero-frame.first {
    opacity: 1;
    object-position: 45% 54%;
  }
  .frame-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px 22px 20px;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #fff;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    font: 0.8125rem var(--font-mono);
  }
  .home-about {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    padding-top: 8rem;
    padding-bottom: 8rem;
    border-top: 1px solid var(--border);
  }
  .home-about h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin: 0 0 2rem;
  }
  .home-about p:not(.eyebrow) {
    max-width: 37rem;
    font-size: 1.2rem;
    color: var(--muted);
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1rem;
  }
  .work-row {
    display: grid;
    grid-template-columns: 3rem 1fr 13rem 2rem;
    gap: 1rem;
    align-items: center;
    padding: 2.3rem 0;
    border-top: 1px solid var(--border);
    color: var(--fg);
    transition:
      padding 0.2s,
      color 0.2s;
  }
  .work-row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .work-row:hover {
    text-decoration: none;
    color: var(--accent);
    padding-left: 12px;
  }
  .work-row h3 {
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    margin: 0 0 0.25rem;
    font-weight: 400;
    letter-spacing: -0.045em;
  }
  .work-row p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
  }
  .work-number,
  .work-kind {
    font: 0.8125rem var(--font-mono);
    color: var(--muted);
  }
  .work-arrow {
    font-size: 2rem;
  }
  .photo-invitation {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: end;
    padding-top: 9rem;
    padding-bottom: 9rem;
  }
  .photo-link {
    position: relative;
    overflow: hidden;
    color: #fff;
  }
  .photo-link img {
    width: 100%;
    aspect-ratio: 1.25;
    object-fit: cover;
    transition: transform 0.6s;
  }
  .photo-link:hover img {
    transform: scale(1.025);
  }
  .photo-link > span {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 3rem 1.5rem 1.2rem;
    background: linear-gradient(transparent, #0008);
    font-size: clamp(1.7rem, 3vw, 2.8rem);
    display: flex;
    justify-content: space-between;
  }
  .photo-note p:not(.eyebrow) {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 2rem 0;
  }
  .closing {
    padding-top: 4rem;
    padding-bottom: 6rem;
    border-top: 1px solid var(--border);
  }
  .closing h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 2rem 0;
  }
  .journal-link {
    float: right;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .opening-stage {
      height: auto;
      min-height: 0;
      padding: 5rem 0 4rem;
    }
    .opening-top {
      font-size: 0.75rem;
    }
    .opening-top span:last-child {
      display: none;
    }
    .hero-copy {
      position: relative;
      width: 100%;
      top: auto;
    }
    h1 {
      font-size: clamp(2.1rem, 8vw, 3.5rem);
    }
    .photo-window {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      height: 520px;
      max-height: 70svh;
      margin-top: 2.5rem;
    }
    .opening-bottom {
      bottom: 10px;
      font-size: 0.75rem;
    }
    .opening-bottom > span {
      display: none;
    }
    .home-about {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
    .work-row {
      grid-template-columns: 2rem 1fr 1.5rem;
      padding: 1.5rem 0;
    }
    .work-kind {
      display: none;
    }
    .photo-invitation {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
    .photo-note p:not(.eyebrow) {
      margin: 1rem 0;
    }
    .journal-link {
      display: block;
      float: none;
      margin-top: 2rem;
    }
  }
</style>

<script>
  import { openingState } from "../lib/opening-motion.js";
  const track = document.querySelector<HTMLElement>(".opening");
  const windowEl = document.querySelector<HTMLElement>(".photo-window");
  const copy = document.querySelector<HTMLElement>(".hero-copy");
  const frames = Array.from(
    document.querySelectorAll<HTMLImageElement>(".hero-frame"),
  );
  const number = document.getElementById("frame-number");
  const label = document.getElementById("frame-label");
  const toggle = document.querySelector<HTMLButtonElement>(".motion-toggle");
  const next = document.querySelector<HTMLButtonElement>(".next-frame");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const roomy = matchMedia("(min-width: 901px) and (min-height: 700px)");
  let enabled = true,
    active = 0,
    queued = false;
  const animated = () => enabled && !reduce.matches && roomy.matches;
  function setCaption(index: number) {
    active = index;
    if (number) number.textContent = String(index + 1).padStart(2, "0");
    if (label) label.textContent = frames[index]?.dataset.label || "";
  }
  function update() {
    queued = false;
    if (!track || !windowEl || !copy || !animated()) return;
    const distance = track.offsetHeight - innerHeight;
    const state = openingState(
      distance > 0 ? -track.getBoundingClientRect().top / distance : 0,
    );
    windowEl.style.left = `${state.left}%`;
    windowEl.style.width = `${state.width}%`;
    windowEl.style.top = `${state.top}%`;
    windowEl.style.height = `${state.height}%`;
    copy.style.opacity = String(state.copyOpacity);
    const link = copy.querySelector("a");
    if (link) {
      link.tabIndex = state.copyOpacity < 0.1 ? -1 : 0;
      link.style.pointerEvents = state.copyOpacity < 0.1 ? "none" : "";
    }
    frames.forEach((f, i) => {
      f.style.opacity = String(state.opacities[i]);
      f.style.transform = `scale(${1.025 - 0.025 * state.opacities[i]})`;
    });
    setCaption(state.active);
  }
  function configure() {
    if (!track || !windowEl || !copy || !toggle || !next) return;
    track.classList.toggle("scrub-enabled", animated());
    windowEl.removeAttribute("style");
    copy.removeAttribute("style");
    frames.forEach((f, i) => {
      f.style.opacity = i === active ? "1" : "0";
      f.style.transform = "none";
    });
    const link = copy.querySelector("a");
    if (link) {
      link.tabIndex = 0;
      link.style.pointerEvents = "";
    }
    toggle.hidden = !roomy.matches;
    toggle.disabled = reduce.matches;
    toggle.textContent = animated() ? "Motion on" : "Motion off";
    toggle.setAttribute("aria-pressed", String(animated()));
    toggle.title = reduce.matches
      ? "Your reduced-motion setting is respected"
      : "Toggle scroll-driven photo playback";
    next.hidden = false;
    update();
  }
  function onScroll() {
    if (!queued && animated()) {
      queued = true;
      requestAnimationFrame(update);
    }
  }
  if (track && windowEl && copy && frames.length && toggle && next) {
    toggle.addEventListener("click", () => {
      const before = track.getBoundingClientRect().top;
      enabled = !enabled;
      configure();
      if (before < 0 && !animated())
        scrollTo({ top: track.offsetTop, behavior: "instant" });
    });
    next.addEventListener("click", () => {
      const index = (active + 1) % frames.length;
      if (animated()) {
        const p = [0, 0.66, 0.94][index];
        scrollTo({
          top: track.offsetTop + p * (track.offsetHeight - innerHeight),
          behavior: "instant",
        });
      } else {
        frames.forEach((f, i) => (f.style.opacity = i === index ? "1" : "0"));
        setCaption(index);
      }
    });
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    reduce.addEventListener("change", configure);
    roomy.addEventListener("change", configure);
    configure();
  }
</script>
<style>
  .motion-toggle {
    background: none;
    border: 0;
    padding: 0;
    color: var(--muted);
    font: inherit;
    text-transform: uppercase;
    letter-spacing: inherit;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .motion-toggle:disabled {
    opacity: 0.6;
  }
  .next-frame {
    background: none;
    color: white;
    border: 0;
    padding: 0;
    font: inherit;
    white-space: nowrap;
  }
  .next-frame:hover {
    text-decoration: underline;
  }
  .motion-toggle[hidden],
  .next-frame[hidden] {
    display: none;
  }
  .opening-top {
    z-index: 4;
  }
  .frame-caption {
    align-items: center;
    flex-wrap: wrap;
  }
  .scrub-enabled {
    height: 260svh;
  }
  .scrub-enabled .opening-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    max-height: none;
  }
  .scrub-enabled .photo-window {
    will-change: width, height, left, top;
  }
  .scrub-enabled .hero-copy {
    will-change: opacity;
  }
  @media (prefers-reduced-motion: reduce) {
    .opening.scrub-enabled {
      height: auto;
    }
    .scrub-enabled .opening-stage {
      position: relative;
    }
  }
</style>
