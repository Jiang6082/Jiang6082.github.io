---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { walkthroughs } from "../../data/research";
export function getStaticPaths() {
  return walkthroughs.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={p.title} description={p.intro} wide>
  <div class="reading-layout">
    <nav class="contents" aria-label="Walkthrough sections">
      <span class="eyebrow">On this page</span>
      {
        p.sections.map((s, i) => (
          <a href={`#${s.id}`}>
            <span class="section-number" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            {s.title}
          </a>
        ))
      }
    </nav>
    <article class="walkthrough">
      <a class="text-link" href={`${base}/projects#${p.project}`}
        >← All projects</a
      >
      <header>
        <p class="eyebrow">Project walkthrough</p><h1>{p.title}</h1><p
          class="intro"
        >
          {p.intro}
        </p>
        <p class="scope">{p.scope}</p>
        <dl class="facts">
          {
            p.facts.map((f) => (
              <div>
                <>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </header>
      {
        p.sections.map((s) => (
          <section id={s.id}>
            <h2>{s.title}</h2>
            {s.paragraphs.map((text) => (
              <p>{text}</p>
            ))}
            {s.code && (
              <pre>
                <code>{s.code}</code>
              </pre>
            )}
            {s.table && (
              <div
                class="table-scroll"
                tabindex="0"
                role="region"
                aria-label={s.table.caption}
              >
                <table>
                  <caption>{s.table.caption}</caption>
                  <thead>
                    <tr>
                      {s.table.columns.map((c) => (
                        <th scope="col">{c}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((row) => (
                      <tr>
                        {row.map((cell, i) =>
                          i === 0 ? (
                            <th scope="row">{cell}</th>
                          ) : (
                            <td>{cell}</td>
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {s.image && (
              <figure>
                <a href={`${base}${s.image.src}`}>
                  <img
                    src={`${base}${s.image.src}`}
                    alt={s.image.alt}
                    width="550"
                    height="550"
                    loading="lazy"
                  />
                </a>
                <figcaption>{s.image.caption}</figcaption>
              </figure>
            )}
            <ul class="sources" aria-label={`Sources for ${s.title}`}>
              {s.sources.map((source) => (
                <li>
                  <a href={source.url}>{source.label} ↗</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <footer>
        <a class="text-link" href={p.source}>Explore the repository ↗</a><a
          class="text-link"
          href={`${base}/projects`}>Back to projects</a
        >
      </footer>
    </article>
  </div>
</BaseLayout>
<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".contents a"),
  );
  const sections = links.map((link) =>
    document.getElementById(link.hash.slice(1)),
  );
  let pending = false;
  function updateSection() {
    pending = false;
    let active = -1;
    sections.forEach((section, index) => {
      if (section && section.getBoundingClientRect().top <= 160) active = index;
    });
    links.forEach((link, index) => {
      if (index === active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }
  function scheduleUpdate() {
    if (!pending) {
      pending = true;
      requestAnimationFrame(updateSection);
    }
  }
  window.addEventListener("scroll", scheduleUpdate, { passive: true });
  window.addEventListener("resize", scheduleUpdate);
  window.addEventListener("pageshow", scheduleUpdate);
  updateSection();
</script>
<style>
  .reading-layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 48rem);
    gap: clamp(2rem, 4vw, 4rem);
    max-width: 70rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    align-items: start;
  }
  .walkthrough {
    padding: 1rem 0 4rem;
    min-width: 0;
  }
  header {
    padding: 3rem 0 1rem;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 1rem 0;
  }
  .intro {
    font-size: 1.25rem;
    color: var(--muted);
  }
  .scope {
    font-size: 0.85rem;
    color: var(--muted);
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    margin: 2rem 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border);
    margin: 2rem 0 0;
    gap: 1.5rem;
    padding: 1.5rem 0;
  }
  .facts div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
  }
  dt {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
  }
  dd {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    margin: 0;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.025em;
  }
  .contents {
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 3rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    padding: 1rem 0;
    margin-top: 1rem;
    border-left: 1px solid var(--border);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .contents > .eyebrow {
    font-size: 0.7rem;
    padding: 0 1rem 1rem;
  }
  .contents a {
    color: var(--muted);
    display: flex;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    border-left: 2px solid transparent;
    margin-left: -1px;
    text-decoration: none;
  }
  .contents a:hover,
  .contents a[aria-current="location"] {
    color: var(--accent);
    background: var(--surface-2);
    border-left-color: var(--accent);
  }
  .section-number {
    font: 0.65rem/1.85 var(--font-mono);
    opacity: 0.7;
  }
  @media (max-width: 1000px) {
    .reading-layout {
      display: block;
      max-width: 48rem;
    }
    .contents {
      position: static;
      max-height: none;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.35rem 0.5rem;
      margin: 0 0 2rem;
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }
    .contents > .eyebrow {
      flex-basis: 100%;
      padding: 0 0 0.5rem;
    }
    .contents a {
      padding: 0.5rem;
      margin: 0;
      font-size: 0.75rem;
    }
  }
  section {
    margin: 3.5rem 0;
    scroll-margin-top: 2rem;
  }
  h2 {
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.35;
  }
  p {
    line-height: 1.8;
  }
  pre {
    padding: 1.5rem;
    background: var(--surface-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  code {
    font: 0.8rem/1.9 var(--font-mono);
  }
  .table-scroll {
    overflow-x: auto;
    max-width: 100%;
    margin: 2rem 0;
    overscroll-behavior-x: contain;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    text-align: left;
  }
  caption {
    text-align: left;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.6;
    padding-bottom: 1rem;
    caption-side: top;
  }
  th,
  td {
    padding: 0.85rem 0.8rem;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  th:first-child {
    white-space: normal;
    min-width: 8rem;
  }
  thead {
    background: var(--surface-2);
  }
  thead th {
    font-size: 0.75rem;
    font-weight: 600;
  }
  tbody th {
    font-weight: 400;
  }
  td {
    text-align: right;
  }
  thead th:not(:first-child) {
    text-align: right;
  }
  tbody tr:hover {
    background: var(--surface-2);
  }
  figure {
    margin: 2rem 0;
  }
  img {
    display: block;
    width: 100%;
    max-width: 550px;
    height: auto;
    margin: auto;
    background: white;
  }
  figcaption {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.6;
    margin-top: 1rem;
  }
  .sources {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    font-size: 0.75rem;
    line-height: 1.6;
    margin-top: 1.5rem;
  }
  .sources a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 480px) {
    .facts {
      gap: 0.75rem;
    }
    th,
    td {
      padding: 0.75rem 0.55rem;
    }
    .facts dt {
      font-size: 0.72rem;
    }
    header {
      padding-top: 2rem;
    }
  }
</style>
