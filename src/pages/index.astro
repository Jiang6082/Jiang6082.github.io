---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE, SOCIALS } from "../config";
---

<BaseLayout title="About">
  <section class="hero">
    <h1>{SITE.name}</h1>
    <p class="muted tagline">{SITE.tagline}</p>
  </section>

  <ul class="social-row hero-socials">
    {
      SOCIALS.map((s) => (
        <li>
          <a
            class="social-btn"
            href={s.url}
            target={s.url.startsWith("http") ? "_blank" : undefined}
            rel="noopener"
          >
            <Icon name={s.icon} size={18} />
            <span>{s.name}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="prose">
    <p>
      Hi — I'm {SITE.name.split(" ")[0]}. Welcome to my corner of the internet.
      This is where I write, share what I'm building, and post photos I've taken.
    </p>
    <p>
      <!-- Replace this with a couple of real paragraphs about yourself: what
           you study or work on, what you're into, what you're currently
           exploring. Keep it human. -->
      I'm a student at Northeastern University interested in software, design,
      and photography. Right now I'm exploring <em>(edit me)</em> and always
      happy to chat about new projects.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 1.5rem;
  }
  .tagline {
    font-size: 1.08rem;
    margin: 0;
  }
  .hero-socials {
    margin-bottom: 2.25rem;
  }
</style>
