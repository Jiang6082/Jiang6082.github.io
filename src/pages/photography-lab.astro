---
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { collections, singles, type Photo } from "../data/photos";
import { getImage } from "astro:assets";

const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;

async function toItem(p: Photo) {
  const mod = p.src ? files[`../photos/${p.src}`] : undefined;
  if (!mod) return null;
  const meta = mod.default;
  const thumb = await getImage({ src: meta, width: Math.min(1100, meta.width), format: "webp" });
  const full = await getImage({ src: meta, width: Math.min(2400, meta.width), format: "webp" });
  return {
    title: p.title ?? "",
    caption: p.caption ?? "",
    alt: p.alt || p.title || "Photo",
    placeholder: false,
    ar: meta.width / meta.height,
    thumb: thumb.src,
    full: full.src,
  };
}

const all: Photo[] = [...collections.flatMap((c) => c.photos), ...singles];
const items = (await Promise.all(all.map(toItem))).filter(Boolean) as NonNullable<
  Awaited<ReturnType<typeof toItem>>
>[];

const step = items.length ? 360 / items.length : 40; // angle between photos
---

<BaseLayout title="Photography · Lab" description="An experimental 3D view of the gallery." wide>
  <div class="ring-head">
    <span class="eyebrow">EXPERIMENT</span>
    <h1>Gallery, in the round</h1>
    <p class="muted lede">
      The same photos, arranged in a circle around you. <strong>Scroll</strong> to
      spin the world; <strong>click</strong> a photo to open it (scroll to zoom,
      drag to pan, ← / → to move). The
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/photography`}>standard gallery</a>
      is still the main one.
    </p>
  </div>

  <div class="ring-scene" id="scene">
    <div class="ring" id="ring">
      {
        items.map((it, i) => (
          <button
            class="ring-item"
            data-group="lab"
            data-index={i}
            style={`--a:${(i * step).toFixed(3)}deg; aspect-ratio:${it.ar.toFixed(3)}`}
            aria-label={it.title || "Open photo"}
          >
            <img src={it.thumb} alt={it.alt} loading="lazy" draggable="false" />
          </button>
        ))
      }
    </div>
    <span class="ring-hint" aria-hidden="true">scroll to spin ⟲</span>
  </div>

  <script
    is:inline
    set:html={`window.__GALLERY__ = [${JSON.stringify({
      key: "lab",
      title: "Photos",
      items: items.map((it) => ({
        title: it.title,
        caption: it.caption,
        alt: it.alt,
        placeholder: it.placeholder,
        thumb: it.thumb,
        full: it.full,
      })),
    })}];`}
  />

  <Lightbox />
</BaseLayout>

<script>
  const scene = document.getElementById("scene");
  const ring = document.getElementById("ring");
  const lb = document.getElementById("lightbox");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (scene && ring) {
    let rot = 0; // current angle
    let target = 0; // desired angle
    const idle = reduce ? 0 : 0.015; // gentle perpetual drift

    const loop = () => {
      if (!reduce) target += idle;
      rot += (target - rot) * 0.09;
      ring.style.transform = `translate(-50%, -50%) rotateY(${rot}deg)`;
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    // Scroll spins the world (only when the lightbox is closed).
    scene.addEventListener(
      "wheel",
      (e) => {
        if (lb && !lb.hidden) return;
        e.preventDefault();
        target += e.deltaY * 0.18;
      },
      { passive: false }
    );

    // Drag / swipe also spins; suppress the click that would open a photo
    // if the pointer actually moved (so a drag doesn't trigger the lightbox).
    let down = false;
    let moved = false;
    let lastX = 0;
    scene.addEventListener("pointerdown", (e) => {
      down = true;
      moved = false;
      lastX = e.clientX;
    });
    scene.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      if (Math.abs(dx) > 2) moved = true;
      target += dx * 0.35;
    });
    const up = () => (down = false);
    scene.addEventListener("pointerup", up);
    scene.addEventListener("pointercancel", up);
    scene.addEventListener(
      "click",
      (e) => {
        if (moved) {
          e.stopPropagation();
          e.preventDefault();
        }
      },
      true // capture, so it runs before the tile's click handler
    );
  }
</script>

<style>
  .ring-head {
    max-width: var(--max-width-wide);
    margin: 0 auto 0.5rem;
    padding: 0 1.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .ring-head h1 {
    margin: 0.5rem 0 0.4rem;
  }
  .lede {
    max-width: 44rem;
    margin: 0;
  }
  .lede strong {
    color: var(--fg);
    font-weight: 600;
  }

  .ring-scene {
    position: relative;
    height: min(72vh, 40rem);
    margin-top: 1rem;
    perspective: 1700px;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
  }
  .ring-scene:active {
    cursor: grabbing;
  }
  .ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: translate(-50%, -50%);
  }
  .ring-item {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(13rem, 24vw, 20rem);
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    /* place each photo on the circle: turn, then push outward */
    transform: translate(-50%, -50%) rotateY(var(--a)) translateZ(34rem);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 55px rgba(0, 0, 0, 0.5);
    transition: box-shadow 0.3s ease;
    backface-visibility: hidden;
  }
  .ring-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.3s ease;
  }
  .ring-item:hover {
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.65);
  }
  .ring-item:hover img {
    filter: brightness(1.08);
  }

  .ring-hint {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--muted);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .ring-item {
      transform: translate(-50%, -50%) rotateY(var(--a)) translateZ(26rem);
    }
  }
</style>
