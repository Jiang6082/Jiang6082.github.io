---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getImage } from "astro:assets";
import { SITE, SOCIALS } from "../config";

// Optimized portrait for the hero, resolved from src/photos.
const photoFiles = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const portraitMod = SITE.photo ? photoFiles[`../photos/${SITE.photo}`] : undefined;
const portrait = portraitMod
  ? await getImage({ src: portraitMod.default, width: 700, format: "webp" })
  : null;

// Roles cycled by the typewriter effect — edit freely.
const roles = ["Student", "Developer", "Photographer", "Traveler"];

// What I'm interested in — edit freely.
const interests = [
  {
    title: "Quantitative finance",
    body: "Systematic strategies, factor research, and how markets actually behave.",
  },
  {
    title: "Software",
    body: "Building tools and automation — data pipelines, trading systems, agents.",
  },
  {
    title: "Photography & travel",
    body: "Chasing light and composition on the road. See the gallery.",
  },
];

// Tools I reach for — edit freely.
const stack = [
  "Python", "TypeScript", "JavaScript", "Node.js",
  "Pandas", "NumPy", "Alpaca API", "Git", "Astro",
];
---

<BaseLayout title="About">
  <section class="hero reveal">
    <div class="hero-main">
      <p class="eyebrow">HI, I'M</p>
      <h1 class="name">{SITE.name}</h1>
      <p class="tagline muted">
        a <span id="typewriter" data-roles={JSON.stringify(roles)}>{roles[0]}</span
        ><span class="caret" aria-hidden="true"></span>
      </p>
      <p class="intro">
        I build trading and research tools, write about what I learn, travel,
        and shoot photos on the side.
      </p>
      <ul class="social-row">
        {
          SOCIALS.map((s) => (
            <li>
              <a
                class="social-btn"
                href={s.url}
                target={s.url.startsWith("http") ? "_blank" : undefined}
                rel="noopener"
              >
                <Icon name={s.icon} size={18} />
                <span>{s.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="portrait-wrap">
      <div class="portrait" id="portrait">
        {
          portrait ? (
            <img src={portrait.src} alt={SITE.name} width="280" height="350" />
          ) : (
            <div class="portrait-placeholder">
              <Icon name="user" size={56} />
              <span>Your photo goes here</span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="block reveal">
    <span class="section-label">INTERESTS</span>
    <ul class="rows">
      {
        interests.map((it) => (
          <li class="row">
            <span class="row-title">{it.title}</span>
            <span class="row-body muted">{it.body}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block reveal">
    <span class="section-label">TOOLS</span>
    <ul class="tools">
      {stack.map((t) => <li>{t}</li>)}
    </ul>
  </section>
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ── Typewriter role cycler ──────────────────────────────────────
  const tw = document.getElementById("typewriter");
  if (tw) {
    let roles: string[] = [];
    try {
      roles = JSON.parse(tw.dataset.roles || "[]");
    } catch {}
    if (roles.length && !reduce) {
      let wi = 0,
        ci = 0,
        deleting = false;
      const tick = () => {
        const word = roles[wi];
        ci += deleting ? -1 : 1;
        tw.textContent = word.slice(0, ci);
        let delay = deleting ? 55 : 110;
        if (!deleting && ci === word.length) {
          deleting = true;
          delay = 1500;
        } else if (deleting && ci === 0) {
          deleting = false;
          wi = (wi + 1) % roles.length;
          delay = 350;
        }
        window.setTimeout(tick, delay);
      };
      window.setTimeout(tick, 1200);
    } else if (roles.length) {
      tw.textContent = roles.join(" · ");
    }
  }

  // ── Subtle 3D parallax tilt on the portrait ─────────────────────
  const portrait = document.getElementById("portrait");
  if (portrait && !reduce) {
    const wrap = portrait.parentElement!;
    wrap.style.perspective = "800px";
    wrap.addEventListener("pointermove", (e) => {
      const r = wrap.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      portrait.style.transform = `rotateX(${py * -8}deg) rotateY(${px * 10}deg)`;
    });
    wrap.addEventListener("pointerleave", () => {
      portrait.style.transform = "";
    });
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: 4.5rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .name {
    font-size: clamp(2.2rem, 6vw, 3.1rem);
    margin: 0;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 1.15rem;
    margin: 0.4rem 0 1.1rem;
    min-height: 1.6em;
  }
  #typewriter {
    color: var(--fg);
    font-weight: 600;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .intro {
    font-size: 1.02rem;
    max-width: 34rem;
    margin: 0 0 1.5rem;
  }

  /* ── Portrait ─────────────────────────────────────────────────── */
  .portrait-wrap {
    flex-shrink: 0;
  }
  .portrait {
    position: relative;
    width: 15rem;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.2s ease-out;
    transform-style: preserve-3d;
  }
  .portrait img,
  .portrait-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .portrait-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
    padding: 1rem;
  }

  /* ── Editorial sections (interests / tools) ───────────────────── */
  .block {
    margin-bottom: 3.25rem;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .rows {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border);
  }
  .row-title {
    font-weight: 650;
    font-size: 1.05rem;
  }
  .row-body {
    font-size: 0.95rem;
  }

  .tools {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .tools li {
    position: relative;
    transition: color 0.15s ease;
  }
  .tools li:hover {
    color: var(--accent);
  }
  .tools li:not(:last-child)::after {
    content: "";
    position: absolute;
    right: -0.78rem;
    top: 0.15em;
    bottom: 0.15em;
    width: 1px;
    background: var(--border);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait-wrap {
      order: -1;
    }
    .portrait {
      width: 11rem;
    }
  }
</style>
