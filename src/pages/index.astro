---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { getImage } from "astro:assets";
import { SITE, SOCIALS } from "../config";

// Optimized portrait for the hero, resolved from src/photos.
const photoFiles = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const portraitMod = SITE.photo ? photoFiles[`../photos/${SITE.photo}`] : undefined;
const portrait = portraitMod
  ? await getImage({ src: portraitMod.default, width: 700, format: "webp" })
  : null;

// Roles cycled by the typewriter effect — edit freely.
const roles = ["Student", "Developer", "Photographer", "Traveler"];

// Interactive "focus areas" — edit freely.
const focus = [
  {
    icon: "chart",
    title: "Quantitative Finance",
    body: "Options research, backtesting, and paper-trading systems for equities and derivatives.",
  },
  {
    icon: "code",
    title: "Software Engineering",
    body: "Full-stack tools and automation — from data pipelines to job-scanning agents.",
  },
  {
    icon: "camera",
    title: "Photography",
    body: "Shooting for the love of light and composition. See the gallery for a few favorites.",
  },
];

// Tools I reach for — edit freely.
const stack = [
  "Python", "TypeScript", "JavaScript", "Node.js",
  "Pandas", "NumPy", "Alpaca API", "Git", "Astro",
];
---

<BaseLayout title="About" bodyClass="page-about">
  <section class="hero reveal">
    <div class="hero-main">
      <p class="eyebrow">Hi, I'm</p>
      <h1 class="name">{SITE.name}</h1>
      <p class="tagline muted">
        a <span id="typewriter" data-roles={JSON.stringify(roles)}>{roles[0]}</span
        ><span class="caret" aria-hidden="true"></span>
      </p>
      <p class="intro">
        <!-- Edit this to your own words. -->
        I build trading and research tools, write about what I learn, travel,
        and shoot photos on the side.
      </p>
      <ul class="social-row">
        {
          SOCIALS.map((s) => (
            <li>
              <a
                class="social-btn"
                href={s.url}
                target={s.url.startsWith("http") ? "_blank" : undefined}
                rel="noopener"
              >
                <Icon name={s.icon} size={18} />
                <span>{s.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="portrait-wrap">
      <div class="portrait">
        {
          portrait ? (
            <img src={portrait.src} alt={SITE.name} width="280" height="350" />
          ) : (
            <div class="portrait-placeholder">
              <Icon name="user" size={56} />
              <span>Your photo goes here</span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="focus">
    <h2 class="reveal">What I do</h2>
    <div class="focus-grid">
      {
        focus.map((f, i) => (
          <article class="focus-card reveal" style={`--reveal-delay:${i * 90}ms`}>
            <span class="focus-icon"><Icon name={f.icon} size={22} /></span>
            <h3>{f.title}</h3>
            <p class="muted">{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="stack-section reveal">
    <h2>Tools I reach for</h2>
    <ul class="pills">
      {stack.map((t) => <li class="pill">{t}</li>)}
    </ul>
  </section>
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ── Typewriter role cycler ──────────────────────────────────────
  const tw = document.getElementById("typewriter");
  if (tw) {
    let roles: string[] = [];
    try {
      roles = JSON.parse(tw.dataset.roles || "[]");
    } catch {}
    if (roles.length && !reduce) {
      let wi = 0,
        ci = 0,
        deleting = false;
      const tick = () => {
        const word = roles[wi];
        ci += deleting ? -1 : 1;
        tw.textContent = word.slice(0, ci);
        let delay = deleting ? 55 : 110;
        if (!deleting && ci === word.length) {
          deleting = true;
          delay = 1500;
        } else if (deleting && ci === 0) {
          deleting = false;
          wi = (wi + 1) % roles.length;
          delay = 350;
        }
        window.setTimeout(tick, delay);
      };
      window.setTimeout(tick, 1200);
    } else if (roles.length) {
      tw.textContent = roles.join(" · ");
    }
  }

  // ── 3D tilt on focus cards ──────────────────────────────────────
  if (!reduce) {
    document.querySelectorAll<HTMLElement>(".focus-card").forEach((card) => {
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transition = "transform 0.08s ease";
        card.style.transform = `perspective(800px) rotateX(${py * -6}deg) rotateY(${px * 9}deg) translateY(-4px)`;
      });
      card.addEventListener("pointerleave", () => {
        card.style.transition = "";
        card.style.transform = "";
      });
    });
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: 4.5rem;
    overflow: visible;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 0.3rem;
  }
  .name {
    font-size: clamp(2.2rem, 6vw, 3.1rem);
    margin: 0;
    background: linear-gradient(110deg, var(--fg) 15%, var(--accent) 50%, var(--fg) 85%);
    background-size: 220% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 7s linear infinite;
  }
  @keyframes shimmer {
    to {
      background-position: 220% center;
    }
  }
  .tagline {
    font-size: 1.15rem;
    margin: 0.4rem 0 1.1rem;
    min-height: 1.6em;
  }
  #typewriter {
    color: var(--fg);
    font-weight: 600;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .intro {
    font-size: 1.02rem;
    max-width: 34rem;
    margin: 0 0 1.5rem;
  }

  /* ── Portrait slot ────────────────────────────────────────────── */
  .portrait-wrap {
    flex-shrink: 0;
  }
  .portrait {
    position: relative;
    width: 15rem;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    animation: float 6.5s ease-in-out infinite;
  }
  .portrait img,
  .portrait-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .portrait-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
    padding: 1rem;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  /* ── Focus cards ──────────────────────────────────────────────── */
  .focus {
    margin-bottom: 3.5rem;
  }
  .focus h2,
  .stack-section h2 {
    margin-top: 0;
  }
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }
  .focus-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.4rem;
    transform-style: preserve-3d;
    transition: transform 0.18s ease, border-color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .focus-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    box-shadow: var(--shadow-hover);
  }
  .focus-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    color: var(--accent);
    background: var(--accent-soft);
    margin-bottom: 0.85rem;
    transition: transform 0.18s ease;
  }
  .focus-card:hover .focus-icon {
    transform: scale(1.08) rotate(-4deg);
  }
  .focus-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.12rem;
  }
  .focus-card p {
    margin: 0;
    font-size: 0.92rem;
  }

  /* ── Tech stack pills ─────────────────────────────────────────── */
  .pills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .pill {
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    cursor: default;
    transition: transform 0.15s ease, color 0.15s ease,
      border-color 0.15s ease, background 0.15s ease;
  }
  .pill:hover {
    transform: translateY(-2px);
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  /* ── Reduced motion ───────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .name,
    .portrait,
    .caret {
      animation: none !important;
    }
  }

  /* ── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait-wrap {
      order: -1;
    }
    .portrait {
      width: 11rem;
    }
  }
</style>
