---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import { collections, singles, type Photo } from "../data/photos";

// All images under src/photos are imported so Astro can optimize them and
// expose their real dimensions. Files are resolved by `src` at build time.
const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;

const clampAr = (ar: number) => Math.max(0.5, Math.min(ar, 2.6));

// Shape each photo into a plain object the client lightbox can consume,
// generating an optimized thumbnail + full-size WebP for real photos.
async function toItem(p: Photo) {
  const mod = p.src ? files[`../photos/${p.src}`] : undefined;
  const base = {
    title: p.title ?? "",
    caption: p.caption ?? "",
    alt: p.alt || p.title || "Photo",
  };
  if (!mod) {
    return { ...base, placeholder: true, ar: clampAr(p.ar ?? 1.5), thumb: "", full: "" };
  }
  const meta = mod.default;
  const thumb = await getImage({ src: meta, width: Math.min(900, meta.width), format: "webp" });
  // Full-size for the lightbox — never upscaled past the original.
  const full = await getImage({ src: meta, width: Math.min(2400, meta.width), format: "webp" });
  return {
    ...base,
    placeholder: false,
    ar: clampAr(meta.width / meta.height),
    thumb: thumb.src,
    full: full.src,
  };
}

// One labeled group per collection, then a group for the standalone photos.
const groups = [];
for (const c of collections) {
  groups.push({
    key: `col-${c.id}`,
    title: c.title,
    description: c.description ?? "",
    items: await Promise.all(c.photos.map(toItem)),
  });
}
if (singles.length) {
  groups.push({
    key: "singles",
    title: "Photos",
    description: "",
    items: await Promise.all(singles.map(toItem)),
  });
}
---

<BaseLayout title="Photography" description="Collections and single frames." wide>
  <header class="pg-head">
    <h1>Photography</h1>
    <p class="muted">
      Click any photo to view it full-screen — use the arrows or your ← / →
      keys to move through a set, Esc to close.
    </p>
  </header>

  {
    groups.map((g) => (
      <section class="group">
        <div class="group-label">
          <span class="g-title">{g.title}</span>
          {g.description && <span class="g-desc"> · {g.description}</span>}
        </div>
        <div class="pgrid">
          {g.items.map((item, i) => (
            <button
              class="cell"
              style={`--ar:${item.ar.toFixed(3)}`}
              data-ar={item.ar.toFixed(4)}
              data-group={g.key}
              data-index={i}
              aria-label={item.title || "Open photo"}
            >
              {item.placeholder ? (
                <span class="ph" />
              ) : (
                <img src={item.thumb} alt={item.alt} loading="lazy" />
              )}
              {item.title && <span class="cell-title">{item.title}</span>}
            </button>
          ))}
        </div>
      </section>
    ))
  }

  <!-- Lightbox overlay -->
  <div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="lb-btn lb-close" aria-label="Close">&times;</button>
    <button class="lb-btn lb-prev" aria-label="Previous photo">&#8249;</button>
    <button class="lb-btn lb-next" aria-label="Next photo">&#8250;</button>
    <figure class="lb-figure">
      <div class="lb-media"></div>
      <figcaption class="lb-cap">
        <h3 class="lb-title"></h3>
        <p class="lb-caption muted"></p>
        <span class="lb-counter muted small"></span>
      </figcaption>
    </figure>
  </div>

  <script is:inline set:html={`window.__GALLERY__ = ${JSON.stringify(groups)};`} />
</BaseLayout>

<script>
  interface Item {
    title: string;
    caption: string;
    alt: string;
    placeholder: boolean;
    thumb: string;
    full: string;
  }
  interface Group {
    key: string;
    title: string;
    items: Item[];
  }

  const groups: Group[] = (window as any).__GALLERY__ ?? [];
  const byKey = new Map(groups.map((g) => [g.key, g]));

  const lb = document.getElementById("lightbox")!;
  const media = lb.querySelector<HTMLElement>(".lb-media")!;
  const elTitle = lb.querySelector<HTMLElement>(".lb-title")!;
  const elCaption = lb.querySelector<HTMLElement>(".lb-caption")!;
  const elCounter = lb.querySelector<HTMLElement>(".lb-counter")!;
  const btnPrev = lb.querySelector<HTMLButtonElement>(".lb-prev")!;
  const btnNext = lb.querySelector<HTMLButtonElement>(".lb-next")!;
  const btnClose = lb.querySelector<HTMLButtonElement>(".lb-close")!;

  let current: Item[] = [];
  let index = 0;
  let lastFocus: HTMLElement | null = null;

  // Zoom / pan state (inline styles, because the lightbox <img> is created
  // in JS and Astro's scoped CSS would not apply to it).
  let scale = 1;
  let tx = 0;
  let ty = 0;
  let curImg: HTMLImageElement | null = null;
  const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(v, hi));

  function applyTransform() {
    if (!curImg) return;
    curImg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    curImg.style.cursor = scale > 1 ? "grab" : "zoom-in";
  }
  function resetZoom() {
    scale = 1;
    tx = 0;
    ty = 0;
  }

  function render() {
    const item = current[index];
    if (!item) return;
    media.innerHTML = "";
    resetZoom();
    curImg = null;
    if (item.placeholder) {
      const ph = document.createElement("div");
      ph.className = "lb-placeholder";
      ph.style.cssText =
        "width:min(70vw,640px);aspect-ratio:3/2;display:flex;align-items:center;justify-content:center;border-radius:6px;color:rgba(255,255,255,.75);background:linear-gradient(135deg,#3a3a44,#55556a);";
      ph.textContent = item.title || "Photo";
      media.appendChild(ph);
    } else {
      const img = document.createElement("img");
      img.src = item.full;
      img.alt = item.alt;
      img.draggable = false;
      img.style.cssText =
        "display:block;max-width:94vw;max-height:84vh;width:auto;height:auto;border-radius:6px;box-shadow:0 20px 60px rgba(0,0,0,.5);transform-origin:center center;transition:transform .08s ease-out;user-select:none;-webkit-user-drag:none;touch-action:none;";
      media.appendChild(img);
      curImg = img;
      applyTransform();
    }
    elTitle.textContent = item.title;
    elTitle.style.display = item.title ? "" : "none";
    elCaption.textContent = item.caption;
    elCaption.style.display = item.caption ? "" : "none";
    const multi = current.length > 1;
    elCounter.textContent = multi ? `${index + 1} / ${current.length}` : "";
    btnPrev.style.display = multi ? "" : "none";
    btnNext.style.display = multi ? "" : "none";
  }

  function open(groupKey: string, startIndex: number) {
    const group = byKey.get(groupKey);
    if (!group) return;
    current = group.items;
    index = Math.max(0, Math.min(startIndex, current.length - 1));
    lastFocus = document.activeElement as HTMLElement;
    lb.hidden = false;
    document.body.style.overflow = "hidden";
    render();
    btnClose.focus();
  }

  function close() {
    lb.hidden = true;
    document.body.style.overflow = "";
    media.innerHTML = "";
    lastFocus?.focus();
  }

  const next = () => {
    index = (index + 1) % current.length;
    render();
  };
  const prev = () => {
    index = (index - 1 + current.length) % current.length;
    render();
  };

  document.querySelectorAll<HTMLButtonElement>("[data-group]").forEach((el) => {
    el.addEventListener("click", () => {
      open(el.dataset.group!, Number(el.dataset.index || 0));
    });
  });

  btnNext.addEventListener("click", next);
  btnPrev.addEventListener("click", prev);
  btnClose.addEventListener("click", close);
  lb.addEventListener("click", (e) => {
    if (e.target === lb || e.target === lb.querySelector(".lb-figure")) close();
  });
  document.addEventListener("keydown", (e) => {
    if (lb.hidden) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowRight" && current.length > 1) next();
    else if (e.key === "ArrowLeft" && current.length > 1) prev();
  });

  // ── Zoom (scroll) & pan (drag) ──────────────────────────────────
  function zoomAt(clientX: number, clientY: number, factor: number) {
    if (!curImg) return;
    const newScale = clamp(scale * factor, 1, 6);
    if (newScale === scale) return;
    const rect = curImg.getBoundingClientRect();
    // Center of the untransformed image (scaling is about center, so the
    // transformed rect's center is the static center plus the translation).
    const c0x = rect.left + rect.width / 2 - tx;
    const c0y = rect.top + rect.height / 2 - ty;
    const vx = clientX - c0x;
    const vy = clientY - c0y;
    const ratio = newScale / scale;
    tx = vx - (vx - tx) * ratio;
    ty = vy - (vy - ty) * ratio;
    scale = newScale;
    if (scale <= 1.001) resetZoom();
    applyTransform();
  }

  lb.addEventListener(
    "wheel",
    (e) => {
      if (lb.hidden || !curImg) return;
      e.preventDefault();
      zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.15 : 1 / 1.15);
    },
    { passive: false }
  );

  let dragging = false;
  let sx = 0, sy = 0, stx = 0, sty = 0;
  media.addEventListener("pointerdown", (e) => {
    if (!curImg || scale <= 1) return;
    dragging = true;
    sx = e.clientX;
    sy = e.clientY;
    stx = tx;
    sty = ty;
    curImg.style.transition = "none";
    curImg.style.cursor = "grabbing";
    media.setPointerCapture?.(e.pointerId);
  });
  media.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    tx = stx + (e.clientX - sx);
    ty = sty + (e.clientY - sy);
    applyTransform();
  });
  const endDrag = () => {
    if (!dragging) return;
    dragging = false;
    if (curImg) curImg.style.transition = "transform .08s ease-out";
    applyTransform();
  };
  media.addEventListener("pointerup", endDrag);
  media.addEventListener("pointercancel", endDrag);
  media.addEventListener("dblclick", (e) => {
    if (!curImg) return;
    if (scale > 1) resetZoom();
    else {
      zoomAt(e.clientX, e.clientY, 2.4);
      return;
    }
    applyTransform();
  });

  // ── Justified layout (Google-Photos style, no cropping) ─────────
  // Each row's height is computed so photos fill the full width at their
  // true aspect ratios — portraits stay narrow, never stretched/cropped.
  function layoutGrids() {
    document.querySelectorAll<HTMLElement>(".pgrid").forEach((grid) => {
      const style = getComputedStyle(grid);
      const gap = parseFloat(style.gap) || 4;
      const targetH = parseFloat(style.getPropertyValue("--row-h")) || 320;
      const W = grid.clientWidth;
      if (!W) return;
      const cells = Array.from(grid.children) as HTMLElement[];
      let row: HTMLElement[] = [];
      let sumAr = 0;
      const flush = (isLast: boolean) => {
        if (!row.length) return;
        const gaps = gap * (row.length - 1);
        let h = (W - gaps) / sumAr;
        if (isLast && h > targetH) h = targetH; // don't blow up a sparse last row
        for (const c of row) {
          const ar = parseFloat(c.dataset.ar || "1.5") || 1.5;
          c.style.flex = "0 0 auto";
          c.style.width = Math.floor(ar * h) + "px";
          c.style.height = Math.round(h) + "px";
        }
        row = [];
        sumAr = 0;
      };
      for (const c of cells) {
        const ar = parseFloat(c.dataset.ar || "1.5") || 1.5;
        row.push(c);
        sumAr += ar;
        if (sumAr * targetH + gap * (row.length - 1) >= W) flush(false);
      }
      flush(true);
    });
  }

  layoutGrids();
  window.addEventListener("load", layoutGrids); // re-run once fonts settle
  let resizeTimer: number;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(layoutGrids, 120);
  });
</script>

<style>
  /* Header keeps a little breathing room; grids go fully edge-to-edge. */
  .pg-head {
    padding: 0 clamp(0.75rem, 3vw, 1.5rem);
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }
  .pg-head h1 {
    margin-bottom: 0.35rem;
  }

  .group {
    margin-top: 1.75rem;
  }
  .group-label {
    padding: 0 clamp(0.75rem, 3vw, 1.5rem);
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }
  .g-title {
    font-weight: 650;
    color: var(--fg);
  }
  .g-desc {
    color: var(--muted);
  }

  /* ── Justified, full-bleed, borderless grid (Google-Photos style) ─ */
  .pgrid {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    --row-h: 360px;
  }
  @media (max-width: 1100px) {
    .pgrid {
      --row-h: 300px;
    }
  }
  @media (max-width: 760px) {
    .pgrid {
      --row-h: 240px;
      gap: 3px;
    }
  }
  @media (max-width: 480px) {
    .pgrid {
      --row-h: 200px;
    }
  }
  .cell {
    position: relative;
    height: var(--row-h);
    /* grow / shrink / basis all scale with aspect ratio → rows fill width
       while photos keep their proportions. */
    flex: var(--ar) 1 calc(var(--ar) * var(--row-h));
    margin: 0;
    padding: 0;
    border: none;
    background: var(--surface-2);
    overflow: hidden;
    cursor: pointer;
  }
  .cell img,
  .cell .ph {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cell .ph {
    background: linear-gradient(
      135deg,
      var(--border),
      color-mix(in srgb, var(--border) 55%, var(--muted))
    );
  }
  .cell img {
    transition: transform 0.3s ease, filter 0.2s ease;
  }
  .cell:hover img {
    transform: scale(1.04);
  }
  .cell::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    transition: background 0.2s ease;
    pointer-events: none;
  }
  .cell:hover::after {
    background: rgba(0, 0, 0, 0.12);
  }
  .cell-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 1.6rem 0.6rem 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
    text-align: left;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .cell:hover .cell-title {
    opacity: 1;
  }

  /* ── Lightbox ─────────────────────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
    padding: 1.5rem;
    overflow: hidden;
    animation: lb-in 0.2s ease;
  }
  .lightbox[hidden] {
    display: none;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-figure {
    margin: 0;
    max-width: 94vw;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .lb-media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }
  /* Size against the viewport so the whole photo is shown at its true
     aspect ratio — portraits bound by height, landscapes by width. */
  .lb-media img {
    display: block;
    width: auto;
    height: auto;
    max-width: 94vw;
    max-height: 82vh;
    border-radius: 6px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .lb-placeholder {
    width: min(70vw, 640px);
    aspect-ratio: 3 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.75);
    background: linear-gradient(135deg, #3a3a44, #55556a);
  }
  .lb-cap {
    text-align: center;
    color: #fff;
    max-width: 40rem;
  }
  .lb-title {
    margin: 0;
    font-size: 1.15rem;
    color: #fff;
  }
  .lb-caption {
    margin: 0.25rem 0 0;
    color: rgba(255, 255, 255, 0.7) !important;
  }
  .lb-counter {
    display: inline-block;
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.55) !important;
  }
  .lb-btn {
    position: absolute;
    z-index: 2;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    cursor: pointer;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .lb-close {
    top: 1.1rem;
    right: 1.1rem;
    width: 2.6rem;
    height: 2.6rem;
    font-size: 1.6rem;
    line-height: 1;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    font-size: 2rem;
    line-height: 1;
  }
  .lb-prev:hover,
  .lb-next:hover {
    transform: translateY(-50%) scale(1.06);
  }
  .lb-prev {
    left: 1.1rem;
  }
  .lb-next {
    right: 1.1rem;
  }
  @media (max-width: 560px) {
    .lb-prev {
      left: 0.4rem;
    }
    .lb-next {
      right: 0.4rem;
    }
  }
</style>
