---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resume as r } from "../data/resume";
import { SITE, SOCIALS } from "../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sections = ["Education", "Experience", "Projects", "Skills"];
const social = (name: string) => SOCIALS.find((s) => s.name === name)!.url;
---

<BaseLayout
  title="Résumé"
  description="Education, research, engineering experience, and projects of Bingde (Charles) Jiang."
  wide
>
  <div class="resume-layout">
    <aside>
      <nav aria-label="Résumé sections">
        {sections.map((s) => <a href={`#${s.toLowerCase()}`}>{s}</a>)}
      </nav><button class="print-button" hidden
        >Print / save PDF <span aria-hidden="true">↗</span></button
      >
    </aside>
    <article>
      <header>
        <h1>{r.name}</h1><p class="summary">{r.summary}</p><div class="contact">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><a
            href={social("LinkedIn")}
            >LinkedIn <span aria-hidden="true">↗</span></a
          ><a href={social("GitHub")}
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </div>
      </header>
      <section id="education">
        <h2>Education</h2>{
          r.education.map((ed) => (
            <div class="entry">
              <div class="entry-top">
                <h3>{ed.school}</h3>
                <span>{ed.dates}</span>
              </div>
              <p>{ed.degree}</p>
              <p class="meta">
                {ed.location}
                {ed.gpa && ` · GPA ${ed.gpa}`}
              </p>
              <h4>{ed.courseworkLabel}</h4>
              <ul class="course-list">
                {ed.coursework.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </div>
          ))
        }<div class="entry">
          <h4>Programs & certificates</h4><ul class="inline-list">
            {r.programs.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </section>
      <section id="experience">
        <h2>Experience</h2><div class="timeline">
          {
            r.experience.map((e) => (
              <div class="entry">
                <p class="dates">
                  {e.dates} · {e.location}
                </p>
                <h3>{e.organization}</h3>
                <p class="role">{e.role}</p>
                {e.bullets.length > 0 && (
                  <ul>
                    {e.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
                <p class="meta">{e.tags.join(" / ")}</p>
              </div>
            ))
          }
        </div>
      </section>
      <section id="projects">
        <h2>Projects</h2>{
          r.projects.map((p) => (
            <div class="entry">
              <p class="dates">{p.dates}</p>
              <h3>{p.name}</h3>
              <p class="meta">{p.tools}</p>
              <ul>
                {p.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              {p.links.length > 0 && (
                <div class="project-links">
                  {p.links.map((l) => (
                    <a class="text-link" href={`${base}${l.href}`}>
                      {l.label} <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </section>

      <section id="skills">
        <h2>Skills</h2><dl class="skills">
          {
            r.skills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd>{s.items.join(" · ")}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <p class="updated">Last updated {r.updated}.</p>
    </article>
  </div>
</BaseLayout>
<script>
  const button = document.querySelector<HTMLButtonElement>(".print-button");
  if (button) {
    button.hidden = false;
    button.addEventListener("click", () => window.print());
  }
</script>
<style>
  .resume-layout {
    display: grid;
    grid-template-columns: 12rem minmax(0, 48rem);
    gap: 4rem;
    max-width: 74rem;
    padding: 0 var(--gutter);
    margin: auto;
    align-items: start;
  }
  aside {
    position: sticky;
    top: 3rem;
  }
  aside nav {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin: 0.5rem 0 1.5rem;
  }
  aside a {
    color: var(--muted);
    transition: color 0.15s;
  }
  aside a:hover {
    color: var(--accent);
  }
  .print-button {
    background: none;
    border: 1px solid var(--border-control);
    padding: 0.75rem;
    font: inherit;
    font-size: var(--fs-label);
    color: var(--fg);
    cursor: pointer;
  }
  h1 {
    margin: 0 0 1.25rem;
  }
  .summary {
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--muted);
  }
  .contact,
  .project-links {
    display: flex;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
  }
  header {
    padding-bottom: 2rem;
  }
  section {
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    scroll-margin-top: 2rem;
  }
  h2 {
    margin: 0 0 2rem;
  }
  h3 {
    margin: 0.4rem 0;
  }
  h4 {
    font-size: var(--fs-label);
    font-weight: 600;
    margin-top: 1.5rem;
  }
  .entry {
    margin-bottom: 2.3rem;
  }
  .entry h4 {
    margin-bottom: 0;
  }
  .entry:last-child {
    margin-bottom: 0;
  }
  .entry-top {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .dates,
  .meta,
  .entry-top span,
  .updated {
    font-size: var(--fs-label);
    color: var(--muted);
    line-height: 1.6;
  }
  .role {
    margin: 0.25rem 0 1rem;
  }
  .entry p {
    line-height: 1.65;
  }
  .entry ul {
    padding-left: 1.2rem;
  }
  .entry li {
    line-height: 1.65;
    margin: 0.6rem 0;
    max-width: 68ch;
  }
  .timeline {
    border-left: 1px solid var(--border);
    padding-left: 1.6rem;
  }
  .timeline .entry {
    position: relative;
  }
  .timeline .entry:before {
    content: "";
    position: absolute;
    left: -1.85rem;
    top: 0.4rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .inline-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .skills div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  dt {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  dd {
    margin: 0;
    line-height: 1.65;
  }
  .course-list {
    padding-left: 1.2rem;
    margin: 0.5rem 0 0;
  }
  .entry .course-list li {
    line-height: 1.6;
    margin: 0.2rem 0;
  }
  .updated {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  @media (max-width: 1000px) {
    .resume-layout {
      display: block;
      max-width: 52rem;
    }
    aside {
      position: static;
      margin-bottom: 2rem;
    }
    aside nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    aside {
      display: none !important;
    }
    :global(main) {
      padding: 0 !important;
    }
    :global(body) {
      background: white !important;
      color: black !important;
    }
    .resume-layout {
      display: block;
      max-width: none;
      padding: 0;
    }
    h1 {
      font-size: 24pt;
    }
    h2 {
      font-size: 16pt;
    }
    section {
      padding: 12pt 0;
    }
    .entry {
      break-inside: avoid;
    }
    p,
    li,
    dd {
      font-size: 10pt !important;
    }
    a {
      color: black;
    }
    .contact {
      font-size: 10pt;
    }
    .updated {
      font-size: 8pt;
    }
    header {
      padding-bottom: 12pt;
    }
  }
</style>
