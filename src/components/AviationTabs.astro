---
// Logbook / Heathrow record switch, styled as airport direction signs
// (see src/styles/airside.css).
const { current } = Astro.props as { current: "logbook" | "record" };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const tabs = [
  { id: "logbook", label: "Logbook", href: `${base}/photography/aviation` },
  { id: "record", label: "Heathrow record", href: `${base}/photography/aviation/record` },
];
---

<nav class="as-signs" aria-label="Aviation sections">
  {
    tabs.map((t) => (
      <a href={t.href} aria-current={t.id === current ? "page" : undefined}>
        {t.label}
      </a>
    ))
  }
</nav>
