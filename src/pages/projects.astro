---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectDiagram from "../components/ProjectDiagram.astro";
import { projects } from "../data/projects";
import { walkthroughs } from "../data/walkthroughs";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const names: Record<string, string> = {
  "project-emberforge": "Emberforge",
  "project-geld": "Geld",
  "market-volatility-forecasting": "Forecasting volatility",
  "Project-Olsen": "Olsen",
  QJS: "QJS",
};
const kinds: Record<string, string> = {
  "project-emberforge": "funnel",
  "project-geld": "equity",
  "market-volatility-forecasting": "predactual",
  "Project-Olsen": "options",
  QJS: "scanlist",
};
---

<BaseLayout
  title="Work"
  description="Research tools, trading systems, and useful automation."
  wide
>
  <div class="page-shell">
    <header class="work-heading">
      <p class="eyebrow">Selected work / 01—05</p><h1>Projects</h1><p
        class="lede"
      >
        Research tools, trading systems, and useful automation.
      </p>
    </header>
    <div class="work-layout">
      <aside>
        <p class="eyebrow">Project index</p><nav aria-label="Project index">
          {
            projects.map((p, i) => (
              <a href={`#${p.name}`}>
                <span>{String(i + 1).padStart(2, "0")}</span>
                {names[p.name] || p.name}
              </a>
            ))
          }
        </nav>
      </aside>
      <div>
        {
          projects.map((p, i) => (
            <article id={p.name} class="project">
              <>
                <div class="project-meta eyebrow">
                  <>
                    <span>
                      {String(i + 1).padStart(2, "0")} / {p.language}
                    </span>
                    <span>
                      {p.visibility === "private"
                        ? "Private research"
                        : "Open source"}
                    </span>
                  </>
                </div>
                <h2>{names[p.name] || p.name}</h2>
                <p class="description">{p.description}</p>
                <div class="diagram-wrap">
                  {p.name === "market-volatility-forecasting" ? (
                    <>
                      <img
                        class="result-chart"
                        src={`${base}/projects/volatility-prediction.png`}
                        alt="Ensemble predicted variance plotted against realized variance"
                        loading="lazy"
                      />
                      <p class="eyebrow">Actual output from the project</p>
                    </>
                  ) : (
                    <>
                      <ProjectDiagram kind={kinds[p.name] || "funnel"} />
                      <p class="eyebrow">
                        Concept illustration · not measured results
                      </p>
                    </>
                  )}
                </div>
                <div class="project-bottom">
                  {walkthroughs.find((w) => w.project === p.name) && (
                    <a
                      class="text-link"
                      href={`${base}/projects/${walkthroughs.find((w) => w.project === p.name)!.slug}`}
                    >
                      Read walkthrough →
                    </a>
                  )}
                  <p class="topics">{p.topics?.join(" / ")}</p>
                  {p.visibility === "public" && p.repo ? (
                    <a
                      class="text-link"
                      href={p.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Explore the code ↗
                    </a>
                  ) : (
                    <span class="private-note">Private repository</span>
                  )}
                  {p.demo && (
                    <a class="text-link" href={p.demo}>
                      View project ↗
                    </a>
                  )}
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .work-heading {
    padding: 1rem 0 5rem;
  }
  .work-heading h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 2rem 0;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--muted);
  }
  .work-layout {
    display: grid;
    grid-template-columns: 1fr 2.4fr;
    gap: 5rem;
  }
  .work-layout aside {
    position: sticky;
    top: 3rem;
    align-self: start;
  }
  aside nav {
    display: flex;
    flex-direction: column;
  }
  aside a {
    display: flex;
    gap: 1.2rem;
    padding: 0.7rem 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  aside a span {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.8rem;
  }
  .project {
    border-top: 1px solid var(--border);
    padding: 2rem 0 5rem;
    scroll-margin-top: 2rem;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .project h2 {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 400;
    margin: 1.6rem 0;
    overflow-wrap: anywhere;
  }
  .description {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 44rem;
  }
  .diagram-wrap {
    background: var(--surface-2);
    padding: 3rem 2rem 1rem;
    margin: 2.5rem 0;
  }
  .diagram-wrap :global(.diagram) {
    max-width: 460px;
    margin: auto;
  }
  .result-chart {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    margin: auto;
  }
  .diagram-wrap > p {
    font-size: 0.75rem;
    text-align: center;
    margin-top: 1.5rem;
  }
  .project-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .topics {
    font: 0.8125rem/1.8 var(--font-mono);
    max-width: 25rem;
    color: var(--muted);
    margin: 0;
  }
  .private-note {
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .work-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .work-layout aside {
      position: static;
    }
    .work-heading {
      padding-bottom: 2rem;
    }
    aside nav {
      flex-direction: row;
      gap: 0.3rem 1.2rem;
      flex-wrap: wrap;
    }
    .diagram-wrap {
      padding: 2rem 1rem 1rem;
    }
    .project {
      padding-bottom: 3rem;
    }
  }
</style>
