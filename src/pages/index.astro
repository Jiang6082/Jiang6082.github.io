---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import { SITE } from "../config";
import { projects } from "../data/projects";
import portrait from "../photos/IMG_0339.jpg";
import coast from "../photos/IMG_0047.jpg";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const responsive = (src: ImageMetadata, max: number, sizes: string) => {
  const width = Math.min(max, src.width);
  return getImage({
    src,
    width,
    widths: [480, 720, 960, 1200, max].filter((w) => w <= width),
    sizes,
    format: "webp",
  });
};
const portraitImage = await responsive(
  portrait,
  1400,
  "(max-width: 760px) calc(100vw - 2.5rem), 46vw",
);
const coastImage = await responsive(
  coast,
  1400,
  "(max-width: 760px) calc(100vw - 2.5rem), 55vw",
);
const work = projects.filter((p) => p.featured && p.slug);
---

<BaseLayout
  description="Charles Jiang — University of Chicago mathematics and computer science student. Research, software, and photography."
  wide
>
  <div class="page-shell">
    <section class="home-opening" aria-labelledby="home-heading">
      <div class="hero-copy">
        <p class="eyebrow">Mathematics & computer science / UChicago</p><h1
          id="home-heading"
        >
          Charles Jiang
        </h1><p>I build things and I like to take photos.</p><div
          class="hero-links"
        >
          <a class="text-link" href="#selected-work"
            >Explore the projects <span aria-hidden="true">↓</span></a
          ><a class="text-link" href={`${base}/resume`}
            >Experience & résumé <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <a
        class="hero-photo"
        href={`${base}/photography`}
        aria-label="Open photography"
        ><img
          src={portraitImage.src}
          srcset={portraitImage.srcSet.attribute}
          sizes={portraitImage.attributes.sizes}
          width={portraitImage.attributes.width}
          height={portraitImage.attributes.height}
          alt="Charles photographing his reflection among hanging orchids"
          fetchpriority="high"
        /><span>Photography <span aria-hidden="true">↗</span></span></a
      >
    </section>
    <section class="home-work" id="selected-work">
      <div class="section-heading">
        <h2>Projects</h2><a class="text-link" href={`${base}/projects`}
          >All projects <span aria-hidden="true">↗</span></a
        >
      </div>{
        work.map((p, i) => (
          <a class="work-row" href={`${base}/projects/${p.slug}`}>
            <span class="work-number">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
            </div>
            <span class="work-kind">{p.kind}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </section>
    <section class="background">
      <h2>Experience</h2><div>
        <p>
          I have a pretty diverse background, from any perspective you can
          imagine.
        </p><a class="text-link" href={`${base}/resume`}
          >Check out my background <span aria-hidden="true">→</span></a
        >
      </div>
    </section>
    <section class="photo-invitation">
      <a href={`${base}/photography`}
        ><img
          src={coastImage.src}
          srcset={coastImage.srcSet.attribute}
          sizes={coastImage.attributes.sizes}
          width={coastImage.attributes.width}
          height={coastImage.attributes.height}
          alt="A beach curving alongside a coastal road under a blue sky"
          loading="lazy"
          decoding="async"
        /></a
      ><div>
        <h2>Photography</h2><p>
          Trains, planes, coastlines, gardens, and streets.
        </p><a class="text-link" href={`${base}/photography`}
          >Browse the filmstrip <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    <section class="closing">
      <h2>Get in touch</h2><a class="text-link" href={`mailto:${SITE.email}`}
        >{SITE.email} <span aria-hidden="true">↗</span></a
      >
    </section>
  </div>
</BaseLayout>
<style>
  .home-opening {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding: 0 0 5rem;
    min-height: 65vh;
  }
  .hero-copy h1 {
    font-size: clamp(2.8rem, 5.6vw, 5.2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.03;
    margin: 1.6rem 0;
  }
  .hero-copy > p:not(.eyebrow) {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--muted);
    max-width: 34rem;
  }
  .eyebrow {
    font-size: 0.75rem;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
    font-size: 0.9rem;
  }
  .hero-photo {
    display: block;
    position: relative;
  }
  .hero-photo img {
    display: block;
    width: 100%;
    height: clamp(360px, 44vw, 620px);
    object-fit: cover;
    object-position: center;
  }
  .hero-photo > span {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    font-size: 0.75rem;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .section-heading h2,
  .background h2,
  .photo-invitation h2,
  .closing h2 {
    font-size: 1.7rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .home-work {
    padding: 2rem 0 4rem;
    scroll-margin-top: 2rem;
  }
  .work-row {
    display: grid;
    grid-template-columns: 2rem 1fr 10rem 1rem;
    gap: 1.5rem;
    align-items: center;
    padding: 1.7rem 0;
    border-top: 1px solid var(--border);
    color: var(--fg);
  }
  .work-row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .work-row h3 {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0;
  }
  .work-row p {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.4rem 0 0;
  }
  .work-number {
    font: 0.75rem var(--font-mono);
    color: var(--accent);
  }
  .work-kind {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .work-row:hover h3 {
    color: var(--accent);
  }
  .background {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    padding: 2rem 0 5rem;
  }
  .background p {
    font-size: 1.1rem;
    line-height: 1.9;
    max-width: 45rem;
  }
  .photo-invitation {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 2rem 0 5rem;
  }
  .photo-invitation img {
    width: 100%;
    height: auto;
    display: block;
  }
  .photo-invitation p {
    color: var(--muted);
  }
  .closing {
    border-top: 1px solid var(--border);
    padding: 3rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .closing h2 {
    margin: 0;
  }
  @media (max-width: 760px) {
    .home-opening {
      grid-template-columns: 1fr;
      gap: 2rem;
      min-height: 0;
      padding-bottom: 2rem;
    }
    .hero-photo img {
      height: 440px;
      max-height: 65vh;
    }
    .hero-copy h1 {
      font-size: clamp(2.8rem, 10vw, 4.5rem);
    }
    .work-row {
      grid-template-columns: 1.5rem 1fr 1rem;
      gap: 1rem;
    }
    .work-kind {
      display: none;
    }
    .background {
      grid-template-columns: 1fr;
      gap: 0;
      padding-bottom: 2rem;
    }
    .photo-invitation {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-bottom: 3rem;
    }
  }
</style>
