---
import { SITE, ANALYTICS } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Render content edge-to-edge (no centered container). */
  wide?: boolean;
  /** Extra class on <body> (e.g. "page-about" for the green background). */
  bodyClass?: string;
}

const { title, description, wide, bodyClass } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const desc = description ?? SITE.tagline;
---

<!doctype html>
<html lang="en" class="no-js" data-theme="light">
  <head>
    <script is:inline>
      // Mark JS available (so reveal content is safely hidden only with JS).
      (function () {
        document.documentElement.classList.remove("no-js");
        document.documentElement.classList.add("js");
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
      type="image/svg+xml"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    {
      ANALYTICS.goatCounter && (
        <script
          is:inline
          data-goatcounter={`https://${ANALYTICS.goatCounter}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body class={bodyClass} id="top"
    ><a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      {
        wide ? (
          <slot />
        ) : (
          <div class="container">
            <slot />
          </div>
        )
      }
    </main>
    <Footer />
    <script>
      // Reveal-on-scroll for any element with class "reveal".
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
