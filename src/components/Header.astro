---
import { SITE } from "../config";
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;
// Join base + path without producing double slashes.
const link = (p: string) => (base.replace(/\/$/, "") + p) || "/";

const nav = [
  { label: "About", href: link("/") },
  { label: "Projects", href: link("/projects") },
  { label: "Blog", href: link("/blog") },
  { label: "Photography", href: link("/photography") },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  const h = href.replace(/\/$/, "") || "/";
  if (h === (base.replace(/\/$/, "") || "/")) return current === h;
  return current === h || current.startsWith(h + "/");
};
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={link("/")}>{SITE.name}</a>
    <div class="right">
      <nav>
        {
          nav.map((item) => (
            <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
              {item.label}
            </a>
          ))
        }
      </nav>
      {/* Light/dark toggle temporarily disabled (site is dark-only for now).
          To re-enable: restore the theme button + <script> from git history
          and the saved-theme read in BaseLayout.astro. */}
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    z-index: 10;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
    max-width: var(--max-width-wide);
  }
  .brand {
    font-weight: 700;
    color: var(--fg);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .brand:hover {
    text-decoration: none;
    color: var(--accent);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  nav {
    display: flex;
    gap: 1.1rem;
  }
  nav a {
    color: var(--muted);
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  nav a.active {
    color: var(--fg);
    font-weight: 600;
  }
  @media (max-width: 560px) {
    .right {
      gap: 0.85rem;
    }
    nav {
      gap: 0.85rem;
    }
    nav a {
      font-size: 0.9rem;
    }
  }
</style>
