---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import PageHeader from "../components/PageHeader.astro";
import { projects } from "../data/projects";
import { walkthroughs } from "../data/research";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Projects"
  description="Research tools, trading systems, and full-stack software by Charles Jiang."
  wide
>
  <div class="page-shell">
    <PageHeader
      class="work-heading"
      title="Projects"
      lede="Research tools, trading systems, and full-stack software."
    />
    <div class="work-layout">
      <aside>
        <nav aria-label="Project index">
          {projects.map((p) => <a href={`#${p.id}`}>{p.title}</a>)}
        </nav>
      </aside>
      <div>
        {
          projects.map((p) => (
            <article id={p.id} class="project">
              <h2>{p.title}</h2>
              <p class="project-meta">
                {p.language} ·{" "}
                {p.visibility === "private" ? "Private research" : "Open source"}
              </p>
              <p class="description">{p.purpose}</p>
              <p class="result">{p.result}</p>
              <p class="result-context">{p.context}</p>
              <div class="project-actions">
                <details class="project-demo">
                  <summary>
                    {walkthroughs.find((w) => w.project === p.id)?.demo
                      ? "Try demo"
                      : "See results"}{" "}
                    <span aria-hidden="true">+</span>
                  </summary>
                  <ProjectVisual project={p.id} />
                </details>
                {p.slug && (
                  <a class="text-link" href={`${base}/projects/${p.slug}`}>
                    Read walkthrough <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
              <div class="project-bottom">
                <p class="topics">{p.topics.join(" / ")}</p>
                {p.visibility === "public" && p.repo ? (
                  <a
                    class="text-link"
                    href={p.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Explore the code <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="private-note">Private repository</span>
                )}
                {p.demo && (
                  <a class="text-link" href={p.demo}>
                    View project <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  :global(.work-heading) {
    padding-bottom: 4rem;
  }
  .work-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 5rem;
  }
  .work-layout aside {
    position: sticky;
    top: 3rem;
    align-self: start;
  }
  aside nav {
    display: flex;
    flex-direction: column;
  }
  aside a {
    padding: 0.6rem 0;
    color: var(--muted);
    transition: color 0.15s;
  }
  aside a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .project {
    border-top: 1px solid var(--border);
    padding: 2rem 0 3rem;
    scroll-margin-top: 2rem;
  }
  .project h2 {
    margin: 0.5rem 0 0.4rem;
    overflow-wrap: anywhere;
  }
  .project-meta {
    font-size: var(--fs-label);
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .description {
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--muted);
    max-width: 40rem;
  }
  .result {
    font-size: var(--fs-lede);
    line-height: 1.5;
    margin: 1.5rem 0 0.3rem;
  }
  .result-context {
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 68ch;
  }
  .project-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 0 1.5rem;
  }
  .project-actions > a {
    grid-area: 1 / 1;
    justify-self: end;
    align-self: start;
    position: relative;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .project-demo {
    grid-area: 1 / 1;
    min-width: 0;
  }
  .project-demo summary {
    width: max-content;
    cursor: pointer;
    list-style: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
  }
  .project-demo summary::-webkit-details-marker {
    display: none;
  }
  .project-demo[open] summary span {
    transform: rotate(45deg);
  }
  .project-demo :global(.project-visual) {
    min-width: 0;
  }
  .project-bottom {
    margin-top: 1.5rem;
  }
  .project-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .topics {
    font: var(--fs-micro) / 1.8 var(--font-mono);
    max-width: 25rem;
    color: var(--muted);
    margin: 0;
  }
  .private-note {
    font-size: var(--fs-label);
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .work-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .work-layout aside {
      position: static;
    }
    :global(.work-heading) {
      padding-bottom: 2rem;
    }
    aside nav {
      flex-direction: row;
      gap: 0.3rem 1.2rem;
      flex-wrap: wrap;
    }
    .project {
      padding-bottom: 3rem;
    }
  }
</style>
