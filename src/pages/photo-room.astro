---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import { collections, singles } from "../data/photos";
import "../styles/labs.css";
const files = import.meta.glob("../photos/**/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;
const photos = [...collections.flatMap((c) => c.photos), ...singles].filter(
  (p) => p.src && files[`../photos/${p.src}`],
);
const items = await Promise.all(
  photos.map(async (p, i) => {
    const meta = files[`../photos/${p.src}`].default;
    const small = await getImage({
      src: meta,
      width: Math.min(360, meta.width),
      format: "webp",
    });
    const texture = await getImage({
      src: meta,
      width: Math.min(1400, meta.width),
      format: "webp",
    });
    const full = await getImage({
      src: meta,
      width: Math.min(2400, meta.width),
      format: "webp",
    });
    return {
      thumb: small.src,
      texture: texture.src,
      full: full.src,
      aspect: meta.width / meta.height,
      alt: p.alt || `Photograph ${i + 1} by Charles Jiang`,
    };
  }),
);
---

<BaseLayout
  title="Photo room"
  description="An optional 3D room for Charles Jiang’s photographs."
  wide
>
  <div class="lab-shell" id="photo-room">
    <header class="lab-header">
      <a class="text-link" href="/photography">← Back to the filmstrip</a><p
        class="eyebrow"
      >
        Photography / a room to explore
      </p><h1>The photo room.</h1><p>
        Trains, planes, coastlines, gardens, and streets.
      </p>
    </header>
    {
      items.length > 0 ? (
        <>
          <div class="lab-stage" id="room-stage">
            <>
              <div class="room-preview">
                <img
                  src={items[0].texture}
                  alt={items[0].alt}
                  width="900"
                  height={Math.round(900 / items[0].aspect)}
                />
              </div>
              <button class="lab-start" id="start-room" hidden>
                Enter the photo room ↗
              </button>
            </>
          </div>
          <p class="lab-status" id="room-status" role="status">
            A quiet gallery of {items.length} photographs. Enter to explore, or
            open any photograph below.
          </p>
          <div class="lab-controls" data-room-live hidden>
            <>
              <button id="room-prev">← Previous</button>
              <span id="room-count">1 / {items.length}</span>
              <button id="room-next">Next →</button>
              <button id="room-close" aria-pressed="false">
                Step closer
              </button>
              <button id="room-reset">Reset view</button>
              <button id="room-open">Open photograph ↗</button>
            </>
          </div>
          <p class="lab-hint">
            In the room: drag to look around · use Previous / Next or the arrow
            keys to move between frames.
          </p>
          <div class="room-thumbs" aria-label="Choose a photograph">
            {items.map((p, i) => (
              <a
                href={p.full}
                data-frame={i}
                aria-label={`Open photograph ${i + 1}`}
              >
                <img
                  src={p.thumb}
                  alt={p.alt}
                  width="160"
                  height={Math.round(160 / p.aspect)}
                  loading="lazy"
                />
              </a>
            ))}
          </div>
          <dialog id="room-dialog" aria-label="Photograph viewer">
            <>
              <button id="room-dismiss" autofocus>
                Close ×
              </button>
              <img id="room-full" alt="" />
            </>
          </dialog>
          <script
            type="application/json"
            id="room-data"
            set:html={JSON.stringify(items).replace(/</g, "\\u003c")}
          />
        </>
      ) : (
        <p>
          No photographs yet. <a href="/photography">Return to photography.</a>
        </p>
      )
    }
  </div>
</BaseLayout>
<script>
  const start = document.querySelector<HTMLButtonElement>("#start-room");
  const status = document.querySelector<HTMLElement>("#room-status");
  if (start && status) {
    start.hidden = false;
    start.addEventListener("click", async () => {
      start.disabled = true;
      status.textContent = "Opening the photo room…";
      try {
        const { createPhotoRoom } = await import("../scripts/photo-room");
        createPhotoRoom(
          document.querySelector("#room-stage")!,
          JSON.parse(document.querySelector("#room-data")!.textContent!),
        );
        start.hidden = true;
        document
          .querySelectorAll<HTMLElement>("[data-room-live]")
          .forEach((e) => (e.hidden = false));
      } catch {
        start.disabled = false;
        status.textContent =
          "3D is unavailable in this browser. You can still open every photograph below.";
      }
    });
  }
</script>
<style>
  .room-preview {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1000px;
    background: linear-gradient(#e7e2d8 72%, #d6d0c3 72%);
  }
  .room-preview img {
    width: auto;
    height: auto;
    max-width: 65%;
    max-height: 62%;
    border: 12px solid #f9f7f1;
    outline: 3px solid #373a32;
    box-shadow: 15px 20px 35px #504b432e;
    transform: rotateY(-8deg);
  }
  .room-thumbs {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding: 1rem 3px 1.5rem;
    align-items: center;
  }
  .room-thumbs a {
    flex: none;
    padding: 0.35rem;
    border: 1px solid transparent;
  }
  .room-thumbs a[aria-current="true"] {
    border-color: var(--accent);
  }
  .room-thumbs img {
    height: 80px;
    width: auto;
    display: block;
  }
  dialog {
    border: 0;
    padding: 3rem 1rem 1rem;
    background: var(--bg);
    max-width: 94vw;
    max-height: 94vh;
  }
  dialog::backdrop {
    background: #171a16e8;
  }
  dialog img {
    display: block;
    max-width: 88vw;
    max-height: 80vh;
    object-fit: contain;
  }
  dialog button {
    position: absolute;
    right: 0.5rem;
    top: 0.3rem;
  }
  #room-count {
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
</style>
