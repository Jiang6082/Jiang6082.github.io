---
import BaseLayout from "../layouts/BaseLayout.astro";
import { callValue } from "../lib/black-scholes.js";
import "../styles/labs.css";
const project = (s: number, t: number) => {
  const v = callValue(s, 100, t, 0.25, 0.04);
  return `${(90 + (s - 60) * 4.6 + t * 65).toFixed(2)},${(330 - t * 72 - v * 3).toFixed(2)}`;
};
const lines = Array.from({ length: 17 }, (_, i) =>
  Array.from({ length: 25 }, (_, j) => project(60 + i * 5, j / 12)).join(" "),
);
const cross = Array.from({ length: 13 }, (_, i) =>
  Array.from({ length: 41 }, (_, j) => project(60 + j * 2, i / 6)).join(" "),
);
---

<BaseLayout
  title="Options surface"
  description="An interactive 3D exploration of European call value, stock price, and time to expiry."
  wide
>
  <div class="lab-shell" id="options-lab">
    <header class="lab-header">
      <a class="text-link" href="/projects#Project-Olsen">← Back to projects</a
      ><p class="eyebrow">An options experiment / 3D</p><h1>
        Options in 3D.
      </h1><p>
        Rotate a call-value surface. Change volatility, then follow one point as
        its stock price and time to expiry change.
      </p>
    </header>
    <div class="lab-stage" id="surface-stage">
      <svg
        class="surface-preview"
        viewBox="0 0 650 410"
        width="100%"
        height="100%"
        role="img"
        aria-label="Illustrative call value surface: value rises with stock price and, under these assumptions, time to expiry."
      >
        <g fill="none" stroke="#b43d28" stroke-width=".8" opacity=".65"
          >{
            [...lines, ...cross].map((points) => <polyline points={points} />)
          }</g
        >
        <g fill="#55594f" font-size="12" font-family="Arial"
          ><text x="230" y="365">Stock price $60 → $140</text><text
            x="468"
            y="255"
            transform="rotate(-48 468 255)">Time 0 → 2 years</text
          ><text x="65" y="90">Call value ↑</text></g
        >
      </svg>
      <button class="lab-start" id="start-surface" hidden
        >Explore in 3D ↗</button
      >
    </div>
    <p class="lab-status" id="surface-status" role="status">
      Static view · strike $100, volatility 25%, rate 4%, no dividends.
    </p>
    <div class="lab-controls" data-live hidden>
      <button id="surface-reset">Reset view</button><button
        id="surface-left"
        aria-label="Rotate surface left">Rotate left</button
      ><button id="surface-right" aria-label="Rotate surface right"
        >Rotate right</button
      ><span class="lab-hint"
        >Drag to rotate · pinch or scroll over the surface to zoom.</span
      >
    </div>
    <div class="lab-sliders" id="surface-inputs" hidden>
      <label
        >Stock price <output id="spot-label">$100</output><input
          id="surface-spot"
          type="range"
          min="60"
          max="140"
          value="100"
          step="1"
        /></label
      >
      <label
        >Time to expiry <output id="time-label">1.00 years</output><input
          id="surface-time"
          type="range"
          min="0"
          max="2"
          value="1"
          step=".01"
        /></label
      >
      <label
        >Annual volatility <output id="vol-label">25%</output><input
          id="surface-vol"
          type="range"
          min="5"
          max="80"
          value="25"
          step="1"
        /></label
      >
    </div>
    <output class="lab-reading" id="surface-reading"
      >At $100 and one year: <strong
        >${callValue(100, 100, 1, 0.25, 0.04).toFixed(2)} per share</strong
      ></output
    >
    <div class="lab-notes">
      <p>
        Height and color show modeled call value in dollars per share, from
        slate at $0 toward rust at $80. The dark point follows your selected
        price and time. This is an illustrative model, not an Olsen strategy,
        backtest, or market quote.
      </p><p>
        The model uses a $100 strike, a fixed 4% annual interest rate, no
        dividends, and constant volatility. At expiry, value becomes max(stock
        price − strike, 0). Before expiry, it uses the <a
          href="https://www.mathworks.com/help/symbolic/the-black-scholes-formula-for-call-option-price.html"
          >Black–Scholes European call formula</a
        >.
      </p>
      <details>
        <summary>Read sample values without 3D</summary><table>
          <caption>Call value per share · 25% volatility, 4% rate</caption
          ><thead
            ><tr
              ><th>Stock price</th><th>At expiry</th><th>1 year</th><th
                >2 years</th
              ></tr
            ></thead
          ><tbody
            >{
              [60, 80, 100, 120, 140].map((s) => (
                <tr>
                  <th scope="row">${s}</th>
                  {[0, 1, 2].map((t) => (
                    <td>${callValue(s, 100, t, 0.25, 0.04).toFixed(2)}</td>
                  ))}
                </tr>
              ))
            }</tbody
          >
        </table>
      </details>
    </div>
  </div>
</BaseLayout>
<script>
  import { callValue } from "../lib/black-scholes.js";
  const start = document.querySelector<HTMLButtonElement>("#start-surface")!;
  const status = document.querySelector<HTMLElement>("#surface-status")!;
  let surface:
    | { update: (vol: number, spot: number, time: number) => void }
    | undefined;
  const inputs = ["spot", "time", "vol"].map(
    (id) => document.querySelector<HTMLInputElement>(`#surface-${id}`)!,
  );
  document.querySelector<HTMLElement>("#surface-inputs")!.hidden = false;
  const update = () => {
    const [s, t, v] = inputs.map((i) => Number(i.value));
    document.querySelector("#spot-label")!.textContent = `$${s}`;
    document.querySelector("#time-label")!.textContent =
      `${t.toFixed(2)} years`;
    document.querySelector("#vol-label")!.textContent = `${v}%`;
    document.querySelector("#surface-reading")!.textContent =
      `At $${s} and ${t.toFixed(2)} years: $${callValue(s, 100, t, v / 100, 0.04).toFixed(2)} per share`;
    surface?.update(v / 100, s, t);
    if (!surface)
      status.textContent =
        "Static preview stays at 25% volatility. The numeric reading follows your controls; activate 3D to update the surface.";
  };
  inputs.forEach((i) => i.addEventListener("input", update));
  start.hidden = false;
  start.addEventListener("click", async () => {
    start.disabled = true;
    status.textContent = "Loading the 3D surface…";
    try {
      const { createSurface } = await import("../scripts/options-surface");
      surface = createSurface(document.querySelector("#surface-stage")!);
      start.hidden = true;
      document
        .querySelectorAll<HTMLElement>("[data-live]")
        .forEach((el) => (el.hidden = false));
      status.textContent =
        "3D ready. Drag to rotate, or use the rotation buttons. No automatic motion.";
      update();
    } catch {
      start.disabled = false;
      status.textContent =
        "3D is unavailable in this browser. The static view, controls, and sample table still work.";
    }
  });
</script>
<style>
  .lab-sliders[hidden] {
    display: none;
  }
</style>
